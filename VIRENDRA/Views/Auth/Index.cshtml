    <script type="text/javascript">
        getLocation();

        $(".mpin").keyup(function () {
            var key = event.keyCode || event.charCode;
            if (this.value.length == this.maxLength && key != 8 && key != 46) {
                $(this).closest('.col-2').next().find('.mpin').focus();
            }
        });

        $(".mpin").keydown(function (event) {
            var key = event.keyCode || event.charCode;
            if (key == 8 || key == 46) {
                $(this).val('');
                $(this).closest('.col-2').prev().find('.mpin').focus();
            }
        });</script>



