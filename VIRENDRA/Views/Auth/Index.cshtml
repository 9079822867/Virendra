    <script>
        function show_alert(type, message) {
            let bgClass = 'bg-info';
            if (type === 'success') {
                bgClass = 'bg-success'
            } else if (type === 'danger') {
                bgClass = "bg-danger"
            } else if (type === 'warning') {
                bgClass = "bg-warning"
            } else if (type === 'error') {
                bgClass = "bg-danger"
            }
            $('#toast_bg_color').addClass(bgClass);
            $('#toast_message').text(message);
            var toastLiveExample2 = document.getElementById("borderedToast1");
            var toast = new bootstrap.Toast(toastLiveExample2);
            toast.show();
        }

        function loading() {
            if ($('.pace')) {
                $('.pace').addClass('pace-active').removeClass('pace-inactive');
                $('body').addClass('pace-running').removeClass('pace-done');
            }
        }

        function free() {
            if ($('.pace')) {
                $('.pace').addClass('pace-inactive').removeClass('pace-active');
                $('body').addClass('pace-done').removeClass('pace-running');
            }
        }</script><!-- password addon init -->

