@model VIRENDRA.Models.LoginModel

@{
    ViewBag.Title = "Sign in";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<aside class="auth-aside">
    <div class="auth-brand">
        <span class="app-brand-mark"><i class="bi bi-lightning-charge-fill"></i></span>
        EXPRESS
    </div>

    <div class="auth-pitch">
        <h1>Every recharge,<br><span>settled in seconds.</span></h1>
        <p>Prepaid, postpaid and DTH from one console, with automatic vendor routing and a ledger you can trust.</p>
        <div class="auth-points">
            <div class="auth-point"><i class="bi bi-diagram-3"></i>Smart vendor routing</div>
            <div class="auth-point"><i class="bi bi-journal-check"></i>Live wallet ledger</div>
            <div class="auth-point"><i class="bi bi-plug"></i>Reseller API</div>
            <div class="auth-point"><i class="bi bi-shield-lock"></i>KYC-verified users</div>
        </div>
    </div>

    <div class="auth-legal">&copy; @DateTime.Now.Year Express Recharge</div>
</aside>

<main class="auth-main">
    <div class="auth-card">
        <h2>Sign in</h2>
        <p class="lede">Use the username and password your admin gave you.</p>

        @if (ViewData.ModelState[""] != null && ViewData.ModelState[""].Errors.Count > 0)
        {
            <div class="auth-err">
                <i class="bi bi-exclamation-circle"></i>
                <div>@Html.ValidationMessage("")</div>
            </div>
        }

        @using (Html.BeginForm("Login", "Auth", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label class="form-label" for="Username">Username</label>
                @Html.TextBoxFor(m => m.Username, new { @class = "form-control", autocomplete = "username", autofocus = "autofocus", id = "Username" })
                @Html.ValidationMessageFor(m => m.Username)
            </div>

            <div class="mb-3">
                <div class="d-flex justify-content-between">
                    <label class="form-label" for="Password">Password</label>
                    <span class="form-text m-0">Forgot it? Ask your admin.</span>
                </div>
                <div class="input-group">
                    @Html.PasswordFor(m => m.Password, new { @class = "form-control", autocomplete = "current-password", id = "Password" })
                    <button type="button" class="btn btn-outline-secondary" id="togglePwd" aria-label="Show password"><i class="bi bi-eye"></i></button>
                </div>
                @Html.ValidationMessageFor(m => m.Password)
            </div>

            <div class="form-check mb-4">
                @Html.CheckBoxFor(m => m.RememberMe, new { @class = "form-check-input" })
                <label class="form-check-label small" for="RememberMe">Keep me signed in on this device</label>
            </div>

            <button type="submit" class="btn btn-dark w-100">Sign in <i class="bi bi-arrow-right ms-1"></i></button>
        }
    </div>
</main>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        document.getElementById('togglePwd').addEventListener('click', function () {
            var pwd = document.getElementById('Password');
            var show = pwd.type === 'password';
            pwd.type = show ? 'text' : 'password';
            this.querySelector('i').className = show ? 'bi bi-eye-slash' : 'bi bi-eye';
        });
    </script>
}
