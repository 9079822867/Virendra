@model VIRENDRA.Models.LoginModel

@{
    ViewBag.Title = "Login";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<!-- Left panel -->
<div class="auth-left">
    <div class="brand-icon">
        <i class="bi bi-lightning-charge-fill"></i>
    </div>
    <h1>Recharge Software</h1>
    <p>Your all-in-one platform for mobile recharge, DTH, bill payments and money transfer services.</p>

    <ul class="feature-list">
        <li><i class="bi bi-shield-check-fill"></i> Secure &amp; encrypted transactions</li>
        <li><i class="bi bi-lightning-fill"></i> Instant recharge &amp; payments</li>
        <li><i class="bi bi-graph-up-arrow"></i> Real-time reports &amp; analytics</li>
        <li><i class="bi bi-headset"></i> 24 / 7 dedicated support</li>
    </ul>
</div>

<!-- Right panel -->
<div class="auth-right">
    <div class="login-box">
        <p class="welcome">Welcome back</p>
        <p class="sub">Sign in to your account to continue</p>

        @if (ViewData.ModelState[""] != null)
        {
            <div class="alert-error">
                <i class="bi bi-exclamation-circle-fill"></i>
                @Html.ValidationMessage("")
            </div>
        }

        @using (Html.BeginForm("Login", "Auth", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            <!-- Username -->
            <div class="field-wrap">
                @Html.TextBoxFor(m => m.Username, new {
                    placeholder = " ",
                    autocomplete = "username",
                    id = "Username"
                })
                <label for="Username"><i class="bi bi-person" style="margin-right:5px"></i>Username</label>
                <i class="bi bi-person field-icon"></i>
                @Html.ValidationMessageFor(m => m.Username, "", new { @class = "validation-msg" })
            </div>

            <!-- Password -->
            <div class="field-wrap">
                @Html.PasswordFor(m => m.Password, new {
                    placeholder = " ",
                    autocomplete = "current-password",
                    id = "Password"
                })
                <label for="Password"><i class="bi bi-lock" style="margin-right:5px"></i>Password</label>
                <i class="bi bi-eye field-icon" id="togglePwd" title="Show / hide password"></i>
                @Html.ValidationMessageFor(m => m.Password, "", new { @class = "validation-msg" })
            </div>

            <!-- Remember me / Forgot -->
            <div class="extras">
                <label>
                    @Html.CheckBoxFor(m => m.RememberMe)
                    Remember me
                </label>
                <a href="#" class="forgot">Forgot password?</a>
            </div>

            <button type="submit" class="btn-login">
                <i class="bi bi-box-arrow-in-right"></i> Sign In
            </button>
        }

        <p class="bottom-note">
            Don't have an account? <a href="mailto:support@rechargesoftware.com">Contact admin</a>
        </p>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        document.getElementById('togglePwd').addEventListener('click', function () {
            var pwd = document.getElementById('Password');
            var isText = pwd.type === 'text';
            pwd.type = isText ? 'password' : 'text';
            this.className = isText ? 'bi bi-eye field-icon' : 'bi bi-eye-slash field-icon';
        });
    </script>
}
