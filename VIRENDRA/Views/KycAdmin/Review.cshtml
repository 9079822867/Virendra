@model VIRENDRA.Models.KycAdminReviewViewModel
@using VIRENDRA.Models
@{
    ViewBag.Title = "Review KYC";
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
    var u = Model.User;
    var kyc = Model.Kyc;
    bool allUploaded = kyc.UploadedCount == KycConstants.Categories.Length;
}

<style>
    .rv-head { border-radius: 14px; background: linear-gradient(135deg,#667eea 0%,#764ba2 100%); color: #fff; }
    .rv-avatar { width: 60px; height: 60px; border-radius: 50%; background: rgba(255,255,255,.22); display: flex; align-items: center; justify-content: center; font-size: 1.5rem; font-weight: 700; }
    .rv-tile { border-radius: 14px; overflow: hidden; height: 100%; }
    .rv-tile .tile-head { background: linear-gradient(135deg,#667eea 0%,#764ba2 100%); color: #fff; padding: .8rem 1rem; display: flex; justify-content: space-between; align-items: center; }
    .rv-tile.is-approved .tile-head { background: linear-gradient(135deg,#11998e 0%,#38ef7d 100%); }
    .rv-tile.is-rejected .tile-head { background: linear-gradient(135deg,#eb3349 0%,#f45c43 100%); }
    .rv-tile .tile-head h6 { margin: 0; font-weight: 700; font-size: .92rem; }
    .rv-img { height: 200px; border-radius: 10px; background: #f6f7fb; display: flex; align-items: center; justify-content: center; overflow: hidden; cursor: zoom-in; border: 1px solid #e6e8f5; }
    .rv-img img { width: 100%; height: 100%; object-fit: contain; background: #fff; }
    .rv-empty { height: 200px; border-radius: 10px; border: 2px dashed #d5d9f2; display: flex; align-items: center; justify-content: center; color: #9aa0c3; flex-direction: column; font-size: .82rem; }
</style>

<div class="container-fluid">

    <div class="row mb-4">
        <div class="col-12">
            <h4 class="mb-1 fw-bold text-dark"><i class="fas fa-user-check text-primary me-2"></i>Review KYC</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0" style="font-size:.82rem;">
                    <li class="breadcrumb-item"><a href="@Url.Action("Dashboard","Home")">Dashboard</a></li>
                    <li class="breadcrumb-item"><a href="@Url.Action("Index","KycAdmin")">KYC Approval</a></li>
                    <li class="breadcrumb-item active">@u.Username</li>
                </ol>
            </nav>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible mb-4" style="border-radius:10px;">
            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible mb-4" style="border-radius:10px;">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- ── User summary ───────────────────────────────── -->
    <div class="rv-head shadow-sm p-4 mb-4 d-flex flex-column flex-md-row align-items-md-center gap-3">
        <div class="rv-avatar flex-shrink-0">@((string.IsNullOrWhiteSpace(u.FullName) ? (u.Username ?? "U") : u.FullName.Trim()).Substring(0, 1).ToUpper())</div>
        <div class="flex-grow-1">
            <h5 class="fw-bold mb-1">@(string.IsNullOrWhiteSpace(u.FullName) ? u.Username : u.FullName)</h5>
            <div style="opacity:.9;font-size:.85rem;">
                <i class="fas fa-user me-1"></i>@u.Username &nbsp;&middot;&nbsp;
                <i class="fas fa-id-badge me-1"></i>ID @u.UserId &nbsp;&middot;&nbsp;
                <i class="fas fa-user-tag me-1"></i>@(u.RoleName ?? "-")
                @if (!string.IsNullOrWhiteSpace(u.MobileNumber))
                {
                    <text>&nbsp;&middot;&nbsp;<i class="fas fa-phone me-1"></i>@u.MobileNumber</text>
                }
            </div>
            <div class="mt-2">
                <span class="badge rounded-pill bg-light text-dark">@kyc.ApprovedCount / 4 approved</span>
                <span class="badge rounded-pill" style="background:rgba(255,255,255,.22);">@u.OverallStatus</span>
            </div>
        </div>
        @if (!kyc.IsApproved)
        {
            using (Html.BeginForm("ApproveAll", "KycAdmin", FormMethod.Post, new { @class = "flex-shrink-0", onsubmit = "return confirm('Approve all 4 documents for this user?');" }))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" name="userId" value="@u.UserId" />
                <button type="submit" class="btn btn-light fw-semibold px-4" @(allUploaded ? "" : "disabled")
                        title="@(allUploaded ? "Approve every document" : "All 4 documents must be uploaded first")">
                    <i class="fas fa-check-double me-1 text-success"></i>Approve All
                </button>
            }
        }
        else
        {
            <span class="badge bg-light text-success px-3 py-2 fs-6 flex-shrink-0"><i class="fas fa-shield-alt me-1"></i>KYC Approved</span>
        }
    </div>

    <!-- ── Documents ──────────────────────────────────── -->
    <div class="row g-4">
        @foreach (var cat in KycConstants.Categories)
        {
            var doc = kyc.Get(cat);
            int? st = doc?.StatusId;
            bool approved = st == KycConstants.Approved;
            bool rejected = st == KycConstants.Rejected;
            string url = doc == null ? null
                : Url.Action("Document", "Kyc", new { userId = u.UserId, category = cat, v = doc.AddedbyDate.Ticks });
            string badgeCls = approved ? "bg-light text-success" : rejected ? "bg-light text-danger"
                            : st == KycConstants.Pending ? "bg-warning text-dark" : "bg-light text-secondary";

            <div class="col-md-6 col-xl-3">
                <div class="card border-0 shadow-sm rv-tile @(approved ? "is-approved" : rejected ? "is-rejected" : "")">
                    <div class="tile-head">
                        <h6>@KycConstants.CategoryTitle(cat)</h6>
                        <span class="badge rounded-pill @badgeCls">@KycConstants.StatusName(st)</span>
                    </div>
                    <div class="card-body d-flex flex-column">
                        @if (doc == null)
                        {
                            <div class="rv-empty"><i class="fas fa-file-upload fa-2x mb-2"></i>Not uploaded yet</div>
                        }
                        else if (doc.IsPdf)
                        {
                            <a href="@url" target="_blank" class="rv-img text-decoration-none text-danger flex-column">
                                <i class="fas fa-file-pdf fa-3x"></i><small class="mt-2">Open PDF</small>
                            </a>
                        }
                        else
                        {
                            <div class="rv-img" data-img="@url" data-title="@KycConstants.CategoryTitle(cat)">
                                <img src="@url" alt="@KycConstants.CategoryTitle(cat)" />
                            </div>
                        }

                        @if (doc != null)
                        {
                            <div class="small text-muted mt-2"><i class="far fa-clock me-1"></i>@doc.AddedbyDate.ToString("dd MMM yyyy, hh:mm tt")</div>
                            if (doc.ActionDate.HasValue)
                            {
                                <div class="small text-muted"><i class="fas fa-user-check me-1"></i>@KycConstants.StatusName(st) on @doc.ActionDate.Value.ToString("dd MMM yyyy, hh:mm tt")</div>
                            }
                            if (rejected && !string.IsNullOrWhiteSpace(doc.Remark))
                            {
                                <div class="alert alert-danger py-2 px-3 mt-2 mb-0" style="font-size:.8rem;border-radius:8px;">
                                    <strong>Reason:</strong> @doc.Remark
                                </div>
                            }

                            <div class="mt-auto pt-3 d-flex gap-2">
                                @if (!approved)
                                {
                                    using (Html.BeginForm("Approve", "KycAdmin", FormMethod.Post, new { @class = "flex-grow-1" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="userId" value="@u.UserId" />
                                        <input type="hidden" name="category" value="@cat" />
                                        <button type="submit" class="btn btn-success btn-sm w-100"><i class="fas fa-check me-1"></i>Approve</button>
                                    }
                                }
                                @if (!rejected)
                                {
                                    <button type="button" class="btn btn-outline-danger btn-sm flex-grow-1 btn-reject"
                                            data-cat="@cat" data-title="@KycConstants.CategoryTitle(cat)">
                                        <i class="fas fa-times me-1"></i>Reject
                                    </button>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="mt-4">
        <a href="@Url.Action("Index","KycAdmin")" class="btn btn-light"><i class="fas fa-arrow-left me-1"></i>Back to list</a>
    </div>
</div>

<!-- Image lightbox -->
<div class="modal fade" id="imgModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content border-0" style="border-radius:14px;overflow:hidden;">
            <div class="modal-header text-white" style="background:linear-gradient(135deg,#667eea 0%,#764ba2 100%);">
                <h6 class="modal-title fw-bold" id="imgModalTitle"></h6>
                <a id="imgModalOpen" href="#" target="_blank" class="btn btn-sm btn-light ms-auto me-2"><i class="fas fa-external-link-alt me-1"></i>Open</a>
                <button type="button" class="btn-close btn-close-white m-0" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center bg-light">
                <img id="imgModalImg" src="" alt="" style="max-width:100%;max-height:78vh;" />
            </div>
        </div>
    </div>
</div>

<!-- Reject modal -->
<div class="modal fade" id="rejectModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0" style="border-radius:14px;overflow:hidden;">
            @using (Html.BeginForm("Reject", "KycAdmin", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" name="userId" value="@u.UserId" />
                <input type="hidden" name="category" id="rejectCategory" />
                <div class="modal-header text-white" style="background:linear-gradient(135deg,#eb3349 0%,#f45c43 100%);">
                    <h6 class="modal-title fw-bold">Reject <span id="rejectTitle"></span></h6>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <label class="form-label fw-semibold" for="rejectRemark">Reason <span class="text-danger">*</span></label>
                    <textarea name="remark" id="rejectRemark" class="form-control" rows="3" maxlength="250" required
                              placeholder="e.g. Image is blurry, please upload a clear photo"></textarea>
                    <div class="d-flex flex-wrap gap-1 mt-2">
                        @foreach (var r in new[] { "Image is blurry / not readable", "Document is cropped", "Wrong document uploaded", "Name does not match", "Face not clearly visible" })
                        {
                            <button type="button" class="btn btn-light btn-sm reason-chip" style="font-size:.75rem;">@r</button>
                        }
                    </div>
                    <small class="text-muted d-block mt-2">The user will see this reason and can re-upload the document.</small>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger"><i class="fas fa-times me-1"></i>Reject</button>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var imgModal = new bootstrap.Modal(document.getElementById('imgModal'));
            document.querySelectorAll('.rv-img[data-img]').forEach(function (el) {
                el.addEventListener('click', function () {
                    document.getElementById('imgModalImg').src = el.dataset.img;
                    document.getElementById('imgModalOpen').href = el.dataset.img;
                    document.getElementById('imgModalTitle').textContent = el.dataset.title;
                    imgModal.show();
                });
            });

            var rejectModal = new bootstrap.Modal(document.getElementById('rejectModal'));
            var remark = document.getElementById('rejectRemark');
            document.querySelectorAll('.btn-reject').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    document.getElementById('rejectCategory').value = btn.dataset.cat;
                    document.getElementById('rejectTitle').textContent = btn.dataset.title;
                    remark.value = '';
                    rejectModal.show();
                    setTimeout(function () { remark.focus(); }, 300);
                });
            });
            document.querySelectorAll('.reason-chip').forEach(function (chip) {
                chip.addEventListener('click', function () { remark.value = chip.textContent; });
            });
        })();
    </script>
}
