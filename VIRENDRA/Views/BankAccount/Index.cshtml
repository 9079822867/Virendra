@model IEnumerable<VIRENDRA.Models.BankAccount>

@{
    ViewBag.Title = "Bank Accounts";
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
}

<div class="container-fluid">

    <!-- Page Title -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                <div>
                    <h4 class="mb-1 fw-bold text-dark">
                        <i class="fas fa-university text-primary me-2"></i>Bank Accounts
                    </h4>
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb mb-0" style="font-size:.82rem;">
                            <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Dashboard</a></li>
                            <li class="breadcrumb-item active">Bank Accounts</li>
                        </ol>
                    </nav>
                </div>
                <a href="@Url.Action("Create")" class="btn btn-success px-3 fw-semibold">
                    <i class="fas fa-plus me-1"></i>Add Bank Account
                </a>
            </div>
        </div>
    </div>

    <!-- Alerts -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible mb-3" style="border-radius:10px;">
            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible mb-3" style="border-radius:10px;">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Stats Cards -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm" style="border-radius:12px;border-left:4px solid #4CAF50!important;">
                <div class="card-body d-flex align-items-center gap-3 py-3">
                    <div class="rounded-circle d-flex align-items-center justify-content-center"
                         style="width:46px;height:46px;background:#4CAF5015;flex-shrink:0;">
                        <i class="fas fa-university" style="color:#4CAF50;font-size:1.1rem;"></i>
                    </div>
                    <div>
                        <div class="text-muted" style="font-size:.75rem;">Total Accounts</div>
                        <div class="fw-bold fs-5 text-dark">@Model.Count()</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm" style="border-radius:12px;border-left:4px solid #2196F3!important;">
                <div class="card-body d-flex align-items-center gap-3 py-3">
                    <div class="rounded-circle d-flex align-items-center justify-content-center"
                         style="width:46px;height:46px;background:#2196F315;flex-shrink:0;">
                        <i class="fas fa-check-circle" style="color:#2196F3;font-size:1.1rem;"></i>
                    </div>
                    <div>
                        <div class="text-muted" style="font-size:.75rem;">Active</div>
                        <div class="fw-bold fs-5 text-dark">@Model.Count()</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm" style="border-radius:12px;border-left:4px solid #F44336!important;">
                <div class="card-body d-flex align-items-center gap-3 py-3">
                    <div class="rounded-circle d-flex align-items-center justify-content-center"
                         style="width:46px;height:46px;background:#F4433615;flex-shrink:0;">
                        <i class="fas fa-ban" style="color:#F44336;font-size:1.1rem;"></i>
                    </div>
                    <div>
                        <div class="text-muted" style="font-size:.75rem;">Blocked</div>
                        <div class="fw-bold fs-5 text-dark">@Model.Count()</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm" style="border-radius:12px;border-left:4px solid #FF9800!important;">
                <div class="card-body d-flex align-items-center gap-3 py-3">
                    <div class="rounded-circle d-flex align-items-center justify-content-center"
                         style="width:46px;height:46px;background:#FF980015;flex-shrink:0;">
                        <i class="fas fa-lock" style="color:#FF9800;font-size:1.1rem;"></i>
                    </div>
                    <div>
                        <div class="text-muted" style="font-size:.75rem;">Total Block Amt</div>
                        <div class="fw-bold fs-5 text-dark">
                            <i class="fa fa-rupee-sign"></i>@Model.Sum(b => b.BlockAmount ?? 0).ToString("0.##")
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Table Card -->
    <div class="card border-0 shadow-sm" style="border-radius:12px;overflow:hidden;">
        <div class="card-header border-0 py-3 px-4" style="background:linear-gradient(135deg,#667eea 0%,#764ba2 100%);">
            <div class="d-flex align-items-center">
                <div class="rounded-circle d-flex align-items-center justify-content-center me-3"
                     style="width:36px;height:36px;background:rgba(255,255,255,.2);">
                    <i class="fas fa-list text-white" style="font-size:.85rem;"></i>
                </div>
                <h6 class="mb-0 text-white fw-bold">All Bank Accounts</h6>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table id="bankTable" class="table table-hover align-middle mb-0" style="font-size:.86rem;">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">#</th>
                            <th>Bank Name</th>
                            <th>Holder Name</th>
                            <th>Account No</th>
                            <th>IFSC Code</th>
                            <th>UPI Address</th>
                            <th>Branch</th>
                            <th>Block Amt (<i class="fa fa-rupee-sign"></i>)</th>
                            <th class="text-center">Status</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var b in Model)
                        {
                            <tr>
                                <td class="ps-4 text-muted">@b.Id</td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="rounded-circle d-flex align-items-center justify-content-center"
                                             style="width:32px;height:32px;background:#667eea20;flex-shrink:0;">
                                            <i class="fas fa-university" style="color:#667eea;font-size:.7rem;"></i>
                                        </div>
                                        <span class="fw-semibold">@b.BankName</span>
                                    </div>
                                </td>
                                <td>@b.HolderName</td>
                                <td><code class="text-dark">@b.AccountNo</code></td>
                                <td><code class="text-dark">@b.IFSCCode</code></td>
                                <td>
                                    @if (!string.IsNullOrEmpty(b.UpiAdress))
                                    {
                                        <span class="badge bg-light text-dark border" style="font-size:.75rem;">@b.UpiAdress</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td>@(b.BranchName ?? "—")</td>
                                <td>
                                    @if (b.BlockAmount.HasValue && b.BlockAmount > 0)
                                    {
                                        <span class="fw-semibold text-warning"><i class="fa fa-rupee-sign"></i>@b.BlockAmount.Value.ToString("0.##")</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="form-check form-switch d-inline-flex align-items-center gap-2 mb-0">
                                        <input class="form-check-input toggle-block" type="checkbox"
                                               data-id="@b.Id"
                                               style="width:42px;height:22px;cursor:pointer;"
                                               @(!string.IsNullOrEmpty(b.BlockUser) ? "checked" : "") />
                                        <label class="toggle-label fw-semibold @(!string.IsNullOrEmpty(b.BlockUser) ? "text-success" : "text-danger")"
                                               style="font-size:.75rem;min-width:38px;">
                                            @(!string.IsNullOrEmpty(b.BlockUser) ? "Active" : "Blocked")
                                        </label>
                                    </div>
                                </td>
                                <td class="text-center">
                                    <div class="d-flex gap-1 justify-content-center">
                                        <a href="@Url.Action("Edit", new { id = b.Id })"
                                           class="btn btn-sm btn-outline-info" title="Edit">
                                            <i class="fas fa-pencil-alt"></i>
                                        </a>
                                        <button type="button" class="btn btn-sm btn-outline-danger"
                                                title="Delete"
                                                onclick="confirmDelete(@b.Id, '@Html.Raw((b.BankName + " – " + b.HolderName).Replace("'", "\\'"))')">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirm Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius:12px;overflow:hidden;">
            <div class="modal-header border-0 pb-0"
                 style="background:linear-gradient(135deg,#F44336,#c62828);">
                <h5 class="modal-title text-white fw-bold">
                    <i class="fas fa-exclamation-triangle me-2"></i>Confirm Delete
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body pt-4">
                <p>Are you sure you want to delete bank account:</p>
                <p class="fw-semibold text-danger" id="deleteBankName"></p>
                <p class="text-muted small mb-0">
                    <i class="fas fa-info-circle me-1"></i>
                    This cannot be undone. If the account has wallet transactions linked, the delete will fail.
                </p>
            </div>
            <div class="modal-footer border-0">
                @using (Html.BeginForm("Delete", "BankAccount", FormMethod.Post, new { id = "deleteForm" }))
                {
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="deleteBankId" />
                    <button type="button" class="btn btn-light px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger px-4">
                        <i class="fas fa-trash me-1"></i>Delete
                    </button>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css">
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
    <script>
        $(function () {
            $('#bankTable').DataTable({ pageLength: 25, order: [[0, 'desc']] });

            // Toggle active/blocked status
            $(document).on('change', '.toggle-block', function () {
                var id      = $(this).data('id');
                var active  = $(this).is(':checked');   // checked = active = NOT blocked
                var label   = $(this).siblings('.toggle-label');

                $.post('@Url.Action("ToggleBlock")', { id: id, blockUser: !active }, function (res) {
                    if (res.success) {
                        label.text(active ? 'Active' : 'Blocked')
                             .removeClass('text-success text-danger')
                             .addClass(active ? 'text-success' : 'text-danger');
                    }
                });
            });
        });

        function confirmDelete(id, name) {
            document.getElementById('deleteBankId').value = id;
            document.getElementById('deleteBankName').textContent = name;
            new bootstrap.Modal(document.getElementById('deleteModal')).show();
        }
    </script>
}
