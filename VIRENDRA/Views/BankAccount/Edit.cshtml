@model VIRENDRA.Models.BankAccount

@{
    ViewBag.Title = "Edit Bank Account";
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
}

<div class="container-fluid">

    <!-- Page Title -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                <div>
                    <h4 class="mb-1 fw-bold text-dark">
                        <i class="fas fa-pencil-alt text-info me-2"></i>Edit Bank Account
                        <span class="text-muted fw-normal ms-1 fs-6">&mdash; @Model.BankName (@Model.HolderName)</span>
                    </h4>
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb mb-0" style="font-size:.82rem;">
                            <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Dashboard</a></li>
                            <li class="breadcrumb-item"><a href="@Url.Action("Index")">Bank Accounts</a></li>
                            <li class="breadcrumb-item active">Edit</li>
                        </ol>
                    </nav>
                </div>
                <a href="@Url.Action("Index")" class="btn btn-outline-secondary btn-sm px-3">
                    <i class="fas fa-arrow-left me-1"></i>Back to List
                </a>
            </div>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible mb-3" style="border-radius:10px;">
            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @using (Html.BeginForm("Edit", "BankAccount", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.Id)
        @Html.HiddenFor(m => m.AddedById)
        @Html.HiddenFor(m => m.AddedDate)

        if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger alert-dismissible mb-3" style="border-radius:10px;">
                <i class="fas fa-exclamation-circle me-2"></i>
                <strong>Please fix the errors below before saving.</strong>
                @Html.ValidationSummary(true, "", new { @class = "mb-0 mt-1" })
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @Html.Partial("_BankAccountForm", Model)

        <!-- Meta Info Strip -->
        <div class="row mt-3">
            <div class="col-12">
                <div class="d-flex flex-wrap gap-3 px-1" style="font-size:.78rem;color:#888;">
                    <span><i class="fas fa-fingerprint me-1"></i>ID: <strong>#@Model.Id</strong></span>
                    @if (Model.AddedDate.HasValue)
                    {
                        <span><i class="fas fa-calendar-plus me-1"></i>Created: <strong>@Model.AddedDate.Value.ToString("dd MMM yyyy, hh:mm tt")</strong></span>
                    }
                    @if (Model.UpdatedDate.HasValue)
                    {
                        <span><i class="fas fa-calendar-check me-1"></i>Updated: <strong>@Model.UpdatedDate.Value.ToString("dd MMM yyyy, hh:mm tt")</strong></span>
                    }
                </div>
            </div>
        </div>

        <!-- Action Bar -->
        <div class="row mt-3">
            <div class="col-12">
                <div class="card border-0 shadow-sm" style="border-radius:10px;">
                    <div class="card-body py-3 px-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <span class="text-muted small">
                            <i class="fas fa-info-circle me-1"></i>
                            Editing <strong>@Model.BankName</strong> &mdash; Account #<code>@Model.AccountNo</code>
                        </span>
                        <div class="d-flex gap-2">
                            <a href="@Url.Action("Index")" class="btn btn-outline-secondary px-4">
                                <i class="fas fa-times me-1"></i>Cancel
                            </a>
                            <button type="submit" class="btn btn-info text-white px-4 fw-semibold">
                                <i class="fas fa-save me-1"></i>Update Account
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
