@model VIRENDRA.Models.WalletRequest

@{
    ViewBag.Title = "Edit Payment Request";
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
}

<div class="container-fluid">

    <!-- Page Title -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                <div>
                    <h4 class="mb-1 fw-bold text-dark">
                        <i class="fas fa-edit text-primary me-2"></i>Edit Payment Request
                    </h4>
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb mb-0" style="font-size:.82rem;">
                            <li class="breadcrumb-item"><a href="@Url.Action("Dashboard","Home")">Dashboard</a></li>
                            <li class="breadcrumb-item"><a href="@Url.Action("Index","Wallet")">Payment Requests</a></li>
                            <li class="breadcrumb-item active">Edit #@Model.Id</li>
                        </ol>
                    </nav>
                </div>
                <a href="@Url.Action("Index","Wallet")" class="btn btn-light px-3">
                    <i class="fas fa-arrow-left me-1"></i>Back to List
                </a>
            </div>
        </div>
    </div>

    <!-- Validation Errors -->
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger alert-dismissible mb-3" style="border-radius:10px;">
            <i class="fas fa-exclamation-circle me-2"></i>
            <strong>Please fix the following errors:</strong>
            @Html.ValidationSummary(true, "", new { @class = "mb-0 mt-1" })
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @using (Html.BeginForm("Edit", "Wallet", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.Id)

        <!-- Status Badge (read-only display) -->
        <div class="card border-0 shadow-sm mb-4" style="border-radius:12px;overflow:hidden;">
            <div class="card-header border-0 py-3 px-4"
                 style="background:linear-gradient(135deg,#667eea 0%,#764ba2 100%);">
                <div class="d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center">
                        <div class="rounded-circle d-flex align-items-center justify-content-center me-3"
                             style="width:36px;height:36px;background:rgba(255,255,255,.2);">
                            <i class="fas fa-info text-white" style="font-size:.85rem;"></i>
                        </div>
                        <h6 class="mb-0 text-white fw-bold">Request #@Model.Id</h6>
                    </div>
                    <div>
                        @if (Model.StatusId == 2)
                        {
                            <span class="badge px-3 py-2" style="background:#4CAF50;font-size:.8rem;">
                                <i class="fas fa-check me-1"></i>Approved
                            </span>
                        }
                        else if (Model.StatusId == 3)
                        {
                            <span class="badge px-3 py-2" style="background:#F44336;font-size:.8rem;">
                                <i class="fas fa-times me-1"></i>Rejected
                            </span>
                        }
                        else
                        {
                            <span class="badge px-3 py-2" style="background:#FF9800;font-size:.8rem;">
                                <i class="fas fa-clock me-1"></i>Pending
                            </span>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Main Form Card -->
        <div class="card border-0 shadow-sm" style="border-radius:12px;overflow:hidden;">
            <div class="card-body p-4">
                <div class="row g-4">

                    <!-- ===== LEFT COLUMN ===== -->
                    <div class="col-md-6 border-end pe-4">

                        <!-- User -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold">
                                <i class="fas fa-user text-muted me-1"></i>
                                User <span class="text-danger">*</span>
                            </label>
                            @Html.DropDownListFor(m => m.UserId,
                                (SelectList)ViewBag.UserList,
                                "Select a User",
                                new { @class = "form-select", required = "required" })
                            @Html.ValidationMessageFor(m => m.UserId, "", new { @class = "text-danger small" })
                        </div>

                        <!-- Amount -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold">
                                <i class="fa fa-rupee-sign text-muted me-1"></i>
                                Amount <span class="text-danger">*</span>
                            </label>
                            @Html.TextBoxFor(m => m.Amount,
                                new { @class = "form-control", type = "number", step = "0.01", min = "0.01", required = "required" })
                            @Html.ValidationMessageFor(m => m.Amount, "", new { @class = "text-danger small" })
                        </div>

                        <!-- Bank Account -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold">
                                <i class="fas fa-university text-muted me-1"></i>
                                Bank Account
                            </label>
                            @Html.DropDownListFor(m => m.BankAccountId,
                                (SelectList)ViewBag.BankAccountList,
                                "-- Select Bank Account --",
                                new { @class = "form-select" })
                        </div>

                        <!-- Wallet Type -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold">
                                <i class="fas fa-wallet text-muted me-1"></i>
                                Wallet Type <span class="text-danger">*</span>
                            </label>
                            @Html.DropDownListFor(m => m.WalletType,
                                (SelectList)ViewBag.WalletTypeList,
                                new { @class = "form-select", required = "required" })
                            @Html.ValidationMessageFor(m => m.WalletType, "", new { @class = "text-danger small" })
                        </div>

                        <!-- Transaction Flags -->
                        <div class="mb-2 p-3 rounded" style="background:#f8f9fa;">
                            <div class="form-label fw-semibold mb-2">Transaction Flags</div>
                            <div class="form-check mb-2">
                                @Html.CheckBoxFor(m => m.IsCredit, new { @class = "form-check-input" })
                                <label class="form-check-label" for="IsCredit">
                                    <i class="fas fa-arrow-down text-success me-1"></i>Is Credit
                                </label>
                            </div>
                            <div class="form-check mb-2">
                                @Html.CheckBoxFor(m => m.IsDebit, new { @class = "form-check-input" })
                                <label class="form-check-label" for="IsDebit">
                                    <i class="fas fa-arrow-up text-danger me-1"></i>Is Debit
                                </label>
                            </div>
                            <div class="form-check">
                                @Html.CheckBoxFor(m => m.IsPullOut, new { @class = "form-check-input" })
                                <label class="form-check-label" for="IsPullOut">
                                    <i class="fas fa-sign-out-alt text-warning me-1"></i>Is Pull Out
                                </label>
                            </div>
                        </div>
                    </div>

                    <!-- ===== RIGHT COLUMN ===== -->
                    <div class="col-md-6 ps-4">

                        <!-- Transfer Type -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold">
                                <i class="fas fa-exchange-alt text-muted me-1"></i>
                                Transfer Type <span class="text-danger">*</span>
                            </label>
                            @Html.DropDownListFor(m => m.TransferType,
                                (SelectList)ViewBag.TransferTypeList,
                                new { @class = "form-select", required = "required" })
                            @Html.ValidationMessageFor(m => m.TransferType, "", new { @class = "text-danger small" })
                        </div>

                        <!-- Payment Date -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold">
                                <i class="fas fa-calendar text-muted me-1"></i>
                                Payment Date
                            </label>
                            @Html.TextBoxFor(m => m.PaymentDate, "{0:yyyy-MM-dd}",
                                new { @class = "form-control", type = "date" })
                        </div>

                        <!-- Cheque / Ref Number -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold">
                                <i class="fas fa-hashtag text-muted me-1"></i>
                                Cheque / Ref Number <span class="text-danger">*</span>
                            </label>
                            @Html.TextBoxFor(m => m.ChequeRefNo,
                                new { @class = "form-control", required = "required" })
                            @Html.ValidationMessageFor(m => m.ChequeRefNo, "", new { @class = "text-danger small" })
                        </div>

                        <!-- Payment Remark -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold">
                                <i class="fas fa-sticky-note text-muted me-1"></i>
                                Payment Remark
                            </label>
                            @Html.TextBoxFor(m => m.PaymentRemark, new { @class = "form-control" })
                        </div>

                        <!-- Remark / Comment -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold">
                                <i class="fas fa-comment text-muted me-1"></i>
                                Remark <span class="text-danger">*</span>
                            </label>
                            @Html.TextAreaFor(m => m.Remark,
                                new { @class = "form-control", rows = 3, required = "required" })
                            @Html.ValidationMessageFor(m => m.Remark, "", new { @class = "text-danger small" })
                        </div>
                    </div>
                </div>
            </div>

            <!-- Action Bar -->
            <div class="card-footer border-0 py-3 px-4"
                 style="background:linear-gradient(135deg,#f8f9fa,#e9ecef);">
                <div class="d-flex justify-content-end gap-2">
                    <a href="@Url.Action("Index","Wallet")" class="btn btn-light px-4">
                        <i class="fas fa-times-circle me-1"></i>Cancel
                    </a>
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="fas fa-save me-1"></i>Save Changes
                    </button>
                </div>
            </div>
        </div>
    }
</div>
