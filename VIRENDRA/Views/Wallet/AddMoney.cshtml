@model VIRENDRA.Models.WalletRequest

@{
    ViewBag.Title = "Wallet \u2014 Add Money";
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="page-title-box d-sm-flex align-items-center justify-content-between">
                <h4 class="mb-sm-0 font-size-18">Wallet</h4>
                <div class="page-title-right">
                    <ol class="breadcrumb m-0">
                        <li class="breadcrumb-item active">Add Money</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible">
            <i class="fas fa-check-circle me-1"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card">
        <div class="card-body">
            @using (Html.BeginForm("AddMoney", "Wallet", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3" })

                <div class="row g-4">
                    <!-- ===== LEFT COLUMN ===== -->
                    <div class="col-md-6 border-end pe-4">
                        <!-- Bank Account -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Bank Account</label>
                            @Html.DropDownListFor(m => m.BankAccountId,
                                     (SelectList)ViewBag.BankAccountList,
                                     "-- Select Bank Account --",
                                     new { @class = "form-select" })
                        </div>
                        <!-- User -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold">User <span class="text-danger">*</span></label>
                            @Html.DropDownListFor(m => m.UserId,
                                     (SelectList)ViewBag.UserList,
                                     "Select a User",
                                     new { @class = "form-select", required = "required" })
                            @Html.ValidationMessageFor(m => m.UserId, "", new { @class = "text-danger small" })
                        </div>

                        <!-- Amount -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Amount <span class="text-danger">*</span></label>
                            @Html.TextBoxFor(m => m.Amount, new { @class = "form-control", type = "number", step = "0.01", min = "0.01", required = "required" })
                            @Html.ValidationMessageFor(m => m.Amount, "", new { @class = "text-danger small" })
                        </div>

                        <!-- Checkboxes -->
                        <div class="mb-2">
                            <div class="form-check mb-2">
                                @Html.CheckBoxFor(m => m.IsCredit, new { @class = "form-check-input" })
                                <label class="form-check-label fw-semibold" for="IsCredit">IsCredit</label>
                            </div>
                            <div class="form-check mb-2">
                                @Html.CheckBoxFor(m => m.IsDebit, new { @class = "form-check-input" })
                                <label class="form-check-label fw-semibold" for="IsDebit">IsDebit</label>
                            </div>
                            <div class="form-check mb-2">
                                @Html.CheckBoxFor(m => m.IsPullOut, new { @class = "form-check-input" })
                                <label class="form-check-label fw-semibold" for="IsPullOut">IsPullOut</label>
                            </div>

                            @*<div class="form-check">
                @Html.CheckBoxFor(m => m.SMS, new { @class = "form-check-input" })
                <label class="form-check-label fw-semibold" for="SMS">SMS</label>
            </div>*@
                        </div>
                    </div>

                    <!-- ===== RIGHT COLUMN ===== -->
                    <div class="col-md-6 ps-4">

                        <!-- Transfer Type -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Transfer Type <span class="text-danger">*</span></label>
                            @Html.DropDownListFor(m => m.TransferType,
                                (SelectList)ViewBag.TransferTypeList,
                                new { @class = "form-select", required = "required" })
                            @Html.ValidationMessageFor(m => m.TransferType, "", new { @class = "text-danger small" })
                        </div>

                        <!-- Payment Date -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Payment Date</label>
                            @Html.TextBoxFor(m => m.PaymentDate, "{0:yyyy-MM-dd}",
                                new { @class = "form-control", type = "date" })
                        </div>

                      

                        <!-- Cheque/Ref Number -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Cheque / Ref Number <span class="text-danger">*</span></label>
                            @Html.TextBoxFor(m => m.ChequeRefNo,
                                new { @class = "form-control", required = "required" })
                            @Html.ValidationMessageFor(m => m.ChequeRefNo, "", new { @class = "text-danger small" })
                        </div>

                        <!-- Remark -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Remark <span class="text-danger">*</span></label>
                            @Html.TextAreaFor(m => m.Remark,
                                new { @class = "form-control", rows = 3, required = "required" })
                            @Html.ValidationMessageFor(m => m.Remark, "", new { @class = "text-danger small" })
                        </div>
                    </div>
                </div>

                <!-- Action Buttons -->
                <div class="d-flex justify-content-end gap-2 mt-3 pt-3 border-top">
                    <a href="@Url.Action("Dashboard", "Home")" class="btn btn-light px-4">
                        <i class="fas fa-times-circle me-1"></i> Cancel
                    </a>
                    <button type="submit" class="btn btn-success px-4">
                        <i class="fas fa-paper-plane me-1"></i> Submit
                    </button>
                </div>
            }
        </div>
    </div>
</div>
