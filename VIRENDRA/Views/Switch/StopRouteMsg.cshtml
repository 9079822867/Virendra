@using VIRENDRA.Infrastructure
@model List<VIRENDRA.Models.StopRouteMessageRow>
@{
    ViewBag.Title = "Stop Route Message";
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
    var ops  = ViewBag.Operators as List<VIRENDRA.Models.LookupItem> ?? new List<VIRENDRA.Models.LookupItem>();
    var apis = ViewBag.Apis      as List<VIRENDRA.Models.LookupItem> ?? new List<VIRENDRA.Models.LookupItem>();
    var edit = ViewBag.Edit as VIRENDRA.Models.StopRouteMessageRow;

    var selOps  = IdFilter.Ids(edit?.OpFilter);
    var selApis = IdFilter.Ids(edit?.ApiFilter);
    string msgText = edit == null ? "" : string.Join("\n", (edit.MsgFilter ?? "").Split(';'));
}

<div class="container-fluid">
    <div class="page-title-box mb-3">
        <h4 class="mb-1">Stop Route Message</h4>
        <p class="text-muted mb-0" style="font-size:.85rem;">
            Normally a failed vendor reply makes the recharge try the next vendor. If the reply contains one of these texts
            (e.g. "Invalid Number"), the recharge fails right away and the wallet is refunded &mdash; no other vendor is tried.
        </p>
    </div>

    @Html.Partial("_SwitchNav")

    <div class="card mb-3">
        <div class="card-header bg-white fw-semibold">@(edit != null ? "Edit stop message #" + edit.Id : "Add stop message")</div>
        <div class="card-body">
            <form method="post" action="@Url.Action("SaveStopRouteMsg")">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@(edit?.Id ?? 0)" />
                <div class="row g-3">
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label small fw-semibold">Operators</label>
                        <select name="opIds" class="form-select form-select-sm" multiple size="6">
                            <option value="0" @(selOps.Contains(0) ? "selected" : "")>All</option>
                            @foreach (var o in ops) { <option value="@o.Id" @(selOps.Contains(o.Id) ? "selected" : "")>@o.Name</option> }
                        </select>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label small fw-semibold">Vendors</label>
                        <select name="apiIds" class="form-select form-select-sm" multiple size="6">
                            <option value="0" @(selApis.Contains(0) ? "selected" : "")>All</option>
                            @foreach (var a in apis) { <option value="@a.Id" @(selApis.Contains(a.Id) ? "selected" : "")>@a.Name</option> }
                        </select>
                    </div>
                    <div class="col-lg-6">
                        <label class="form-label small fw-semibold">Message texts</label>
                        <textarea name="msgFilter" class="form-control form-control-sm" rows="6" placeholder="One per line, e.g.&#10;Invalid Number&#10;Wrong Operator" required>@msgText</textarea>
                        <div class="form-text">Not case-sensitive. A reply containing any line stops switching.</div>
                    </div>
                </div>
                <div class="mt-3 d-flex gap-2">
                    <button type="submit" class="btn btn-success btn-sm px-4">@(edit != null ? "Update" : "Add")</button>
                    @if (edit != null) { <a href="@Url.Action("StopRouteMsg")" class="btn btn-outline-secondary btn-sm">Cancel</a> }
                </div>
            </form>
        </div>
    </div>

    <div class="card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle mb-0" style="font-size:.88rem;">
                    <thead class="table-light">
                        <tr><th>#</th><th>Operators</th><th>Vendors</th><th>Messages</th><th>Updated</th><th class="text-end">Actions</th></tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr><td colspan="6" class="text-center text-muted py-4">No stop route messages.</td></tr>
                        }
                        @foreach (var r in Model)
                        {
                            <tr>
                                <td>@r.Id</td>
                                <td>@IdFilter.Names(r.OpFilter, ops)</td>
                                <td>@IdFilter.Names(r.ApiFilter, apis)</td>
                                <td>
                                    @foreach (var m in (r.MsgFilter ?? "").Split(';').Where(s => !string.IsNullOrWhiteSpace(s)))
                                    {
                                        <span class="badge bg-light text-dark border me-1 mb-1">@m</span>
                                    }
                                </td>
                                <td class="text-nowrap">@((r.UpdatedDate ?? r.AddedDate)?.ToString("dd MMM yyyy HH:mm"))</td>
                                <td class="text-end text-nowrap">
                                    <a href="@Url.Action("StopRouteMsg", new { editId = r.Id })" class="btn btn-sm btn-primary">Edit</a>
                                    <form method="post" action="@Url.Action("DeleteStopRouteMsg")" class="d-inline" onsubmit="return confirm('Delete this stop message?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@r.Id" />
                                        <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
