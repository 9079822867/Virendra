@using VIRENDRA.Infrastructure
@model List<VIRENDRA.Models.BlockRouteRow>
@{
    ViewBag.Title = "Block Route";
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
    var ops     = ViewBag.Operators as List<VIRENDRA.Models.LookupItem> ?? new List<VIRENDRA.Models.LookupItem>();
    var circles = ViewBag.Circles   as List<VIRENDRA.Models.LookupItem> ?? new List<VIRENDRA.Models.LookupItem>();
    var users   = ViewBag.Users     as List<VIRENDRA.Models.LookupItem> ?? new List<VIRENDRA.Models.LookupItem>();
    var edit    = ViewBag.Edit as VIRENDRA.Models.BlockRouteRow;

    var selOps     = IdFilter.Ids(edit?.OpFilter);
    var selCircles = IdFilter.Ids(edit?.CircleFilter);
    var selUsers   = IdFilter.Ids(edit?.UserFilter);
    string amountText = edit == null ? "" :
        string.Join(",", new[] { edit.Amounts, edit.AmountRanges }.Where(s => !string.IsNullOrWhiteSpace(s)));
}

<div class="container-fluid">
    <div class="page-title-box mb-3">
        <h4 class="mb-1">Block Route</h4>
        <p class="text-muted mb-0" style="font-size:.85rem;">
            Recharges matching operator, circle, user <b>and</b> amount are refused with "Service Down" before any wallet debit.
        </p>
    </div>

    @Html.Partial("_SwitchNav")

    <div class="card mb-3">
        <div class="card-header bg-white fw-semibold">@(edit != null ? "Edit block route #" + edit.Id : "Add block route")</div>
        <div class="card-body">
            <form method="post" action="@Url.Action("SaveBlockRoute")">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@(edit?.Id ?? 0)" />
                <div class="row g-3">
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label small fw-semibold">Operators</label>
                        <select name="opIds" class="form-select form-select-sm" multiple size="6">
                            <option value="0" @(selOps.Contains(0) ? "selected" : "")>All</option>
                            @foreach (var o in ops) { <option value="@o.Id" @(selOps.Contains(o.Id) ? "selected" : "")>@o.Name</option> }
                        </select>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label small fw-semibold">Circles</label>
                        <select name="circleIds" class="form-select form-select-sm" multiple size="6">
                            <option value="0" @(selCircles.Contains(0) ? "selected" : "")>All</option>
                            @foreach (var c in circles) { <option value="@c.Id" @(selCircles.Contains(c.Id) ? "selected" : "")>@c.Name</option> }
                        </select>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label small fw-semibold">Users</label>
                        <select name="userIds" class="form-select form-select-sm" multiple size="6">
                            <option value="0" @(selUsers.Contains(0) ? "selected" : "")>All</option>
                            @foreach (var u in users) { <option value="@u.Id" @(selUsers.Contains(u.Id) ? "selected" : "")>@u.Name</option> }
                        </select>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label small fw-semibold">Amounts</label>
                        <input type="text" name="amounts" class="form-control form-control-sm" value="@amountText" placeholder="10,20,1-5000" required />
                        <div class="form-text">Exact amounts and/or ranges, comma separated.</div>
                        <div class="form-text">Ctrl / Cmd-click to pick several. "All" overrides a selection.</div>
                    </div>
                </div>
                <div class="mt-3 d-flex gap-2">
                    <button type="submit" class="btn btn-success btn-sm px-4">@(edit != null ? "Update" : "Add")</button>
                    @if (edit != null) { <a href="@Url.Action("BlockRoute")" class="btn btn-outline-secondary btn-sm">Cancel</a> }
                </div>
            </form>
        </div>
    </div>

    <div class="card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle mb-0" style="font-size:.88rem;">
                    <thead class="table-light">
                        <tr>
                            <th>#</th><th>Operators</th><th>Circles</th><th>Users</th><th>Amounts</th><th>Updated</th><th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr><td colspan="7" class="text-center text-muted py-4">No block routes.</td></tr>
                        }
                        @foreach (var r in Model)
                        {
                            <tr>
                                <td>@r.Id</td>
                                <td>@IdFilter.Names(r.OpFilter, ops)</td>
                                <td>@IdFilter.Names(r.CircleFilter, circles)</td>
                                <td>@IdFilter.Names(r.UserFilter, users)</td>
                                <td class="font-monospace">@string.Join(", ", new[] { r.Amounts, r.AmountRanges }.Where(s => !string.IsNullOrWhiteSpace(s)))</td>
                                <td class="text-nowrap">@((r.UpdatedDate ?? r.AddedDate)?.ToString("dd MMM yyyy HH:mm"))</td>
                                <td class="text-end text-nowrap">
                                    <a href="@Url.Action("BlockRoute", new { editId = r.Id })" class="btn btn-sm btn-primary">Edit</a>
                                    <form method="post" action="@Url.Action("DeleteBlockRoute")" class="d-inline" onsubmit="return confirm('Delete this block route?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@r.Id" />
                                        <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
