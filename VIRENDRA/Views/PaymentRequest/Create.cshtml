@model VIRENDRA.Models.PaymentRequestModel
@{
    ViewBag.Title = "Payment request";
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
    var accounts = ViewBag.Accounts as List<VIRENDRA.Models.DepositAccount> ?? new List<VIRENDRA.Models.DepositAccount>();
    var modes    = ViewBag.TransferTypes as List<VIRENDRA.Models.LookupItem> ?? new List<VIRENDRA.Models.LookupItem>();
}

<style>
    .pr-steps { display:flex; gap:10px; margin-bottom:16px; flex-wrap:wrap; }
    .pr-step { flex:1; min-width:180px; display:flex; gap:10px; align-items:flex-start; background:var(--surface); border:1px solid var(--line); border-radius:var(--radius); padding:12px 14px; font-size:.82rem; color:var(--muted); }
    .pr-step b { display:block; color:var(--ink); font-size:.85rem; }
    .pr-num { width:24px; height:24px; border-radius:50%; background:var(--fill); color:var(--on-fill); display:grid; place-items:center; font-size:.72rem; font-weight:700; flex-shrink:0; }

    .acct { border:1px solid var(--line); border-radius:var(--radius); padding:12px 14px; cursor:pointer; background:var(--surface); transition:border-color .15s, box-shadow .15s; }
    .acct + .acct { margin-top:10px; }
    .acct:hover { border-color:var(--line-2); }
    .acct.on { border-color:var(--accent); box-shadow:0 0 0 3px var(--accent-ring); }
    .acct-head { display:flex; align-items:center; gap:10px; }
    .acct-mark { width:34px; height:34px; border-radius:9px; background:var(--soft); border:1px solid var(--line); display:grid; place-items:center; color:var(--ink-2); }
    .acct.on .acct-mark { background:var(--accent-soft); color:var(--accent-ink); border-color:#99f6e4; }
    .acct-row { display:flex; justify-content:space-between; gap:12px; font-size:.82rem; padding:5px 0; border-top:1px dashed var(--line); }
    .acct-row:first-of-type { margin-top:10px; }
    .acct-row span { color:var(--muted); }
    .acct-row b { font-family:var(--mono); font-weight:600; word-break:break-all; text-align:right; }
    .copy { border:0; background:none; color:var(--muted); padding:0 0 0 6px; }
    .copy:hover { color:var(--accent-ink); }
    .amt-big { font-size:1.4rem; font-weight:800; }
</style>

<div class="page-head">
    <div>
        <h4>Request wallet top-up</h4>
        <div class="text-muted small">Pay into our account first, then tell us the amount and UTR.</div>
    </div>
    <a href="@Url.Action("Index")" class="btn btn-light"><i class="fas fa-list me-1"></i>My requests</a>
</div>

<div class="pr-steps">
    <div class="pr-step"><span class="pr-num">1</span><div><b>Pay</b>Transfer to one of the accounts below by IMPS, NEFT, RTGS, UPI or cash.</div></div>
    <div class="pr-step"><span class="pr-num">2</span><div><b>Send request</b>Enter the amount and the UTR / reference from your bank.</div></div>
    <div class="pr-step"><span class="pr-num">3</span><div><b>Get credited</b>An admin checks the payment and approves it; your wallet is credited.</div></div>
</div>

@using (Html.BeginForm("Create", "PaymentRequest", FormMethod.Post, new { id = "prForm" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.BankAccountId, new { id = "BankAccountId" })

    <div class="row g-3">
        <div class="col-lg-5">
            <div class="card h-100">
                <div class="card-header">Pay into</div>
                <div class="card-body">
                    @if (!accounts.Any())
                    {
                        <div class="text-center text-muted py-4">
                            <i class="fas fa-building-columns fa-2x mb-2 d-block opacity-50"></i>
                            No account is open for deposits right now. Please contact your admin.
                        </div>
                    }
                    @foreach (var a in accounts)
                    {
                        bool on = Model.BankAccountId == a.Id || (Model.BankAccountId == null && accounts.Count == 1);
                        <div class="acct @(on ? "on" : "")" data-id="@a.Id" role="button" tabindex="0">
                            <div class="acct-head">
                                <span class="acct-mark"><i class="fas fa-building-columns"></i></span>
                                <div class="flex-grow-1">
                                    <div class="fw-bold">@a.BankName</div>
                                    <div class="small text-muted">@a.HolderName</div>
                                </div>
                                <i class="fas fa-circle-check text-accent @(on ? "" : "d-none")"></i>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(a.AccountNo))
                            {
                                <div class="acct-row"><span>Account no</span><b>@a.AccountNo<button type="button" class="copy" data-copy="@a.AccountNo" title="Copy"><i class="far fa-copy"></i></button></b></div>
                            }
                            @if (!string.IsNullOrWhiteSpace(a.IFSCCode))
                            {
                                <div class="acct-row"><span>IFSC</span><b>@a.IFSCCode<button type="button" class="copy" data-copy="@a.IFSCCode" title="Copy"><i class="far fa-copy"></i></button></b></div>
                            }
                            @if (!string.IsNullOrWhiteSpace(a.UpiAdress))
                            {
                                <div class="acct-row"><span>UPI ID</span><b>@a.UpiAdress<button type="button" class="copy" data-copy="@a.UpiAdress" title="Copy"><i class="far fa-copy"></i></button></b></div>
                            }
                            @if (!string.IsNullOrWhiteSpace(a.BranchName))
                            {
                                <div class="acct-row"><span>Branch</span><b style="font-family:var(--font);">@a.BranchName</b></div>
                            }
                        </div>
                    }
                    @Html.ValidationMessageFor(m => m.BankAccountId, "", new { @class = "text-danger small d-block mt-2" })
                </div>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="card">
                <div class="card-header">Payment details</div>
                <div class="card-body">
                    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger py-2" })

                    <div class="row g-3">
                        <div class="col-md-6">
                            @Html.LabelFor(m => m.Amount, new { @class = "form-label" })
                            <div class="input-group">
                                <span class="input-group-text">&#8377;</span>
                                @Html.TextBoxFor(m => m.Amount, "{0:0.##}", new { @class = "form-control amt-big", type = "number", min = "1", step = "0.01", placeholder = "0", inputmode = "decimal" })
                            </div>
                            @Html.ValidationMessageFor(m => m.Amount, "", new { @class = "text-danger small" })
                        </div>
                        <div class="col-md-6">
                            @Html.LabelFor(m => m.PaymentDate, new { @class = "form-label" })
                            <input type="date" name="PaymentDate" id="PaymentDate" class="form-control" style="height:calc(1.4rem * 1.5 + .75rem + 2px);"
                                   value="@(Model.PaymentDate?.ToString("yyyy-MM-dd"))"
                                   max="@DateTime.Today.ToString("yyyy-MM-dd")" min="@DateTime.Today.AddDays(-30).ToString("yyyy-MM-dd")" />
                            @Html.ValidationMessageFor(m => m.PaymentDate, "", new { @class = "text-danger small" })
                        </div>

                        <div class="col-md-6">
                            @Html.LabelFor(m => m.TrTypeId, new { @class = "form-label" })
                            <select name="TrTypeId" id="TrTypeId" class="form-select">
                                <option value="">Select</option>
                                @foreach (var t in modes)
                                {
                                    <option value="@t.Id" @(Model.TrTypeId == t.Id ? "selected" : "")>@t.Name</option>
                                }
                            </select>
                            @Html.ValidationMessageFor(m => m.TrTypeId, "", new { @class = "text-danger small" })
                        </div>
                        <div class="col-md-6">
                            @Html.LabelFor(m => m.Chequeno, new { @class = "form-label" })
                            @Html.TextBoxFor(m => m.Chequeno, new { @class = "form-control font-monospace", maxlength = "50", placeholder = "e.g. 430712345678", autocomplete = "off" })
                            @Html.ValidationMessageFor(m => m.Chequeno, "", new { @class = "text-danger small" })
                        </div>

                        <div class="col-12">
                            @Html.LabelFor(m => m.PaymentRemark, new { @class = "form-label" })
                            @Html.TextBoxFor(m => m.PaymentRemark, new { @class = "form-control", maxlength = "200", placeholder = "Optional, e.g. paid from HDFC savings" })
                        </div>
                    </div>
                </div>
                <div class="card-footer d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <span class="small text-muted"><i class="fas fa-shield-halved me-1"></i>Each UTR can be used once.</span>
                    <button type="submit" class="btn btn-dark px-4" @(accounts.Any() ? "" : "disabled")><i class="fas fa-paper-plane me-1"></i>Send request</button>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        (function () {
            var hidden = document.getElementById('BankAccountId');
            var cards = document.querySelectorAll('.acct');

            function pick(card) {
                cards.forEach(function (c) {
                    var on = c === card;
                    c.classList.toggle('on', on);
                    c.querySelector('.fa-circle-check').classList.toggle('d-none', !on);
                });
                hidden.value = card.getAttribute('data-id');
            }
            cards.forEach(function (c) {
                c.addEventListener('click', function (e) { if (!e.target.closest('.copy')) pick(c); });
                c.addEventListener('keydown', function (e) { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); pick(c); } });
            });
            var pre = document.querySelector('.acct.on');
            if (pre && !hidden.value) hidden.value = pre.getAttribute('data-id');

            document.querySelectorAll('.copy').forEach(function (b) {
                b.addEventListener('click', function () {
                    if (navigator.clipboard) navigator.clipboard.writeText(b.getAttribute('data-copy'));
                    b.innerHTML = '<i class="fas fa-check"></i>';
                    setTimeout(function () { b.innerHTML = '<i class="far fa-copy"></i>'; }, 1200);
                });
            });

            document.getElementById('prForm').addEventListener('submit', function (e) {
                if (!hidden.value) { e.preventDefault(); alert('Choose the account you paid into.'); return; }
                var btn = this.querySelector('button[type=submit]');
                btn.disabled = true; btn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i>Sending…';
            });
        })();
    </script>
}
