@model VIRENDRA.Models.User

@{
    ViewBag.Title = "Edit User";
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="page-title-box d-sm-flex align-items-center justify-content-between">
                <h4 class="mb-sm-0 font-size-18">Edit User</h4>
                <div class="page-title-right">
                    <ol class="breadcrumb m-0">
                        <li class="breadcrumb-item"><a href="@Url.Action("Index")">Users</a></li>
                        <li class="breadcrumb-item active">Edit</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(model => model.Id)
                @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3" })

                <div class="row g-3">
                    <div class="col-md-6">
                        @Html.LabelFor(model => model.Username, new { @class = "form-label" })
                        @Html.TextBoxFor(model => model.Username, new { @class = "form-control", required = "required" })
                        @Html.ValidationMessageFor(model => model.Username, "", new { @class = "text-danger" })
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="Password">Password</label>
                        <input type="password" name="Password" id="Password" class="form-control" placeholder="Leave blank to keep current password">
                    </div>
                    <div class="col-md-4">
                        @Html.LabelFor(model => model.RoleId, "Role", new { @class = "form-label" })
                        @Html.DropDownListFor(model => model.RoleId, (SelectList)ViewBag.RoleList, "-- Select Role --", new { @class = "form-select" })
                        @Html.ValidationMessageFor(model => model.RoleId, "", new { @class = "text-danger" })
                    </div>
                    <div class="col-md-4">
                        @Html.LabelFor(model => model.PackageId, "Package", new { @class = "form-label" })
                        @Html.DropDownListFor(model => model.PackageId, (SelectList)ViewBag.PackageList, "-- Select Package --", new { @class = "form-select" })
                        @Html.ValidationMessageFor(model => model.PackageId, "", new { @class = "text-danger" })
                    </div>
                    <div class="col-md-4">
                        @Html.LabelFor(model => model.ParentID, new { @class = "form-label" })
                        @Html.TextBoxFor(model => model.ParentID, new { @class = "form-control", type = "number", min = "0" })
                    </div>
                    <div class="col-md-6">
                        @Html.LabelFor(model => model.UserBal, "User Balance", new { @class = "form-label" })
                        @Html.TextBoxFor(model => model.UserBal, new { @class = "form-control", type = "number", step = "0.0001" })
                    </div>
                    <div class="col-md-6">
                        @Html.LabelFor(model => model.UserOutStandingBal, "Outstanding Balance", new { @class = "form-label" })
                        @Html.TextBoxFor(model => model.UserOutStandingBal, new { @class = "form-control", type = "number", step = "0.0001" })
                    </div>
                    <div class="col-md-6">
                        @Html.LabelFor(model => model.LoginIP, "API IP Address", new { @class = "form-label" })
                        @Html.TextBoxFor(model => model.LoginIP, new { @class = "form-control" })
                    </div>
                    <div class="col-md-6">
                        @Html.LabelFor(model => model.UserPin, "User PIN", new { @class = "form-label" })
                        @Html.TextBoxFor(model => model.UserPin, new { @class = "form-control" })
                    </div>
                    <div class="col-md-6">
                        @Html.LabelFor(model => model.CallbackURL, "Callback URL", new { @class = "form-label" })
                        @Html.TextBoxFor(model => model.CallbackURL, new { @class = "form-control" })
                    </div>
                    <div class="col-md-6">
                        @Html.LabelFor(model => model.ComplainCallbackURL, "Complaint Callback URL", new { @class = "form-label" })
                        @Html.TextBoxFor(model => model.ComplainCallbackURL, new { @class = "form-control" })
                    </div>
                    <div class="col-12">
                        <div class="d-flex flex-wrap gap-4">
                            <div class="form-check">
                                @Html.CheckBoxFor(model => model.IsActive, new { @class = "form-check-input" })
                                @Html.LabelFor(model => model.IsActive, new { @class = "form-check-label" })
                            </div>
                            <div class="form-check">
                                @Html.CheckBoxFor(model => model.IsLocked, new { @class = "form-check-input" })
                                @Html.LabelFor(model => model.IsLocked, new { @class = "form-check-label" })
                            </div>
                            <div class="form-check">
                                @Html.CheckBoxFor(model => model.IsComm, new { @class = "form-check-input" })
                                @Html.LabelFor(model => model.IsComm, "Commission Enabled", new { @class = "form-check-label" })
                            </div>
                            <div class="form-check">
                                @Html.CheckBoxFor(model => model.IsOtpCheck, new { @class = "form-check-input" })
                                @Html.LabelFor(model => model.IsOtpCheck, "OTP Check", new { @class = "form-check-label" })
                            </div>
                        </div>
                    </div>
                    <div class="col-12 d-flex gap-2">
                        <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Update</button>
                        <a href="@Url.Action("Index")" class="btn btn-light">Cancel</a>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
