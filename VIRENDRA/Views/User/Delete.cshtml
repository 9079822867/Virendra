@model VIRENDRA.Models.User

@{
    ViewBag.Title = "Delete User";
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="page-title-box d-sm-flex align-items-center justify-content-between">
                <h4 class="mb-sm-0 font-size-18">Delete User</h4>
                <div class="page-title-right">
                    <a href="@Url.Action("Index")" class="btn btn-light">Back</a>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="alert alert-warning">
                Are you sure you want to delete user <strong>@Model.Username</strong>?
            </div>

            <dl class="row mb-4">
                <dt class="col-sm-3">Id</dt>
                <dd class="col-sm-9">@Model.Id</dd>
                <dt class="col-sm-3">Username</dt>
                <dd class="col-sm-9">@Model.Username</dd>
                <dt class="col-sm-3">Balance</dt>
                <dd class="col-sm-9">@((Model.UserBal ?? 0).ToString("0.0000"))</dd>
            </dl>

            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-danger">Delete</button>
                <a href="@Url.Action("Index")" class="btn btn-light">Cancel</a>
            }
        </div>
    </div>
</div>
