@model VIRENDRA.Models.UserProfileViewModel
@{
    ViewBag.Title = "User Profile";
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
    var states = (List<SelectListItem>)ViewBag.States ?? new List<SelectListItem>();
    string initials = string.IsNullOrWhiteSpace(Model.Name)
        ? (Model.Username ?? "U").Substring(0, 1).ToUpper()
        : string.Concat(Model.Name.Split(new[] { ' ' }, StringSplitOptions.RemoveEmptyEntries).Take(2).Select(w => char.ToUpper(w[0])));
}

<div class="container-fluid">

    <div class="row mb-4">
        <div class="col-12">
            <h4 class="mb-1 fw-bold text-dark"><i class="fas fa-user text-primary me-2"></i>User Profile</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0" style="font-size:.82rem;">
                    <li class="breadcrumb-item"><a href="@Url.Action("Dashboard","Home")">Dashboard</a></li>
                    <li class="breadcrumb-item active">User Profile</li>
                </ol>
            </nav>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible mb-4" style="border-radius:10px;">
            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger", style = "border-radius:10px;" })

    <div class="row g-4">

        <!-- ── Account summary ─────────────────────────────── -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm" style="border-radius:14px;overflow:hidden;">
                <div class="card-body text-center px-4 py-4"
                     style="background:linear-gradient(135deg,#667eea 0%,#764ba2 100%);">
                    <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-3 fw-bold text-white"
                         style="width:72px;height:72px;background:rgba(255,255,255,.22);font-size:1.6rem;">
                        @initials
                    </div>
                    <h5 class="text-white fw-bold mb-1">@(string.IsNullOrWhiteSpace(Model.Name) ? Model.Username : Model.Name)</h5>
                    <span class="badge px-3 py-2" style="background:rgba(255,255,255,.22);font-size:.75rem;">@Model.RoleName</span>
                </div>
                <ul class="list-group list-group-flush">
                    <li class="list-group-item d-flex justify-content-between px-4">
                        <span class="text-muted">Username</span><span class="fw-semibold">@Model.Username</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between px-4">
                        <span class="text-muted">User ID</span><span class="fw-semibold">@Model.Id</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between px-4">
                        <span class="text-muted">Package</span><span class="fw-semibold">@(Model.PackageName ?? "-")</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between px-4">
                        <span class="text-muted">Wallet Balance</span>
                        <span class="fw-semibold text-success">&#8377; @Model.Balance.ToString("N2")</span>
                    </li>
                </ul>
                <div class="card-body px-4 pt-2 pb-4">
                    <a href="@Url.Action("ChangePassword","Setting")" class="btn btn-outline-primary w-100">
                        <i class="fas fa-lock me-1"></i>Change Password
                    </a>
                </div>
            </div>
        </div>

        <!-- ── Editable profile ────────────────────────────── -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm" style="border-radius:14px;">
                <div class="card-body px-4 py-4">
                    @using (Html.BeginForm("UserProfile", "Setting", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()

                        <h6 class="fw-bold mb-3"><i class="fas fa-id-card text-primary me-2"></i>Personal Details</h6>
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                @Html.LabelFor(m => m.Name, new { @class = "form-label" }) <span class="text-danger">*</span>
                                @Html.TextBoxFor(m => m.Name, new { @class = "form-control", maxlength = "100" })
                                @Html.ValidationMessageFor(m => m.Name, "", new { @class = "text-danger small" })
                            </div>
                            <div class="col-md-6">
                                @Html.LabelFor(m => m.EmailID, new { @class = "form-label" })
                                @Html.TextBoxFor(m => m.EmailID, new { @class = "form-control", type = "email", maxlength = "100" })
                                @Html.ValidationMessageFor(m => m.EmailID, "", new { @class = "text-danger small" })
                            </div>
                            <div class="col-md-6">
                                @Html.LabelFor(m => m.Mobileno, new { @class = "form-label" })
                                @Html.TextBoxFor(m => m.Mobileno, new { @class = "form-control", maxlength = "10", inputmode = "numeric" })
                                @Html.ValidationMessageFor(m => m.Mobileno, "", new { @class = "text-danger small" })
                            </div>
                            <div class="col-md-6">
                                @Html.LabelFor(m => m.Contactno, new { @class = "form-label" })
                                @Html.TextBoxFor(m => m.Contactno, new { @class = "form-control", maxlength = "15" })
                                @Html.ValidationMessageFor(m => m.Contactno, "", new { @class = "text-danger small" })
                            </div>
                        </div>

                        <h6 class="fw-bold mb-3"><i class="fas fa-store text-primary me-2"></i>Business Details</h6>
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                @Html.LabelFor(m => m.ORGName, new { @class = "form-label" })
                                @Html.TextBoxFor(m => m.ORGName, new { @class = "form-control", maxlength = "150" })
                            </div>
                            <div class="col-md-6">
                                @Html.LabelFor(m => m.GSTNo, new { @class = "form-label" })
                                @Html.TextBoxFor(m => m.GSTNo, new { @class = "form-control text-uppercase", maxlength = "15", placeholder = "e.g. 08ABCDE1234F1Z5" })
                                @Html.ValidationMessageFor(m => m.GSTNo, "", new { @class = "text-danger small" })
                            </div>
                            <div class="col-12">
                                @Html.LabelFor(m => m.GSTADDRESS, new { @class = "form-label" })
                                @Html.TextAreaFor(m => m.GSTADDRESS, 2, 0, new { @class = "form-control", maxlength = "300" })
                            </div>
                        </div>

                        <h6 class="fw-bold mb-3"><i class="fas fa-map-marker-alt text-primary me-2"></i>Address</h6>
                        <div class="row g-3 mb-4">
                            <div class="col-12">
                                @Html.LabelFor(m => m.Address, new { @class = "form-label" })
                                @Html.TextAreaFor(m => m.Address, 2, 0, new { @class = "form-control", maxlength = "300" })
                            </div>
                            <div class="col-md-4">
                                @Html.LabelFor(m => m.StateID, new { @class = "form-label" })
                                @Html.DropDownListFor(m => m.StateID, states, "-- Select State --", new { @class = "form-select" })
                            </div>
                            <div class="col-md-4">
                                @Html.LabelFor(m => m.City, new { @class = "form-label" })
                                @Html.TextBoxFor(m => m.City, new { @class = "form-control", maxlength = "100" })
                            </div>
                            <div class="col-md-4">
                                @Html.LabelFor(m => m.Pincode, new { @class = "form-label" })
                                @Html.TextBoxFor(m => m.Pincode, new { @class = "form-control", maxlength = "6", inputmode = "numeric" })
                                @Html.ValidationMessageFor(m => m.Pincode, "", new { @class = "text-danger small" })
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2">
                            <a href="@Url.Action("Dashboard","Home")" class="btn btn-light">Cancel</a>
                            <button type="submit" class="btn btn-primary px-4">
                                <i class="fas fa-save me-1"></i>Save Profile
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>

    </div>
</div>
