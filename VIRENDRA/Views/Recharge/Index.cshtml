@model VIRENDRA.Models.RechargeFormViewModel
@{
    ViewBag.Title = "Recharge";
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";

    var prepaid  = Model.Operators.Where(o => o.OpTypeId == VIRENDRA.Models.RechargeFormViewModel.TYPE_PREPAID).ToList();
    var postpaid = Model.Operators.Where(o => o.OpTypeId == VIRENDRA.Models.RechargeFormViewModel.TYPE_POSTPAID).ToList();
    var dth      = Model.Operators.Where(o => o.OpTypeId == VIRENDRA.Models.RechargeFormViewModel.TYPE_DTH).ToList();

    // Brand colour helper for operator avatars
    Func<string, string> brandColor = name =>
    {
        if (string.IsNullOrEmpty(name)) return "#5c6bc0";
        string n = name.ToLowerInvariant();
        if (n.Contains("airtel")) return "#e40000";
        if (n.Contains("jio"))    return "#0a2885";
        if (n.Contains("vi") || n.Contains("voda") || n.Contains("idea")) return "#ee2e24";
        if (n.Contains("bsnl"))   return "#f47216";
        if (n.Contains("tata"))   return "#1b5e9b";
        if (n.Contains("dish"))   return "#e5202e";
        if (n.Contains("sun"))    return "#f7941e";
        if (n.Contains("reliance") || n.Contains("big")) return "#7b1fa2";
        return "#5c6bc0";
    };
}

<style>
    .pay-wrap { max-width: 1180px; margin: 0 auto; }

    /* ── Service tabs ───────────────────────────────────────── */
    .svc-tabs { display:flex; gap:.75rem; flex-wrap:wrap; margin-bottom:1.25rem; }
    .svc-tab {
        flex:1; min-width:150px; cursor:pointer; border:2px solid #e8eaf2;
        border-radius:14px; padding:1rem 1.1rem; background:#fff;
        display:flex; align-items:center; gap:.8rem; transition:all .18s;
        box-shadow:0 1px 4px rgba(0,0,0,.03);
    }
    .svc-tab:hover { border-color:#bcdcff; transform:translateY(-2px); }
    .svc-tab.active {
        border-color:#00baf2;
        background:linear-gradient(135deg,#eef9ff 0%,#e9f3ff 100%);
        box-shadow:0 6px 18px rgba(0,186,242,.18);
    }
    .svc-tab .ico {
        width:46px; height:46px; border-radius:12px; flex-shrink:0;
        display:flex; align-items:center; justify-content:center;
        color:#fff; font-size:1.25rem;
    }
    .svc-tab .t-title { font-weight:700; color:#1a1f36; font-size:.98rem; line-height:1.1; }
    .svc-tab .t-sub   { font-size:.74rem; color:#8a90a6; }

    /* ── Recharge card ──────────────────────────────────────── */
    .pay-card { border:none; border-radius:16px; box-shadow:0 4px 24px rgba(0,0,0,.06); overflow:hidden; }
    .pay-card-head {
        background:linear-gradient(135deg,#002970 0%,#00baf2 130%);
        color:#fff; padding:1.1rem 1.4rem;
    }
    .pay-card-head h5 { margin:0; font-weight:700; font-size:1.05rem; }
    .pay-card-head small { opacity:.85; }

    /* ── Operator chips ─────────────────────────────────────── */
    .op-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(118px,1fr)); gap:.6rem; }
    .op-chip {
        cursor:pointer; border:2px solid #eceef5; border-radius:12px;
        padding:.7rem .5rem; text-align:center; transition:all .15s; background:#fff;
    }
    .op-chip:hover { border-color:#bcdcff; background:#f6fbff; }
    .op-chip.active { border-color:#00baf2; background:#eef9ff; box-shadow:0 3px 10px rgba(0,186,242,.18); }
    .op-avatar {
        width:42px; height:42px; border-radius:50%; margin:0 auto .4rem;
        display:flex; align-items:center; justify-content:center;
        color:#fff; font-weight:700; font-size:1.05rem;
    }
    .op-name { font-size:.78rem; font-weight:600; color:#3a3f55; line-height:1.15; }

    .field-label { font-weight:600; font-size:.84rem; color:#3a3f55; margin-bottom:.3rem; }
    .amt-input { font-size:1.5rem; font-weight:700; }
    .amt-input::-webkit-outer-spin-button,
    .amt-input::-webkit-inner-spin-button { -webkit-appearance:none; margin:0; }
    .quick-amt { display:flex; gap:.5rem; flex-wrap:wrap; margin-top:.5rem; }
    .quick-amt span {
        cursor:pointer; border:1px solid #d7dbea; border-radius:20px;
        padding:.25rem .85rem; font-size:.82rem; font-weight:600; color:#00569c; background:#f3f9ff;
    }
    .quick-amt span:hover { background:#e1f1ff; }
    .btn-pay {
        background:linear-gradient(135deg,#002970 0%,#00baf2 130%); border:none;
        color:#fff; font-weight:700; border-radius:10px; padding:.7rem 1rem; width:100%;
    }
    .btn-pay:hover { color:#fff; opacity:.94; }
    .empty-ops { text-align:center; color:#9aa0b4; padding:2.2rem 1rem; }
</style>

<div class="container-fluid pay-wrap">

    <!-- Title -->
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
        <div>
            <h4 class="mb-1 fw-bold text-dark"><i class="fas fa-bolt text-info me-2"></i>Recharge &amp; Bill Pay</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0" style="font-size:.82rem;">
                    <li class="breadcrumb-item"><a href="@Url.Action("Dashboard","Home")">Dashboard</a></li>
                    <li class="breadcrumb-item active">Recharge</li>
                </ol>
            </nav>
        </div>
    </div>

    <!-- Result alert -->
    @if (Model.Result != null)
    {
        var alertClass = Model.Result.Success ? "alert-success" : (Model.Result.IsPending ? "alert-warning" : "alert-danger");
        <div class="alert @alertClass alert-dismissible fade show" role="alert" style="border-radius:12px;">
            <strong>@Model.Result.Status:</strong> @Model.Result.Message
            @if (!string.IsNullOrEmpty(Model.Result.ApiTxnId))
            { <span> | API Txn: <strong>@Model.Result.ApiTxnId</strong></span> }
            @if (!string.IsNullOrEmpty(Model.Result.UserTxnId))
            { <span> | Ref: <strong>@Model.Result.UserTxnId</strong></span> }
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Service tabs -->
    <div class="svc-tabs">
        <div class="svc-tab active" data-type="1">
            <div class="ico" style="background:linear-gradient(135deg,#00baf2,#0098d4);"><i class="fas fa-mobile-alt"></i></div>
            <div><div class="t-title">Prepaid</div><div class="t-sub">Mobile recharge</div></div>
        </div>
        <div class="svc-tab" data-type="2">
            <div class="ico" style="background:linear-gradient(135deg,#7b53e0,#5e35b1);"><i class="fas fa-file-invoice"></i></div>
            <div><div class="t-title">Postpaid</div><div class="t-sub">Bill payment</div></div>
        </div>
        <div class="svc-tab" data-type="3">
            <div class="ico" style="background:linear-gradient(135deg,#ff8a00,#e35100);"><i class="fas fa-satellite-dish"></i></div>
            <div><div class="t-title">DTH</div><div class="t-sub">TV recharge</div></div>
        </div>
    </div>

    <div class="row g-3">
        <!-- Recharge form -->
        <div class="col-lg-7">
            <div class="card pay-card">
                <div class="pay-card-head">
                    <h5><i class="fas fa-bolt me-2"></i><span id="svcTitle">Prepaid Recharge</span></h5>
                    <small id="svcSub">Select operator and enter mobile number</small>
                </div>
                <div class="card-body p-4">
                    @using (Html.BeginForm("Index", "Recharge", FormMethod.Post, new { id = "rechargeForm" }))
                    {
                        @Html.AntiForgeryToken()
                        @Html.ValidationSummary(true, "", new { @class = "text-danger mb-2" })

                        <input type="hidden" name="OperatorId" id="OperatorId" value="@Model.Request.OperatorId" />
                        <input type="hidden" name="RCTypeId"   id="RCTypeId"   value="1" />

                        <!-- Operator picker -->
                        <div class="mb-3">
                            <div class="field-label">Select Operator <span class="text-danger">*</span></div>

                            @foreach (var grp in new[] {
                                new { Type = 1, Ops = prepaid  },
                                new { Type = 2, Ops = postpaid },
                                new { Type = 3, Ops = dth      } })
                            {
                                <div class="op-pane" data-pane="@grp.Type" style="@(grp.Type == 1 ? "" : "display:none;")">
                                    @if (grp.Ops.Count == 0)
                                    {
                                        <div class="empty-ops">
                                            <i class="fas fa-inbox fa-2x mb-2 d-block"></i>
                                            No operators configured for this service yet.
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="op-grid">
                                            @foreach (var op in grp.Ops)
                                            {
                                                var c = brandColor(op.Name);
                                                var initial = string.IsNullOrEmpty(op.Name) ? "?" : op.Name.Substring(0, 1).ToUpper();
                                                <div class="op-chip" data-opid="@op.Id" data-opname="@op.Name" data-opcode="@op.OperatorCode">
                                                    <div class="op-avatar" style="background:@c;">@initial</div>
                                                    <div class="op-name">@op.Name</div>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="field-label" id="numLabel">Mobile Number <span class="text-danger">*</span></div>
                                @Html.TextBox("CustomerNo", Model.Request.CustomerNo, new {
                                    @class = "form-control form-control-lg", id = "CustomerNo",
                                    maxlength = "15", placeholder = "Enter number", required = "required",
                                    autocomplete = "off" })
                                <div id="opDetect" class="small mt-1" style="min-height:18px;"></div>
                            </div>

                            <div class="col-md-6" id="circleWrap">
                                <div class="field-label">Circle</div>
                                @Html.DropDownList("CircleId", Model.CircleList,
                                    "-- Select Circle --", new { @class = "form-select form-select-lg", id = "CircleId" })
                            </div>

                            <div class="col-md-6">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div class="field-label">Amount <span class="text-danger">*</span></div>
                                    <a href="javascript:void(0);" id="btnBrowsePlans" class="small fw-semibold text-decoration-none" style="color:#00569c;">
                                        <i class="fas fa-th-list me-1"></i>Browse Plans
                                    </a>
                                </div>
                                <div class="input-group input-group-lg">
                                    <span class="input-group-text"><i class="fa fa-rupee-sign"></i></span>
                                    @Html.TextBox("Amount", Model.Request.Amount > 0 ? Model.Request.Amount.ToString("0") : "", new {
                                        @class = "form-control amt-input", id = "Amount", type = "number",
                                        min = "1", step = "1", placeholder = "0", required = "required" })
                                </div>
                            </div>

                            <div class="col-12">
                                <button type="submit" class="btn btn-pay btn-lg">
                                    <i class="fas fa-paper-plane me-1"></i> Proceed to Recharge
                                </button>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Recent recharges -->
        <div class="col-lg-5">
            <div class="card pay-card">
                <div class="pay-card-head" style="background:linear-gradient(135deg,#3a3f55 0%,#5c6bc0 130%);">
                    <h5><i class="fas fa-history me-2"></i>Recent Recharges</h5>
                    <small>Your last transactions</small>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0 align-middle" style="font-size:.86rem;">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-3">Number</th>
                                    <th>Operator</th>
                                    <th>Amount</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.RecentRecharges != null && Model.RecentRecharges.Count > 0)
                                {
                                    foreach (var r in Model.RecentRecharges)
                                    {
                                        <tr>
                                            <td class="ps-3 fw-semibold">@r.Number</td>
                                            <td>@r.Operator</td>
                                            <td><i class="fa fa-rupee-sign"></i> @r.Amount.ToString("0.##")</td>
                                            <td>
                                                <span class="badge @(r.Status == "Success" ? "bg-success" : r.Status == "Pending" ? "bg-warning text-dark" : "bg-danger")">
                                                    @r.Status
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr><td colspan="4" class="text-center text-muted py-4">No recent recharges</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ── Browse Plans Modal ─────────────────────────────────────── -->
<div class="modal fade" id="plansModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable modal-dialog-centered">
        <div class="modal-content" style="border:none;border-radius:16px;overflow:hidden;">
            <div class="modal-header text-white" style="background:linear-gradient(135deg,#002970 0%,#00baf2 130%);">
                <h5 class="modal-title"><i class="fas fa-th-list me-2"></i>Browse Plans <span id="plansOpName" class="badge bg-light text-dark ms-1"></span></h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-0">
                <!-- category tabs -->
                <ul class="nav nav-pills flex-nowrap overflow-auto p-3 pb-2 mb-0" id="planTabs" style="gap:.4rem;"></ul>
                <!-- plan list -->
                <div id="planList" class="px-3 pb-3"></div>
                <div id="plansLoading" class="text-center text-muted py-5 d-none">
                    <i class="fas fa-spinner fa-spin fa-2x mb-2 d-block"></i>Loading plans...
                </div>
                <div id="plansEmpty" class="text-center text-muted py-5 d-none">
                    <i class="fas fa-inbox fa-2x mb-2 d-block"></i><span></span>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    #planTabs .nav-link { font-size:.82rem; font-weight:600; padding:.35rem .9rem; border-radius:20px; color:#3a3f55; background:#f1f3f9; white-space:nowrap; }
    #planTabs .nav-link.active { background:#00baf2; color:#fff; }
    .plan-card { border:1px solid #eceef5; border-radius:12px; padding:.85rem 1rem; margin-bottom:.6rem; transition:all .15s; }
    .plan-card:hover { border-color:#bcdcff; box-shadow:0 3px 12px rgba(0,186,242,.12); }
    .plan-amt { font-size:1.3rem; font-weight:800; color:#002970; }
    .plan-chip { display:inline-block; font-size:.72rem; font-weight:600; color:#00569c; background:#eef6ff; border-radius:14px; padding:.12rem .55rem; margin:.1rem .25rem .1rem 0; }
    .plan-ott { display:inline-block; font-size:.7rem; font-weight:600; color:#7b1fa2; background:#f5edfb; border-radius:14px; padding:.12rem .55rem; margin:.1rem .25rem 0 0; }
    .plan-benefit { font-size:.78rem; color:#5a6072; margin-top:.35rem; line-height:1.35; }
    .btn-plan-select { font-size:.78rem; font-weight:700; border-radius:8px; padding:.3rem .9rem; }
</style>

@section Scripts {
    <script>
        $(function () {
            var svcMeta = {
                '1': { title: 'Prepaid Recharge',  sub: 'Select operator and enter mobile number', numLabel: 'Mobile Number', showCircle: true,  showPlans: true  },
                '2': { title: 'Postpaid Bill Pay', sub: 'Select operator and enter mobile number', numLabel: 'Mobile Number', showCircle: false, showPlans: false },
                '3': { title: 'DTH Recharge',      sub: 'Select operator and enter subscriber ID', numLabel: 'Subscriber / VC Number', showCircle: false, showPlans: false }
            };

            // ── Tab switching ──────────────────────────────
            $('.svc-tab').on('click', function () {
                var type = $(this).data('type').toString();
                $('.svc-tab').removeClass('active');
                $(this).addClass('active');

                // Show only the matching operator pane
                $('.op-pane').hide().filter('[data-pane="' + type + '"]').show();

                // Clear current operator selection
                $('.op-chip').removeClass('active');
                $('#OperatorId').val('');

                var m = svcMeta[type];
                $('#svcTitle').text(m.title);
                $('#svcSub').text(m.sub);
                $('#numLabel').html(m.numLabel + ' <span class="text-danger">*</span>');
                $('#circleWrap').toggle(m.showCircle);
                $('#btnBrowsePlans').toggle(m.showPlans);

                // Reset detection so re-entering the number re-detects for this service
                $('#opDetect').html('');
                lastLookup = '';
            });

            // ── Operator selection ─────────────────────────
            $(document).on('click', '.op-chip', function () {
                $('.op-chip').removeClass('active');
                $(this).addClass('active');
                $('#OperatorId').val($(this).data('opid'));
            });

            // Pre-select existing operator (e.g. after a failed post-back)
            var preOp = $('#OperatorId').val();
            if (preOp && preOp !== '0') {
                $('.op-chip[data-opid="' + preOp + '"]').addClass('active');
            }

            // ── Quick amount chips ─────────────────────────
            $('.quick-amt span').on('click', function () {
                $('#Amount').val($(this).text()).focus();
            });

            // ── Auto-detect operator/circle from 10-digit number ───
            var lastLookup = '';
            function currentType() { return $('.svc-tab.active').data('type').toString(); }

            $('#CustomerNo').on('input', function () {
                var num = ($(this).val() || '').replace(/\D/g, '');
                var type = currentType();

                // Only for Prepaid (1) and Postpaid (2), exactly 10 digits
                if (type === '3' || num.length !== 10) {
                    if (num.length < 10) { $('#opDetect').html(''); lastLookup = ''; }
                    return;
                }
                if (num === lastLookup) return;     // avoid duplicate calls
                lastLookup = num;

                $('#opDetect').html('<span class="text-muted"><i class="fas fa-spinner fa-spin me-1"></i>Detecting operator...</span>');

                $.getJSON('@Url.Action("FetchOperator", "Recharge")', { number: num })
                    .done(function (res) {
                        if (!res.success) {
                            $('#opDetect').html('<span class="text-warning"><i class="fas fa-exclamation-circle me-1"></i>' + res.message + '</span>');
                            return;
                        }

                        var label = '<i class="fas fa-check-circle me-1"></i>Detected: <strong>' + res.operatorName + '</strong>';
                        if (res.circleName) { label += ' &middot; ' + res.circleName; }

                        // Match operator chip by NAME (contains), within the visible pane
                        var detected = (res.operatorName || '').toLowerCase().trim();
                        var $match = null;
                        $('.op-pane:visible .op-chip').each(function () {
                            var chipName = ($(this).data('opname') || '').toString().toLowerCase().trim();
                            if (!chipName || !detected) return;
                            // either name contains the other (e.g. "Jio" <-> "JIO 4G")
                            if (chipName.indexOf(detected) !== -1 || detected.indexOf(chipName) !== -1) {
                                $match = $(this);
                                return false; // break
                            }
                        });

                        if ($match) {
                            $('.op-chip').removeClass('active');
                            $match.addClass('active');
                            $('#OperatorId').val($match.data('opid'));
                        } else {
                            label += ' <span class="text-muted">(not in this list)</span>';
                        }

                        // Auto-select circle
                        if (res.circleId && res.circleId !== 0) {
                            $('#CircleId').val(res.circleId);
                        }

                        $('#opDetect').html('<span class="text-success">' + label + '</span>');
                    })
                    .fail(function () {
                        $('#opDetect').html('<span class="text-danger"><i class="fas fa-times-circle me-1"></i>Lookup failed.</span>');
                    });
            });

            // ── Browse Plans ───────────────────────────────
            function escapeHtml(s) {
                return (s || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
            }

            $('#btnBrowsePlans').on('click', function () {
                var $op = $('.op-pane:visible .op-chip.active');
                if (!$op.length) { alert('Please select an operator first.'); return; }

                var opName  = $op.data('opname');
                var opCode  = $op.data('opcode');
                var circleId = parseInt($('#CircleId').val()) || 0;

                $('#plansOpName').text(opName);
                $('#planTabs').empty();
                $('#planList').empty();
                $('#plansEmpty').addClass('d-none');
                $('#plansLoading').removeClass('d-none');

                var modal = new bootstrap.Modal(document.getElementById('plansModal'));
                modal.show();

                $.getJSON('@Url.Action("BrowsePlans", "Recharge")',
                    { operatorName: opName, opCode: opCode, circleId: circleId })
                    .done(function (res) {
                        $('#plansLoading').addClass('d-none');
                        if (!res.success || !res.categories || !res.categories.length) {
                            $('#plansEmpty').removeClass('d-none').find('span').text(res.message || 'No plans found.');
                            return;
                        }
                        renderPlans(res.categories);
                    })
                    .fail(function () {
                        $('#plansLoading').addClass('d-none');
                        $('#plansEmpty').removeClass('d-none').find('span').text('Failed to load plans.');
                    });
            });

            function renderPlans(categories) {
                var $tabs = $('#planTabs').empty();
                var $list = $('#planList').empty();

                categories.forEach(function (cat, idx) {
                    var tabId = 'pcat' + idx;
                    $tabs.append(
                        '<li class="nav-item"><a class="nav-link' + (idx === 0 ? ' active' : '') +
                        '" data-target="' + tabId + '" href="javascript:void(0);">' +
                        escapeHtml(cat.name) + ' (' + cat.plans.length + ')</a></li>');

                    var html = '<div class="plan-pane" id="' + tabId + '"' + (idx === 0 ? '' : ' style="display:none;"') + '>';
                    cat.plans.forEach(function (p) {
                        var chips = '';
                        if (p.validity) chips += '<span class="plan-chip"><i class="far fa-clock me-1"></i>' + escapeHtml(p.validity) + '</span>';
                        if (p.data)     chips += '<span class="plan-chip">' + escapeHtml(p.data) + ' Data</span>';
                        if (p.sms)      chips += '<span class="plan-chip">' + escapeHtml(p.sms) + ' SMS</span>';
                        if (p.talktime && p.talktime > 0) chips += '<span class="plan-chip">TT &#8377;' + p.talktime + '</span>';

                        var ott = '';
                        (p.subscriptions || []).forEach(function (s) { ott += '<span class="plan-ott"><i class="fas fa-play-circle me-1"></i>' + escapeHtml(s) + '</span>'; });

                        html +=
                            '<div class="plan-card d-flex justify-content-between align-items-start">' +
                                '<div class="pe-2">' +
                                    '<div class="plan-amt">&#8377;' + p.amount + '</div>' +
                                    '<div>' + chips + '</div>' +
                                    (ott ? '<div>' + ott + '</div>' : '') +
                                    '<div class="plan-benefit">' + escapeHtml(p.benefit) + '</div>' +
                                '</div>' +
                                '<button type="button" class="btn btn-outline-primary btn-plan-select flex-shrink-0" data-amt="' + p.amount + '">Select</button>' +
                            '</div>';
                    });
                    html += '</div>';
                    $list.append(html);
                });

                // tab switching
                $('#planTabs .nav-link').on('click', function () {
                    $('#planTabs .nav-link').removeClass('active');
                    $(this).addClass('active');
                    $('.plan-pane').hide();
                    $('#' + $(this).data('target')).show();
                });

                // select a plan -> set amount and close
                $('#planList').on('click', '.btn-plan-select', function () {
                    $('#Amount').val($(this).data('amt'));
                    bootstrap.Modal.getInstance(document.getElementById('plansModal')).hide();
                    $('#Amount').focus();
                });
            }

            // ── Validate operator chosen before submit ─────
            $('#rechargeForm').on('submit', function (e) {
                if (!$('#OperatorId').val() || $('#OperatorId').val() === '0') {
                    e.preventDefault();
                    alert('Please select an operator.');
                }
            });
        });
    </script>
}
