@model VIRENDRA.Models.RechargeFormViewModel

@{
    ViewBag.Title = "Recharge";
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="page-title-box d-sm-flex align-items-center justify-content-between">
                <h4 class="mb-sm-0 font-size-18">Recharge</h4>
                <div class="page-title-right">
                    <ol class="breadcrumb m-0">
                        <li class="breadcrumb-item"><a href="@Url.Action("Dashboard", "Home")">Dashboard</a></li>
                        <li class="breadcrumb-item active">Recharge</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>

    @if (Model.Result != null)
    {
        var alertClass = Model.Result.Success ? "alert-success" : (Model.Result.IsPending ? "alert-warning" : "alert-danger");
        <div class="alert @alertClass alert-dismissible fade show" role="alert">
            <strong>@Model.Result.Status:</strong> @Model.Result.Message
            @if (!string.IsNullOrEmpty(Model.Result.ApiTxnId))
            {
                <span> | API Txn: <strong>@Model.Result.ApiTxnId</strong></span>
            }
            @if (!string.IsNullOrEmpty(Model.Result.UserTxnId))
            {
                <span> | Ref: <strong>@Model.Result.UserTxnId</strong></span>
            }
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row">
        <div class="col-lg-7">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">New Recharge</h5>
                </div>
                <div class="card-body">
                    @using (Html.BeginForm("Index", "Recharge", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        @Html.ValidationSummary(true, "", new { @class = "text-danger mb-2" })

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Operator <span class="text-danger">*</span></label>
                                @Html.DropDownListFor(m => m.Request.OperatorId,
                                    Model.OperatorList,
                                    "-- Select Operator --",
                                    new { @class = "form-select", required = "required" })
                                @Html.ValidationMessageFor(m => m.Request.OperatorId, "", new { @class = "text-danger small" })
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Circle</label>
                                @Html.DropDownListFor(m => m.Request.CircleId,
                                    Model.CircleList,
                                    "-- Select Circle --",
                                    new { @class = "form-select" })
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Mobile / Customer Number <span class="text-danger">*</span></label>
                                @Html.TextBoxFor(m => m.Request.CustomerNo,
                                    new { @class = "form-control", maxlength = "12", placeholder = "Enter number", required = "required" })
                                @Html.ValidationMessageFor(m => m.Request.CustomerNo, "", new { @class = "text-danger small" })
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Amount <span class="text-danger">*</span></label>
                                @Html.TextBoxFor(m => m.Request.Amount,
                                    new { @class = "form-control", type = "number", min = "1", step = "1", placeholder = "Enter amount", required = "required" })
                                @Html.ValidationMessageFor(m => m.Request.Amount, "", new { @class = "text-danger small" })
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Reference ID <small class="text-muted">(optional — auto-generated)</small></label>
                                @Html.TextBoxFor(m => m.Request.UserTxnId,
                                    new { @class = "form-control", placeholder = "Leave blank for auto" })
                            </div>
                            <div class="col-12">
                                <button type="submit" class="btn btn-primary">
                                    <i class="fas fa-paper-plane"></i> Submit Recharge
                                </button>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Recent Recharges</h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead>
                                <tr>
                                    <th>Number</th>
                                    <th>Operator</th>
                                    <th>Amount</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.RecentRecharges != null && Model.RecentRecharges.Count > 0)
                                {
                                    foreach (var r in Model.RecentRecharges)
                                    {
                                        <tr>
                                            <td>@r.Number</td>
                                            <td>@r.Operator</td>
                                            <td><i class="fa fa-rupee-sign"></i> @r.Amount.ToString("0.##")</td>
                                            <td>
                                                <span class="badge @(r.Status == "Success" ? "bg-success" : r.Status == "Pending" ? "bg-warning text-dark" : "bg-danger")">
                                                    @r.Status
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr><td colspan="4" class="text-center text-muted py-3">No recent recharges</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
