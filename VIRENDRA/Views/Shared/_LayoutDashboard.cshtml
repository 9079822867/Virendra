<!DOCTYPE html>
@functions {
    // One menu definition, drawn either as the left sidebar or as the top bar.
    public class NavItem
    {
        public string Text   { get; set; }
        public string Icon   { get; set; }
        public string Url    { get; set; }
        public bool   Active { get; set; }
    }

    public class NavGroup
    {
        public string Title       { get; set; }   // null = loose top-level links
        public string Icon        { get; set; }
        public bool   Collapsible { get; set; }   // sidebar draws it as a fold-out
        public List<NavItem> Items { get; set; } = new List<NavItem>();
        public bool   Active => Items.Any(i => i.Active);
    }
}
@{
    var currentController = (ViewContext.RouteData.Values["controller"] ?? "").ToString();
    var currentAction = (ViewContext.RouteData.Values["action"] ?? "").ToString();
    byte roleId = (byte)(Session["RoleId"] ?? (byte)0);
    string uname = (Session["Username"] ?? "User").ToString();
    decimal bal = (decimal)(Session["UserBal"] ?? 0m);
    decimal outstanding = (decimal)(Session["UserOutstanding"] ?? 0m);

    bool isSuperAdmin = roleId == 1;
    bool isAdmin = roleId == 2;
    bool isApiUser = roleId == 3;
    bool isRetailer = roleId == 4;
    bool isAdminRole = isSuperAdmin || isAdmin;

    string roleName = isSuperAdmin ? "Super Admin"
                    : isAdmin ? "Admin"
                    : isApiUser ? "API User"
                    : "Retailer";

    // Non-admin users without approved KYC only see the KYC page (KycGateAttribute)
    bool kycLocked = !isAdminRole && !(Session["KycApproved"] is bool kycOk && kycOk);

    Func<string, string, bool> on = (c, a) =>
        string.Equals(currentController, c, StringComparison.OrdinalIgnoreCase) &&
        (a == null || string.Equals(currentAction, a, StringComparison.OrdinalIgnoreCase));

    string initials = string.IsNullOrEmpty(uname) ? "U" : uname.Substring(0, 1).ToUpperInvariant();

    // Menu layout: the user's own choice (cookie) wins, else Web.config <add key="MenuLayout" value="side|top" />
    string layoutPref = Request.Cookies["menu_layout"]?.Value;
    if (layoutPref != "side" && layoutPref != "top")
    {
        layoutPref = (System.Configuration.ConfigurationManager.AppSettings["MenuLayout"] ?? "side").Trim().ToLowerInvariant();
    }
    bool topMenu = layoutPref == "top";

    // ── Menu (role rules live here only) ────────────────────────────────
    var menu = new List<NavGroup>();
    Func<string, string, string, string, bool, NavItem> item = (text, icon, action, controller, active) =>
        new NavItem { Text = text, Icon = icon, Url = Url.Action(action, controller), Active = active };

    if (kycLocked)
    {
        menu.Add(new NavGroup { Items = { item("Complete KYC", "fa-id-card", "Index", "Kyc", true) } });
    }
    else
    {
        var main = new NavGroup();
        main.Items.Add(item("Dashboard", "fa-gauge-high", "Dashboard", "Home", on("Home", null)));
        if (isRetailer)
        {
            main.Items.Add(item("New Recharge", "fa-mobile-screen", "Index", "Recharge", on("Recharge", null)));
        }
        menu.Add(main);

        var reports = new NavGroup { Title = "Reports", Icon = "fa-chart-line" };
        reports.Items.Add(item("Recharge History", "fa-clock-rotate-left", "RechargeHistory", "Transaction", on("Transaction", "RechargeHistory")));
        reports.Items.Add(item("Ledger", "fa-receipt", "TransactionHistory", "Transaction", on("Transaction", "TransactionHistory")));
        reports.Items.Add(item("Outstanding", "fa-scale-unbalanced", "OutStandingReport", "Transaction", on("Transaction", "OutStandingReport")));
        reports.Items.Add(item("Complaints", "fa-flag", "ComplaintReport", "Transaction", on("Transaction", "ComplaintReport")));
        if (isAdminRole)
        {
            reports.Items.Add(item("Operator Summary", "fa-chart-column", "OperatorwiseReport", "Reports", on("Reports", null)));
        }
        menu.Add(reports);

        if (isAdminRole)
        {
            menu.Add(new NavGroup
            {
                Title = "Money", Icon = "fa-wallet",
                Items =
                {
                    item("Payment Requests", "fa-inbox", "Index", "Wallet", on("Wallet", "Index")),
                    item("Add Money", "fa-circle-plus", "AddMoney", "Wallet", on("Wallet", "AddMoney")),
                    item("Vendor Wallet", "fa-vault", "Index", "ApiWallet", on("ApiWallet", null)),
                    item("Bank Accounts", "fa-building-columns", "Index", "BankAccount", on("BankAccount", null))
                }
            });
            menu.Add(new NavGroup
            {
                Title = "Manage", Icon = "fa-sliders",
                Items =
                {
                    item("Users", "fa-users", "Index", "User", on("User", null)),
                    item("KYC Approval", "fa-user-check", "Index", "KycAdmin", on("KycAdmin", null)),
                    item("Packages", "fa-layer-group", "Index", "Package", on("Package", null) || on("PackageComm", "Index")),
                    item("Operators", "fa-tower-cell", "Index", "Operator", on("Operator", null)),
                    item("Vendors", "fa-plug", "Index", "Vendor", on("Vendor", null))
                }
            });
            menu.Add(new NavGroup
            {
                Title = "Routing", Icon = "fa-route", Collapsible = true,
                Items =
                {
                    item("Route Settings", "fa-route", "Index", "CommonRouting", on("CommonRouting", null)),
                    item("Switch Settings", "fa-shuffle", "OperatorSwitch", "Switch", on("Switch", null)),
                    item("Services", "fa-mobile", "Index", "Services", on("Services", null))
                }
            });
        }

        if (isApiUser || isRetailer)
        {
            menu.Add(new NavGroup
            {
                Title = "Money", Icon = "fa-wallet",
                Items =
                {
                    item("Request Top-up", "fa-circle-plus", "Create", "PaymentRequest", on("PaymentRequest", "Create")),
                    item("My Requests", "fa-list-check", "Index", "PaymentRequest", on("PaymentRequest", "Index"))
                }
            });
        }

        if (isSuperAdmin || isApiUser)
        {
            menu.Add(new NavGroup
            {
                Title = "Developer", Icon = "fa-code",
                Items =
                {
                    item("API Keys", "fa-key", "Index", "ApiSettings", on("ApiSettings", null)),
                    item("API Docs", "fa-book", "Index", "ApiDocument", on("ApiDocument", null))
                }
            });
        }
    }
}
<html lang="en">
<head>
    <meta charset="utf-8">
    <title>@(ViewBag.Title != null ? ViewBag.Title + " · " : "")Express Recharge</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    @Html.Partial("_ThemeInit")

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet">

    <link href="~/Content/css/bootstrap.min.css" rel="stylesheet">
    <!-- Icon fonts (pages use all three sets) -->
    <link href="~/Content/css/bootstrap-icons.css" rel="stylesheet">
    <link href="~/Content/css/boxicons.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">

    <link href="~/Content/css/app-theme.css?v=5" rel="stylesheet">
</head>
<body>
<div class="app @(topMenu ? "menu-top" : "menu-side")" id="app">

    <!-- ═══════════ Sidebar (side mode; the mobile drawer in both modes) ═══════════ -->
    <aside class="app-side" aria-label="Main menu">
        <a class="app-brand" href="@Url.Action("Dashboard","Home")">
            <span class="app-brand-mark"><i class="fas fa-bolt"></i></span>
            <span>EXPRESS<small>Recharge console</small></span>
        </a>

        <nav class="app-nav">
            @foreach (var g in menu)
            {
                if (g.Title == null)
                {
                    foreach (var it in g.Items)
                    {
                        <a class="app-link @(it.Active ? "active" : "")" href="@it.Url"><i class="fas @it.Icon"></i>@it.Text</a>
                    }
                }
                else if (g.Collapsible)
                {
                    <details class="app-group" @(g.Active ? "open" : "")>
                        <summary><i class="fas @g.Icon lead-ic"></i>@g.Title<i class="fas fa-chevron-right chev"></i></summary>
                        <div class="app-sub">
                            @foreach (var it in g.Items)
                            {
                                <a class="app-link @(it.Active ? "active" : "")" href="@it.Url">@it.Text</a>
                            }
                        </div>
                    </details>
                }
                else
                {
                    <div class="app-nav-label">@g.Title</div>
                    foreach (var it in g.Items)
                    {
                        <a class="app-link @(it.Active ? "active" : "")" href="@it.Url"><i class="fas @it.Icon"></i>@it.Text</a>
                    }
                }
            }
        </nav>

        <div class="app-side-foot">
            Signed in as <strong class="text-white">@uname</strong><br>@roleName
        </div>
    </aside>
    <div class="app-scrim" id="appScrim"></div>

    <!-- ═══════════ Main ═══════════ -->
    <div class="app-main">
        <header class="app-top">
            <button type="button" class="app-burger" id="appBurger" aria-label="Open menu"><i class="fas fa-bars"></i></button>

            <a class="app-top-brand" href="@Url.Action("Dashboard","Home")">
                <span class="app-brand-mark"><i class="fas fa-bolt"></i></span>EXPRESS
            </a>

            <h1 class="app-top-title">@(ViewBag.Title ?? "Dashboard")</h1>

            <!-- Top-bar menu (top mode, desktop) -->
            <nav class="app-topnav" aria-label="Main menu">
                @foreach (var g in menu)
                {
                    if (g.Title == null)
                    {
                        foreach (var it in g.Items)
                        {
                            <a class="app-toplink @(it.Active ? "active" : "")" href="@it.Url"><i class="fas @it.Icon"></i>@it.Text</a>
                        }
                    }
                    else
                    {
                        <div class="dropdown">
                            <a href="#" class="app-toplink dropdown-toggle @(g.Active ? "active" : "")" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="fas @g.Icon"></i>@g.Title
                            </a>
                            <ul class="dropdown-menu">
                                @foreach (var it in g.Items)
                                {
                                    <li><a class="dropdown-item @(it.Active ? "active" : "")" href="@it.Url"><i class="fas @it.Icon"></i>@it.Text</a></li>
                                }
                            </ul>
                        </div>
                    }
                }
            </nav>

            <div class="dropdown">
                <button type="button" class="app-theme-btn" id="ddTheme" data-bs-toggle="dropdown" aria-expanded="false" title="Theme" aria-label="Change theme">
                    <i class="fas fa-circle-half-stroke" id="themeIcon"></i>
                </button>
                <ul class="dropdown-menu dropdown-menu-end app-theme-menu" aria-labelledby="ddTheme" style="min-width:170px;">
                    <li><a class="dropdown-item" href="#" data-theme-set="light"><i class="fas fa-sun"></i>Light<i class="fas fa-check"></i></a></li>
                    <li><a class="dropdown-item" href="#" data-theme-set="dark"><i class="fas fa-moon"></i>Dark<i class="fas fa-check"></i></a></li>
                    <li><a class="dropdown-item" href="#" data-theme-set="system"><i class="fas fa-desktop"></i>Same as device<i class="fas fa-check"></i></a></li>
                </ul>
            </div>

            <div class="app-money">
                <span class="app-balance" title="Wallet balance">
                    <i class="fas fa-wallet"></i>
                    <span><small>Balance</small>&#8377; @bal.ToString("N2")</span>
                </span>
                <a class="app-balance app-outstanding @(outstanding > 0 ? "due" : "")" href="@Url.Action("OutStandingReport","Transaction")" title="Outstanding (credit) amount — open report">
                    <i class="fas fa-scale-unbalanced"></i>
                    <span><small>Outstanding</small>&#8377; @outstanding.ToString("N2")</span>
                </a>
            </div>

            <div class="dropdown">
                <a href="#" class="app-user" id="ddUser" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                    <span class="app-avatar">@initials</span>
                    <span class="app-user-meta">
                        <span class="app-user-name d-block">@uname</span>
                        <span class="app-user-role">@roleName</span>
                    </span>
                    <i class="fas fa-chevron-down text-muted" style="font-size:.65rem;"></i>
                </a>
                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="ddUser" style="min-width:230px;">
                    <li><a class="dropdown-item @(on("Setting","UserProfile") ? "active" : "")" href="@Url.Action("UserProfile","Setting")"><i class="fas fa-user"></i>My profile</a></li>
                    <li><a class="dropdown-item @(on("PackageComm","MyCommission") ? "active" : "")" href="@Url.Action("MyCommission","PackageComm")"><i class="fas fa-percent"></i>My commission</a></li>
                    @if (!isAdminRole)
                    {
                        <li>
                            <a class="dropdown-item @(on("Kyc", null) ? "active" : "")" href="@Url.Action("Index","Kyc")">
                                <i class="fas fa-id-card"></i>KYC
                                <span class="badge ms-auto @(kycLocked ? "bg-warning" : "bg-success")">@(kycLocked ? "Pending" : "Verified")</span>
                            </a>
                        </li>
                    }
                    <li><a class="dropdown-item @(on("Setting","ChangePassword") ? "active" : "")" href="@Url.Action("ChangePassword","Setting")"><i class="fas fa-lock"></i>Change password</a></li>
                    <li><a class="dropdown-item" href="@Url.Action("ComplaintReport","Transaction")"><i class="fas fa-life-ring"></i>Support</a></li>
                    <li><hr class="dropdown-divider" /></li>
                    <li>
                        <a class="dropdown-item" href="@Url.Action("MenuLayout","Setting", new { mode = topMenu ? "side" : "top", returnUrl = Request.RawUrl })">
                            <i class="fas @(topMenu ? "fa-table-columns" : "fa-window-maximize")"></i>
                            @(topMenu ? "Use side menu" : "Use top menu")
                        </a>
                    </li>
                    <li><hr class="dropdown-divider" /></li>
                    <li><a class="dropdown-item text-danger" href="@Url.Action("Logout","Auth")"><i class="fas fa-arrow-right-from-bracket text-danger"></i>Sign out</a></li>
                </ul>
            </div>
        </header>

        <main class="app-content">
            @RenderBody()
        </main>

        <footer class="app-foot">&copy; @DateTime.Now.Year Express Recharge</footer>
    </div>
</div>

<script src="~/Content/js/jquery-3.7.0.min.js"></script>
<script src="~/Content/js/bootstrap.bundle.min.js"></script>

<span id="ajaxAntiForgery" hidden>@Html.AntiForgeryToken()</span>
<script>
    // Every form-encoded jQuery POST carries the anti-forgery token, so AJAX actions
    // can use [ValidateAntiForgeryToken] like normal forms.
    $.ajaxPrefilter(function (options) {
        if ((options.type || '').toUpperCase() !== 'POST') return;
        if (options.contentType && options.contentType.indexOf('application/x-www-form-urlencoded') !== 0) return;
        if (options.data != null && typeof options.data !== 'string') return;   // FormData etc.
        var token = $('#ajaxAntiForgery input[name="__RequestVerificationToken"]').val();
        if (!token) return;
        var pair = '__RequestVerificationToken=' + encodeURIComponent(token);
        options.data = options.data ? options.data + '&' + pair : pair;
    });

    // Theme switch: light / dark / same as device (saved in localStorage "vx-theme")
    (function () {
        var h = document.documentElement, mq = window.matchMedia ? window.matchMedia('(prefers-color-scheme: dark)') : null;
        function apply(pref) {
            var dark = pref === 'dark' || (pref === 'system' && mq && mq.matches);
            h.setAttribute('data-theme', dark ? 'dark' : 'light');
            h.setAttribute('data-bs-theme', dark ? 'dark' : 'light');
            h.setAttribute('data-theme-pref', pref);
            document.getElementById('themeIcon').className = 'fas ' + (pref === 'system' ? 'fa-circle-half-stroke' : dark ? 'fa-moon' : 'fa-sun');
            document.querySelectorAll('[data-theme-set]').forEach(function (a) { a.classList.toggle('on', a.getAttribute('data-theme-set') === pref); });
        }
        document.querySelectorAll('[data-theme-set]').forEach(function (a) {
            a.addEventListener('click', function (e) {
                e.preventDefault();
                var pref = a.getAttribute('data-theme-set');
                try { localStorage.setItem('vx-theme', pref); } catch (err) { }
                apply(pref);
            });
        });
        if (mq && mq.addEventListener) mq.addEventListener('change', function () { if (h.getAttribute('data-theme-pref') === 'system') apply('system'); });
        apply(h.getAttribute('data-theme-pref') || 'system');
    })();

    // Mobile sidebar
    (function () {
        var app = document.getElementById('app');
        document.getElementById('appBurger').addEventListener('click', function () { app.classList.add('side-open'); });
        document.getElementById('appScrim').addEventListener('click', function () { app.classList.remove('side-open'); });
    })();

    // Close dismissible alerts
    document.querySelectorAll('[data-dismiss="alert"]').forEach(function (btn) {
        btn.addEventListener('click', function () {
            this.closest('.alert').style.display = 'none';
        });
    });

    // Show / hide toggle for every password field (skips fields already in an input-group)
    document.querySelectorAll('input[type="password"]').forEach(function (input) {
        if (input.closest('.input-group') || input.hasAttribute('data-no-toggle')) return;

        var group = document.createElement('div');
        group.className = 'input-group';
        input.parentNode.insertBefore(group, input);
        group.appendChild(input);

        var btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'btn btn-outline-secondary';
        btn.title = 'Show / hide password';
        btn.setAttribute('aria-label', 'Show password');
        btn.innerHTML = '<i class="bi bi-eye"></i>';
        group.appendChild(btn);

        btn.addEventListener('click', function () {
            var show = input.type === 'password';
            input.type = show ? 'text' : 'password';
            btn.querySelector('i').className = show ? 'bi bi-eye-slash' : 'bi bi-eye';
            btn.setAttribute('aria-label', show ? 'Hide password' : 'Show password');
        });
    });
</script>
@RenderSection("Scripts", required: false)
</body>
</html>
