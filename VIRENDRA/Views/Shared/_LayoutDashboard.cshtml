<!DOCTYPE html>
@{
    var currentController = (ViewContext.RouteData.Values["controller"] ?? "").ToString();
    var currentAction = (ViewContext.RouteData.Values["action"] ?? "").ToString();
    byte roleId = (byte)(Session["RoleId"] ?? (byte)0);
    string uname = (Session["Username"] ?? "User").ToString();
    decimal bal = (decimal)(Session["UserBal"] ?? 0m);

    bool isSuperAdmin = roleId == 1;
    bool isAdmin = roleId == 2;
    bool isApiUser = roleId == 3;
    bool isRetailer = roleId == 4;

    string roleName = isSuperAdmin ? "Super Admin"
                    : isAdmin ? "Admin"
                    : isApiUser ? "API User"
                    : "Retailer";

    // Helper: is any of the listed controllers the current one?
    Func<string[], bool> anyActive = controllers =>
        System.Array.IndexOf(controllers, currentController) >= 0;
}
<html lang="en">
<head>
    <meta charset="utf-8">
    <title>@(ViewBag.Title != null ? ViewBag.Title + " — " : "")Recharge Software</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!-- Bootstrap CSS -->
    <link href="~/Content/css/bootstrap.min.css" rel="stylesheet">
    <link href="~/Content/css/bootstrap-icons.css" rel="stylesheet">
    <link href="~/Content/css/boxicons.min.css" rel="stylesheet">
    <link href="~/Content/css/remixicon.css" rel="stylesheet">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
    <!-- Template CSS -->
    <link href="~/Content/css/style.css" rel="stylesheet">

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f0f2f5;
        }

        /* ── Top Navbar ───────────────────────────────────────── */
        .top-navbar {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            box-shadow: 0 2px 12px rgba(0,0,0,.18);
            padding: 0;
            position: sticky;
            top: 0;
            z-index: 1040;
        }

            /* Brand */
            .top-navbar .navbar-brand {
                font-size: 1.25rem;
                font-weight: 800;
                color: #fff !important;
                letter-spacing: .5px;
                padding: .75rem 1rem .75rem 0;
                display: flex;
                align-items: center;
                gap: .45rem;
            }

            /* Hamburger */
            .top-navbar .navbar-toggler {
                border: none;
                padding: .4rem .6rem;
            }

            .top-navbar .navbar-toggler-icon {
                filter: invert(1);
            }

            /* Primary nav links */
            .top-navbar .nav-link {
                color: rgba(255,255,255,.88) !important;
                font-size: .83rem;
                font-weight: 500;
                padding: .85rem .75rem !important;
                border-bottom: 3px solid transparent;
                transition: all .2s;
                white-space: nowrap;
            }

                .top-navbar .nav-link:hover {
                    color: #fff !important;
                    border-bottom-color: rgba(255,255,255,.5);
                }

                .top-navbar .nav-link.active,
                .top-navbar .nav-item.active > .nav-link {
                    color: #fff !important;
                    border-bottom-color: #fff;
                    font-weight: 700;
                }

            /* Dropdown */
            .top-navbar .dropdown-menu {
                border: none;
                box-shadow: 0 8px 32px rgba(0,0,0,.14);
                border-radius: 10px;
                overflow: hidden;
                min-width: 200px;
                margin-top: 0 !important;
                padding: .4rem 0;
            }

            .top-navbar .dropdown-header {
                font-size: .7rem;
                font-weight: 700;
                color: #9e9e9e;
                text-transform: uppercase;
                letter-spacing: .06em;
                padding: .6rem 1rem .3rem;
            }

            .top-navbar .dropdown-item {
                font-size: .83rem;
                padding: .55rem 1.1rem;
                color: #343a40;
                display: flex;
                align-items: center;
                gap: .55rem;
                transition: background .15s;
            }

                .top-navbar .dropdown-item i {
                    width: 18px;
                    text-align: center;
                    color: #667eea;
                    font-size: .85rem;
                }

                .top-navbar .dropdown-item:hover {
                    background: #f0f2ff;
                    color: #667eea;
                }

                .top-navbar .dropdown-item.active,
                .top-navbar .dropdown-item:active {
                    background: #667eea;
                    color: #fff;
                }

                    .top-navbar .dropdown-item.active i {
                        color: #fff;
                    }

            .top-navbar .dropdown-divider {
                margin: .3rem 0;
                border-color: #f0f0f0;
            }

        /* Right-side user pill */
        .nav-user-pill {
            background: rgba(255,255,255,.18);
            border-radius: 30px;
            padding: .35rem .9rem;
            color: #fff;
            font-size: .82rem;
            font-weight: 500;
            display: flex;
            align-items: center;
            gap: .4rem;
            cursor: default;
            white-space: nowrap;
        }

        .nav-balance {
            color: rgba(255,255,255,.9);
            font-size: .82rem;
            font-weight: 500;
            white-space: nowrap;
        }

        /* Main page area */
        .page-wrapper {
            min-height: calc(100vh - 52px);
            padding: 1.75rem 1.75rem 2rem;
            background: #f0f2f5;
        }

        /* Responsive: on mobile stack nav items */
        @@media (max-width: 991.98px) {
            .top-navbar .nav-link {
                border-bottom: none;
                border-left: 3px solid transparent;
                padding: .6rem 1rem !important;
            }

                .top-navbar .nav-link.active,
                .top-navbar .nav-item.active > .nav-link {
                    border-left-color: #fff;
                    border-bottom: none;
                    background: rgba(255,255,255,.12);
                }

            .top-navbar .dropdown-menu {
                border-radius: 0;
                box-shadow: none;
                background: rgba(255,255,255,.08);
                padding: 0;
            }

            .top-navbar .dropdown-item {
                color: rgba(255,255,255,.85);
                background: transparent;
            }

                .top-navbar .dropdown-item:hover {
                    background: rgba(255,255,255,.12);
                    color: #fff;
                }

                .top-navbar .dropdown-item i {
                    color: rgba(255,255,255,.7);
                }

            .top-navbar .dropdown-header {
                color: rgba(255,255,255,.5);
            }

            .top-navbar .dropdown-divider {
                border-color: rgba(255,255,255,.1);
            }

            .page-wrapper {
                padding: 1rem;
            }
        }
    </style>
</head>
<body>

    <!-- ═══════════════════ TOP NAVBAR ═══════════════════ -->
    <nav class="navbar navbar-expand-lg top-navbar">
        <div class="container-fluid px-3">

            <!-- Brand / Logo -->
            <a class="navbar-brand" href="@Url.Action("Dashboard","Home")">
                <i class="fas fa-exchange-alt"></i>
                EXPRESS
            </a>

            <!-- Mobile toggler -->
            <button class="navbar-toggler" type="button"
                    data-bs-toggle="collapse" data-bs-target="#mainNavbar"
                    aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="mainNavbar">

                <!-- ── Left nav links ──────────────────────────── -->
                <ul class="navbar-nav me-auto align-items-lg-stretch">

                    @*<%-- Dashboard — all roles --%>*@
                    <li class="nav-item @(currentController == "Home" ? "active" : "")">
                        <a class="nav-link @(currentController == "Home" ? "active" : "")"
                           href="@Url.Action("Dashboard","Home")">
                            <i class="fas fa-home me-1"></i>Dashboard
                        </a>
                    </li>

                    @*<%-- Administration — SuperAdmin + Admin --%>*@
                    @if (isSuperAdmin || isAdmin)
                    {
                        bool adminActive = anyActive(new[] { "User", "Package", "Operator", "Vendor", "BankAccount", "Services", "CommonRouting" });
                        <li class="nav-item dropdown @(adminActive ? "active" : "")">
                            <a class="nav-link dropdown-toggle @(adminActive ? "active" : "")"
                               href="#" id="ddAdmin" role="button"
                               data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="fas fa-cogs me-1"></i>Administration
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="ddAdmin">
                                <li><h6 class="dropdown-header">Manage</h6></li>
                                <li>
                                    <a class="dropdown-item @(currentController=="User" ? "active" : "")"
                                       href="@Url.Action("Index","User")">
                                        <i class="fas fa-users"></i> User Management
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item @(currentController=="Package" ? "active" : "")"
                                       href="@Url.Action("Index","Package")">
                                        <i class="fas fa-box-open"></i> Packages
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item @(currentController=="Operator" ? "active" : "")"
                                       href="@Url.Action("Index","Operator")">
                                        <i class="bx bx-mobile"></i> Operators
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item @(currentController=="Vendor" ? "active" : "")"
                                       href="@Url.Action("Index","Vendor")">
                                        <i class="fas fa-store"></i> Vendors (API)
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li><h6 class="dropdown-header">Finance</h6></li>
                                <li>
                                    <a class="dropdown-item @(currentController=="BankAccount" ? "active" : "")"
                                       href="@Url.Action("Index","BankAccount")">
                                        <i class="fas fa-university"></i> Bank Accounts
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li><h6 class="dropdown-header">Config</h6></li>
                                <li>
                                    <a class="dropdown-item @(currentController=="Services" ? "active" : "")"
                                       href="@Url.Action("Index","Services")">
                                        <i class="bx bx-mobile"></i> Services
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item @(currentController=="CommonRouting" ? "active" : "")"
                                       href="@Url.Action("Index","CommonRouting")">
                                        <i class="fas fa-route"></i> Route Settings
                                    </a>
                                </li>
                            </ul>
                        </li>
                    }

                    @*<%-- My Account — ApiUser + Retailer --%>*@
                    @if (isApiUser || isRetailer)
                    {
                        <li class="nav-item @(currentController=="PackageComm" ? "active" : "")">
                            <a class="nav-link @(currentController=="PackageComm" ? "active" : "")"
                               href="@Url.Action("MyCommission","PackageComm")">
                                <i class="fas fa-percent me-1"></i>My Commission
                            </a>
                        </li>
                    }
                    @if (isSuperAdmin || isAdmin || isRetailer)
                    {
                        @*<%-- Recharge — all roles --%>*@
                        <li class="nav-item @(currentController == "Recharge" ? "active" : "")">
                            <a class="nav-link @(currentController == "Recharge" ? "active" : "")"
                               href="@Url.Action("Index", "Recharge")">
                                <i class="bx bx-mobile-alt me-1"></i>Recharge
                            </a>
                        </li>
                    }
                    @*<%-- Transaction — all roles --%>*@
                    @{
                        bool txnActive = currentController == "Transaction";
                    }
                    <li class="nav-item dropdown @(txnActive ? "active" : "")">
                        <a class="nav-link dropdown-toggle @(txnActive ? "active" : "")"
                           href="#" id="ddTxn" role="button"
                           data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="far fa-file-alt me-1"></i>Transactions
                        </a>
                        <ul class="dropdown-menu" aria-labelledby="ddTxn">
                            <li>
                                <a class="dropdown-item @(txnActive && currentAction=="RechargeHistory" ? "active" : "")"
                                   href="@Url.Action("RechargeHistory","Transaction")">
                                    <i class="fas fa-history"></i> Recharge History
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item @(txnActive && currentAction=="TransactionHistory" ? "active" : "")"
                                   href="@Url.Action("TransactionHistory","Transaction")">
                                    <i class="fas fa-list-alt"></i> Transaction History
                                </a>
                            </li>
                        </ul>
                    </li>

                    @*<%-- Payment — SuperAdmin + Admin + Retailer --%>*@
                    @if (isSuperAdmin || isAdmin || isRetailer || isApiUser)
                    {
                        bool walletActive = currentController == "Wallet";
                        <li class="nav-item dropdown @(walletActive ? "active" : "")">
                            <a class="nav-link dropdown-toggle @(walletActive ? "active" : "")"
                               href="#" id="ddWallet" role="button"
                               data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="fas fa-wallet me-1"></i>Payment
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="ddWallet">
                                <li>
                                    <a class="dropdown-item @(walletActive && currentAction=="Index" ? "active" : "")"
                                       href="@Url.Action("Index","Wallet")">
                                        <i class="fas fa-inbox"></i> Payment Requests
                                    </a>
                                </li>
                                @if (isSuperAdmin || isAdmin)
                                {
                                    <li>
                                        <a class="dropdown-item @(walletActive && currentAction == "AddMoney" ? "active" : "")"
                                           href="@Url.Action("AddMoney", "Wallet")">
                                            <i class="fas fa-plus-circle"></i> Add Money
                                        </a>
                                    </li>
                                }
                            </ul>
                        </li>
                    }

                    @*<%-- Reports — SuperAdmin + Admin --%>*@
                    @if (isSuperAdmin || isAdmin || isRetailer || isApiUser)
                    {
                        bool rptActive = currentController == "Reports";
                        <li class="nav-item dropdown @(rptActive ? "active" : "")">
                            <a class="nav-link dropdown-toggle @(rptActive ? "active" : "")"
                               href="#" id="ddReports" role="button"
                               data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bx bx-file me-1"></i>Reports
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="ddReports">
                                <li>
                                    <a class="dropdown-item @(rptActive && currentAction=="OperatorwiseReport" ? "active" : "")"
                                       href="@Url.Action("OperatorwiseReport","Reports")">
                                        <i class="fas fa-chart-bar"></i> Operatorwise Report
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" href="javascript:void(0);">
                                        <i class="fas fa-file-invoice"></i> Payment Report
                                    </a>
                                </li>
                            </ul>
                        </li>
                    }

                    @*<%-- Developer — SuperAdmin + ApiUser --%>*@
                    @if (isSuperAdmin || isApiUser)
                    {
                        bool devActive = anyActive(new[] { "ApiDocument", "ApiSettings" });
                        <li class="nav-item dropdown @(devActive ? "active" : "")">
                            <a class="nav-link dropdown-toggle @(devActive ? "active" : "")"
                               href="#" id="ddDev" role="button"
                               data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bx bxs-wrench me-1"></i>Developer
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="ddDev">
                                <li>
                                    <a class="dropdown-item @(currentController=="ApiSettings" ? "active" : "")"
                                       href="@Url.Action("Index","ApiSettings")">
                                        <i class="fas fa-key"></i> API Setting
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item @(currentController=="ApiDocument" ? "active" : "")"
                                       href="@Url.Action("Index","ApiDocument")">
                                        <i class="fas fa-code"></i> API Integration Tool
                                    </a>
                                </li>
                            </ul>
                        </li>
                    }

                    @*<%-- Support — all roles --%>*@
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" id="ddSupport" role="button"
                           data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="fas fa-headphones me-1"></i>Support
                        </a>
                        <ul class="dropdown-menu" aria-labelledby="ddSupport">
                            <li>
                                <a class="dropdown-item" href="javascript:void(0);">
                                    <i class="fas fa-exclamation-circle"></i> Dispute
                                </a>
                            </li>
                        </ul>
                    </li>

                </ul><!-- /navbar-nav -->
                <!-- ── Right-side: balance + user + logout ───────── -->
                <div class="d-flex align-items-center gap-2 py-2 py-lg-0 ms-lg-3">

                    <!-- Balance -->
                    <span class="nav-balance d-none d-md-inline">
                        <i class="fas fa-wallet me-1"></i>
                        <i class="fa fa-rupee-sign"></i>@bal.ToString("N2")
                    </span>

                    <!-- User pill -->
                    <div class="nav-user-pill d-none d-md-flex">
                        <i class="fas fa-user-circle"></i>
                        <span>@uname</span>
                        <span class="badge ms-1"
                              style="background:rgba(255,255,255,.25);font-size:.65rem;">@roleName</span>
                        </div>

                        <!-- Logout -->
                        <a href="@Url.Action("Logout","Auth")"
                           class="btn btn-sm btn-outline-light ms-1"
                           title="Logout">
                            <i class="fas fa-sign-out-alt"></i>
                            <span class="d-inline d-lg-none ms-1">Logout</span>
                        </a>
                    </div>

                </div><!-- /collapse -->
            </div><!-- /container-fluid -->
        </nav>
        <!-- ═══════════════════ /TOP NAVBAR ═══════════════════ -->
        <!-- Page Content -->
        <div class="page-wrapper">
            @RenderBody()
        </div>

        <!-- jQuery -->
        <script src="~/Content/js/jquery-3.6.0.min.js"></script>
        <!-- Bootstrap JS -->
        <script src="~/Content/js/bootstrap.bundle.min.js"></script>

        <script>
            // Close dismissible alerts
            document.querySelectorAll('[data-dismiss="alert"]').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    this.closest('.alert').style.display = 'none';
                });
            });
        </script>
        @RenderSection("Scripts", required: false)
    </body>
</html>
