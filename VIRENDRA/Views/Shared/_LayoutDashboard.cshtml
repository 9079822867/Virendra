<!DOCTYPE html>
@{
    var currentController = (ViewContext.RouteData.Values["controller"] ?? "").ToString();
    byte roleId  = (byte)(Session["RoleId"] ?? (byte)0);
    string uname = (Session["Username"] ?? "User").ToString();
    decimal bal  = (decimal)(Session["UserBal"] ?? 0m);

    bool isSuperAdmin = roleId == 1;
    bool isAdmin      = roleId == 2;
    bool isApiUser    = roleId == 3;
    bool isRetailer   = roleId == 4;

    string roleName = isSuperAdmin ? "Super Admin"
                    : isAdmin      ? "Admin"
                    : isApiUser    ? "API User"
                    : "Retailer";
}
<html>
<head>
    <meta charset="utf-8">
    <title>Recharge Software - Dashboard</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Recharge Software Dashboard">

    <!-- Bootstrap CSS -->
    <link href="~/Content/css/bootstrap.min.css" rel="stylesheet">
    <link href="~/Content/css/bootstrap-icons.css" rel="stylesheet">
    <link href="~/Content/css/boxicons.min.css" rel="stylesheet">
    <link href="~/Content/css/remixicon.css" rel="stylesheet">

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
    <!-- Template CSS -->
    <link href="~/Content/css/style.css" rel="stylesheet">

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f8f9fa;
        }

        /* Top Header */
        .top-header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 1rem 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        }

            .top-header .logo {
                font-weight: bold;
                font-size: 1.5rem;
                display: flex;
                align-items: center;
                gap: 0.5rem;
            }

            .top-header .search-box {
                flex: 0 0 30%;
                display: flex;
                gap: 0.5rem;
            }

                .top-header .search-box input {
                    flex: 1;
                    padding: 0.5rem 1rem;
                    border: none;
                    border-radius: 20px;
                    outline: none;
                }

                .top-header .search-box button {
                    background: #48bb78;
                    color: white;
                    border: none;
                    padding: 0.5rem 1.5rem;
                    border-radius: 20px;
                    cursor: pointer;
                }

            .top-header .user-info {
                display: flex;
                align-items: center;
                gap: 1rem;
            }

                .top-header .user-info .time,
                .top-header .user-info .balance {
                    font-size: 0.9rem;
                }

            .top-header .user-name {
                background: rgba(255, 255, 255, 0.2);
                padding: 0.5rem 1rem;
                border-radius: 20px;
                font-weight: 500;
            }

        /* Main Container */
        .dashboard-container {
            display: flex;
            height: calc(100vh - 80px);
        }

        /* Sidebar */
        .sidebar {
            width: 220px;
            background: #f0f2f5;
            padding: 2rem 0;
            overflow-y: auto;
            border-right: 1px solid #dee2e6;
        }

            .sidebar .menu-title {
                padding: 0.5rem 1.5rem;
                font-size: 0.75rem;
                font-weight: 600;
                color: #6c757d;
                text-transform: uppercase;
                margin-top: 1rem;
            }

            .sidebar ul {
                list-style: none;
                margin: 0;
                padding: 0;
            }

            .sidebar li {
                margin: 0.25rem 0.5rem;
            }

            .sidebar a {
                padding: 0.75rem 1.5rem;
                display: flex;
                align-items: center;
                gap: 0.75rem;
                color: #495057;
                text-decoration: none;
                border-radius: 8px;
                transition: all 0.3s ease;
                cursor: pointer;
            }

                .sidebar a:hover {
                    background: #e9ecef;
                    color: #212529;
                }

                .sidebar li.mm-active > a,
                .sidebar a.active {
                    background: #48bb78;
                    color: white;
                    font-weight: 600;
                }

                .sidebar a i,
                .sidebar a svg {
                    font-size: 1.1rem;
                    width: 24px;
                    min-width: 24px;
                }

                .sidebar a.has-arrow::after {
                    content: '\f078';
                    font-family: 'Font Awesome 6 Free';
                    font-weight: 900;
                    margin-left: auto;
                    font-size: 0.75rem;
                }

            .sidebar .sub-menu {
                display: none;
                margin: 0.25rem 0 0.5rem 0;
                padding-left: 1.75rem;
            }

                .sidebar .sub-menu.mm-show {
                    display: block;
                }

                .sidebar .sub-menu li {
                    margin: 0.15rem 0;
                }

                .sidebar .sub-menu a {
                    font-size: 0.9rem;
                    padding: 0.5rem 1rem;
                }

        /* Main Content */
        .main-content {
            flex: 1;
            overflow-y: auto;
            padding: 2rem;
        }

        /* Scrollbar Styling */
        .sidebar::-webkit-scrollbar {
            width: 6px;
        }

        .sidebar::-webkit-scrollbar-track {
            background: #f1f1f1;
        }

        .sidebar::-webkit-scrollbar-thumb {
            background: #888;
            border-radius: 3px;
        }

            .sidebar::-webkit-scrollbar-thumb:hover {
                background: #555;
            }
    </style>
</head>
<body>
    <!-- Top Header -->
    <div class="top-header">
        <div class="logo">
            <i class="fas fa-exchange-alt"></i>
            EXPRESS
        </div>

        <div class="search-box">
            <input type="text" placeholder="Search...">
            <button type="button"><i class="fas fa-search"></i></button>
        </div>

        <div class="user-info">
            <div class="balance">
                <i class="fas fa-wallet me-1"></i> ₹@bal.ToString("N2")
            </div>
            <div class="user-name">
                <i class="fas fa-user-circle me-1"></i>
                @uname
                <span class="badge ms-1" style="background:rgba(255,255,255,.25);font-size:.7rem;">@roleName</span>
                <i class="fas fa-chevron-down ms-1"></i>
            </div>
            <a href="@Url.Action("Logout", "Auth")" class="btn btn-sm btn-outline-light">
                <i class="fas fa-sign-out-alt"></i>
            </a>
        </div>
    </div>

    <!-- Dashboard Container -->
    <div class="dashboard-container">
        <!-- Sidebar -->
        <div class="sidebar">
            <ul class="metismenu list-unstyled mm-show" id="side-menu">
                <li class="menu-title">Menu</li>

                @* Dashboard: all roles *@
                <li class="@(currentController == "Home" ? "mm-active" : "")">
                    <a href="@Url.Action("Dashboard", "Home")" class="@(currentController == "Home" ? "active" : "")">
                        <i class="fas fa-home"></i>
                        <span>Dashboard</span>
                    </a>
                </li>

                @* Administration: SuperAdmin + Admin *@
                @if (isSuperAdmin || isAdmin)
                {
                    <li class="menu-title">Administration</li>
                    <li class="@(currentController == "User" ? "mm-active" : "")">
                        <a href="@Url.Action("Index", "User")" class="@(currentController == "User" ? "active" : "")">
                            <i class="fas fa-users"></i>
                            <span>User Management</span>
                        </a>
                    </li>
                    <li class="@(currentController == "Package" ? "mm-active" : "")">
                        <a href="@Url.Action("Index", "Package")" class="@(currentController == "Package" ? "active" : "")">
                            <i class="fas fa-box-open"></i>
                            <span>Packages</span>
                        </a>
                    </li>
                    <li class="@(currentController == "Operator" ? "mm-active" : "")">
                        <a href="@Url.Action("Index", "Operator")" class="@(currentController == "Operator" ? "active" : "")">
                            <i class="bx bx-mobile"></i>
                            <span>Operators</span>
                        </a>
                    </li>
                    <li class="@(currentController == "Vendor" ? "mm-active" : "")">
                        <a href="@Url.Action("Index", "Vendor")" class="@(currentController == "Vendor" ? "active" : "")">
                            <i class="fas fa-store"></i>
                            <span>Vendors (API)</span>
                        </a>
                    </li>
                }

                @* My Commission: API User + Retailer *@
                @if (isApiUser || isRetailer)
                {
                    <li class="menu-title">My Account</li>
                    <li class="@(currentController == "PackageComm" ? "mm-active" : "")">
                        <a href="@Url.Action("MyCommission", "PackageComm")" class="@(currentController == "PackageComm" ? "active" : "")">
                            <i class="fas fa-percent"></i>
                            <span>My Commission</span>
                        </a>
                    </li>
                }

                @* Services: SuperAdmin + Admin *@
                @if (isSuperAdmin || isAdmin)
                {
                    <li class="@(currentController == "Services" ? "mm-active" : "")">
                        <a href="@Url.Action("Index", "Services")" class="@(currentController == "Services" ? "active" : "")">
                            <i class="bx bx-mobile"></i>
                            <span>Services</span>
                        </a>
                    </li>
                }

                @* Recharge: all roles *@
                <li class="menu-title">Recharge</li>
                <li class="@(currentController == "Recharge" ? "mm-active" : "")">
                    <a href="@Url.Action("Index", "Recharge")" class="@(currentController == "Recharge" ? "active" : "")">
                        <i class="bx bx-mobile-alt"></i>
                        <span>Do Recharge</span>
                    </a>
                </li>

                @* Transactions: all roles *@
                <li class="@(currentController == "Transaction" ? "mm-active" : "")">
                    <a href="javascript:void(0);" class="has-arrow @(currentController == "Transaction" ? "active" : "")">
                        <i class="far fa-file-alt"></i>
                        <span>Transaction</span>
                    </a>
                    <ul class="sub-menu mm-collapse @(currentController == "Transaction" ? "mm-show" : "")" aria-expanded="@(currentController == "Transaction" ? "true" : "false")">
                        <li><a href="@Url.Action("RechargeHistory", "Transaction")">Recharge History</a></li>
                        <li><a href="@Url.Action("TransactionHistory", "Transaction")">Transaction History</a></li>
                    </ul>
                </li>

                @* Payment: SuperAdmin + Admin + Retailer *@
                @if (isSuperAdmin || isAdmin || isRetailer)
                {
                    <li class="@(currentController == "Wallet" ? "mm-active" : "")">
                        <a href="javascript:void(0);" class="has-arrow @(currentController == "Wallet" ? "active" : "")">
                            <i class="fas fa-wallet"></i>
                            <span>Payment</span>
                        </a>
                        <ul class="sub-menu mm-collapse @(currentController == "Wallet" ? "mm-show" : "")" aria-expanded="@(currentController == "Wallet" ? "true" : "false")">
                            <li><a href="javascript:void(0);">Payment Request</a></li>
                            <li><a href="@Url.Action("AddMoney", "Wallet")">Add Money</a></li>
                        </ul>
                    </li>
                }

                @* Reports: SuperAdmin + Admin *@
                @if (isSuperAdmin || isAdmin)
                {
                    <li class="menu-title">Reports</li>
                    <li class="@(currentController == "Reports" ? "mm-active" : "")">
                        <a href="javascript:void(0);" class="has-arrow @(currentController == "Reports" ? "active" : "")">
                            <i class="bx bx-file"></i>
                            <span>Reports</span>
                        </a>
                        <ul class="sub-menu mm-collapse @(currentController == "Reports" ? "mm-show" : "")" aria-expanded="@(currentController == "Reports" ? "true" : "false")">
                            <li><a href="@Url.Action("OperatorwiseReport", "Reports")">Operatorwise Report</a></li>
                            <li><a href="javascript:void(0);">Payment Report</a></li>
                        </ul>
                    </li>
                }

                @* Developer Tools: SuperAdmin + API User *@
                @if (isSuperAdmin || isApiUser)
                {
                    <li class="menu-title">Developer</li>
                    <li class="@(currentController == "ApiDocument" || currentController == "ApiSettings" ? "mm-active" : "")">
                        <a href="javascript:void(0);" class="has-arrow @(currentController == "ApiDocument" || currentController == "ApiSettings" ? "active" : "")">
                            <i class="bx bxs-wrench"></i>
                            <span>Developer Tools</span>
                        </a>
                        <ul class="sub-menu mm-collapse @(currentController == "ApiDocument" || currentController == "ApiSettings" ? "mm-show" : "")" aria-expanded="@(currentController == "ApiDocument" || currentController == "ApiSettings" ? "true" : "false")">
                            <li class="@(currentController == "ApiSettings" ? "mm-active" : "")">
                                <a href="@Url.Action("Index", "ApiSettings")" class="@(currentController == "ApiSettings" ? "active" : "")">API Setting</a>
                            </li>
                            <li class="@(currentController == "ApiDocument" ? "mm-active" : "")">
                                <a href="@Url.Action("Index", "ApiDocument")" class="@(currentController == "ApiDocument" ? "active" : "")">API Integration Tool</a>
                            </li>
                        </ul>
                    </li>
                }

                @* Support: all roles *@
                <li class="menu-title">Support</li>
                <li>
                    <a href="javascript:void(0);" class="has-arrow">
                        <i class="fas fa-headphones"></i>
                        <span>Support</span>
                    </a>
                    <ul class="sub-menu mm-collapse" aria-expanded="false">
                        <li><a href="javascript:void(0);">Dispute</a></li>
                    </ul>
                </li>
            </ul>
        </div>

        <!-- Main Content -->
        <div class="main-content">
            @RenderBody()
        </div>
    </div>

    <!-- jQuery -->
    <script src="~/Content/js/jquery-3.6.0.min.js"></script>
    <!-- Bootstrap JS -->
    <script src="~/Content/js/bootstrap.bundle.min.js"></script>

    <script>
        document.querySelectorAll('.sidebar .has-arrow').forEach(item => {
            item.addEventListener('click', function () {
                var submenu = this.nextElementSibling;

                if (submenu && submenu.classList.contains('sub-menu')) {
                    submenu.classList.toggle('mm-show');
                }
            });
        });

        // Close alert
        document.querySelectorAll('[data-dismiss="alert"]').forEach(btn => {
            btn.addEventListener('click', function () {
                this.closest('.alert').style.display = 'none';
            });
        });
    </script>
    @RenderSection("Scripts", required: false)
</body>
</html>
