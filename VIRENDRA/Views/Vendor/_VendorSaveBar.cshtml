@model string
@* Sticky footer with Cancel / Save. Model = label of the save button. *@
<div class="position-sticky bottom-0 bg-white border rounded-3 shadow-sm px-3 py-2 mt-1 d-flex align-items-center justify-content-between flex-wrap gap-2" style="z-index:5;">
    <span class="text-muted small">Fields with <span class="text-danger">*</span> are required. Empty endpoints are skipped.</span>
    <div class="d-flex gap-2">
        <a href="@Url.Action("Index")" class="btn btn-light px-4">Cancel</a>
        <button type="submit" class="btn btn-dark px-4"><i class="fas fa-floppy-disk me-1"></i>@Model</button>
    </div>
</div>
