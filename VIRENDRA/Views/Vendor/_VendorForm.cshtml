@model VIRENDRA.Models.ApiSource
@using VIRENDRA.Services

@{
    var responseTypeOptions = new[]
    {
        "JSON (application/json)",
        "FormData (application/x-www-form-urlencoded)",
        "XML (application/xml)",
        "Plain Text (text/plain)"
    };

    // Short labels + one-line purpose for each endpoint tab
    var endpointInfo = new Dictionary<string, string[]>
    {
        { "RechargeRequest", new[] { "Recharge",  "fa-bolt",               "Sends the recharge to the vendor." } },
        { "BalanceCheck",    new[] { "Balance",   "fa-wallet",             "Reads your balance with the vendor." } },
        { "StatusCheck",     new[] { "Status",    "fa-magnifying-glass",   "Asks the vendor for a recharge's final status." } },
        { "CallBack",        new[] { "Callback",  "fa-reply",              "Vendor calls this when a pending recharge settles." } },
        { "Validation",      new[] { "Validate",  "fa-shield-halved",      "Checks number / operator before recharging." } },
        { "ComplainRequest", new[] { "Complaint", "fa-flag",               "Forwards a customer complaint to the vendor." } }
    };

    var groups = ApiTokens.All.GroupBy(t => t.Group).ToList();
}

<style>
    .vx { --vx-ink:#1f2937; --vx-muted:#6b7280; --vx-line:#e5e7eb; --vx-soft:#f8fafc; --vx-accent:#0f766e; --vx-accent-soft:#ccfbf1; --vx-warn:#b45309; }
    .vx .vx-section { background:#fff; border:1px solid var(--vx-line); border-radius:10px; margin-bottom:16px; }
    .vx .vx-section-head { display:flex; align-items:center; gap:12px; padding:14px 18px; border-bottom:1px solid var(--vx-line); }
    .vx .vx-step { width:26px; height:26px; border-radius:50%; background:var(--vx-ink); color:#fff; font-size:.75rem; font-weight:700; display:flex; align-items:center; justify-content:center; flex-shrink:0; }
    .vx .vx-section-head h6 { margin:0; font-weight:700; color:var(--vx-ink); font-size:.95rem; }
    .vx .vx-section-head small { color:var(--vx-muted); }
    .vx .vx-section-body { padding:18px; }
    .vx label.form-label { font-size:.8rem; font-weight:600; color:var(--vx-ink); margin-bottom:4px; }
    .vx .vx-hint { font-size:.72rem; color:var(--vx-muted); }
    .vx .vx-tok { font-family:SFMono-Regular,Consolas,monospace; font-size:.7rem; color:var(--vx-accent); background:var(--vx-accent-soft); border-radius:4px; padding:1px 5px; }
    .vx .vx-switch { display:flex; align-items:center; justify-content:space-between; border:1px solid var(--vx-line); border-radius:8px; padding:10px 12px; height:100%; }
    .vx .vx-switch .form-check-input { width:2.4em; height:1.25em; cursor:pointer; margin:0; }
    .vx .vx-switch .form-check-input:checked { background-color:var(--vx-accent); border-color:var(--vx-accent); }

    /* endpoint tabs */
    .vx .vx-tabs { display:flex; gap:6px; flex-wrap:wrap; padding:12px 18px 0; border-bottom:1px solid var(--vx-line); }
    .vx .vx-tab { border:1px solid transparent; border-bottom:none; background:none; padding:8px 12px; font-size:.8rem; font-weight:600; color:var(--vx-muted); border-radius:8px 8px 0 0; display:flex; align-items:center; gap:6px; margin-bottom:-1px; }
    .vx .vx-tab.active { color:var(--vx-ink); background:#fff; border-color:var(--vx-line); }
    .vx .vx-dot { width:7px; height:7px; border-radius:50%; background:#d1d5db; }
    .vx .vx-dot.on { background:#16a34a; }
    .vx .vx-seg { display:inline-flex; border:1px solid var(--vx-line); border-radius:8px; overflow:hidden; }
    .vx .vx-seg button { border:0; background:#fff; padding:5px 14px; font-size:.78rem; font-weight:600; color:var(--vx-muted); }
    .vx .vx-seg button.on { background:var(--vx-ink); color:#fff; }
    .vx textarea.vx-code { font-family:SFMono-Regular,Consolas,monospace; font-size:.8rem; }
    .vx .vx-preview { background:var(--vx-soft); border:1px dashed var(--vx-line); border-radius:8px; padding:8px 10px; font-family:SFMono-Regular,Consolas,monospace; font-size:.74rem; color:var(--vx-ink); word-break:break-all; min-height:34px; }
    .vx .vx-preview mark { background:var(--vx-accent-soft); color:var(--vx-accent); padding:0 2px; border-radius:3px; }
    .vx .vx-preview .vx-unknown { background:#fee2e2; color:#b91c1c; }
    .vx .vx-legacy { display:none; font-size:.72rem; color:var(--vx-warn); }

    /* token panel */
    .vx .vx-side { position:sticky; top:80px; }
    .vx .vx-chip { display:flex; width:100%; align-items:center; justify-content:space-between; gap:8px; border:1px solid var(--vx-line); background:#fff; border-radius:7px; padding:5px 8px; margin-bottom:5px; text-align:left; }
    .vx .vx-chip:hover { border-color:var(--vx-accent); background:var(--vx-soft); }
    .vx .vx-chip span { font-size:.74rem; color:var(--vx-muted); }
    .vx .vx-group { font-size:.68rem; font-weight:700; letter-spacing:.06em; text-transform:uppercase; color:var(--vx-muted); margin:12px 0 6px; }
    .vx .vx-target { font-size:.72rem; color:var(--vx-muted); }
</style>

<div class="vx row g-3">

    <div class="col-xl-9 col-lg-8">

        <!-- 1. Connection -->
        <div class="vx-section">
            <div class="vx-section-head">
                <span class="vx-step">1</span>
                <div>
                    <h6>Connection</h6>
                    <small>Login details the vendor gave you</small>
                </div>
            </div>
            <div class="vx-section-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label" for="ApiName">Vendor name <span class="text-danger">*</span></label>
                        @Html.TextBoxFor(m => m.ApiName, new { @class = "form-control", placeholder = "e.g. Sunrise Recharge" })
                        @Html.ValidationMessageFor(m => m.ApiName, "", new { @class = "text-danger small" })
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="ApiUserId">User ID <span class="vx-tok">{{user_id}}</span></label>
                        @Html.TextBoxFor(m => m.ApiUserId, new { @class = "form-control", placeholder = "Vendor user ID", autocomplete = "off" })
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="apiPasswordField">Password <span class="vx-tok">{{password}}</span></label>
                        <div class="input-group">
                            @Html.PasswordFor(m => m.ApiPassword, new { @class = "form-control", placeholder = "Vendor password", id = "apiPasswordField", autocomplete = "new-password" })
                            <button type="button" class="btn btn-outline-secondary" id="vxPwdToggle" title="Show / hide">
                                <i class="fas fa-eye"></i>
                            </button>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="Remark">API key / token <span class="vx-tok">{{api_key}}</span></label>
                        @Html.TextBoxFor(m => m.Remark, new { @class = "form-control", placeholder = "Optional", autocomplete = "off" })
                    </div>
                </div>

                <div class="row g-3 mt-1">
                    <div class="col-md-4">
                        <div class="vx-switch">
                            <div>
                                <div class="fw-semibold small">Active</div>
                                <div class="vx-hint">Route recharges to this vendor</div>
                            </div>
                            <div class="form-check form-switch m-0">@Html.CheckBoxFor(m => m.IsActive, new { @class = "form-check-input" })</div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="vx-switch">
                            <div>
                                <div class="fw-semibold small">Auto status check</div>
                                <div class="vx-hint">Poll pending recharges</div>
                            </div>
                            <div class="form-check form-switch m-0">@Html.CheckBoxFor(m => m.IsAutoStatusCheck, new { @class = "form-check-input" })</div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="StatusCheckTime">Check every</label>
                        <div class="input-group">
                            @Html.TextBoxFor(m => m.StatusCheckTime, new { @class = "form-control", type = "number", min = "0", placeholder = "0" })
                            <span class="input-group-text">min</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 2. Endpoints -->
        <div class="vx-section">
            <div class="vx-section-head">
                <span class="vx-step">2</span>
                <div>
                    <h6>Endpoints</h6>
                    <small>One URL per action. Leave an endpoint empty if the vendor doesn't offer it.</small>
                </div>
            </div>

            <div class="vx-tabs" role="tablist">
                @for (int i = 0; i < Model.ApiUrls.Count; i++)
                {
                    var u    = Model.ApiUrls[i];
                    var info = endpointInfo.ContainsKey(u.UrlType) ? endpointInfo[u.UrlType] : new[] { u.UrlType, "fa-link", "" };
                    <button type="button" class="vx-tab @(i == 0 ? "active" : "")" data-bs-toggle="tab" data-bs-target="#vxEp@(i)" role="tab">
                        <i class="fas @info[1]"></i>@info[0]
                        <span class="vx-dot @(string.IsNullOrWhiteSpace(u.URL) ? "" : "on")" data-dot="@i"></span>
                    </button>
                }
            </div>

            <div class="tab-content">
                @for (int i = 0; i < Model.ApiUrls.Count; i++)
                {
                    var u      = Model.ApiUrls[i];
                    var info   = endpointInfo.ContainsKey(u.UrlType) ? endpointInfo[u.UrlType] : new[] { u.UrlType, "fa-link", "" };
                    var method = string.IsNullOrEmpty(u.Method) ? "GET" : u.Method;

                    <div class="tab-pane fade @(i == 0 ? "show active" : "")" id="vxEp@(i)" role="tabpanel" data-ep="@i">
                        <input type="hidden" name="urlType" value="@u.UrlType" />
                        <input type="hidden" name="method" value="@method" class="vx-method" />
                        <div class="vx-section-body">
                            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
                                <div class="vx-hint"><strong class="text-dark">@u.UrlType</strong> &middot; @info[2]</div>
                                <div class="vx-seg" data-seg="@i">
                                    <button type="button" class="@(method == "GET" ? "on" : "")" data-m="GET">GET</button>
                                    <button type="button" class="@(method == "POST" ? "on" : "")" data-m="POST">POST</button>
                                </div>
                            </div>

                            <label class="form-label">URL</label>
                            <textarea name="url" class="form-control vx-code vx-field" rows="2" data-ep="@i"
                                      placeholder="https://vendor.example/api/recharge?user={{user_id}}&key={{api_key}}&mobile={{mobile}}&op={{operator}}&amount={{amount}}&ref={{ref_id}}">@u.URL</textarea>
                            <div class="vx-legacy mt-1" data-legacy-for="url">
                                Uses old-style tokens like [MMM]. They still work.
                                <a href="#" class="vx-convert">Convert to new tokens</a>
                            </div>

                            <div class="vx-post mt-3" style="@(method == "POST" ? "" : "display:none;")">
                                <label class="form-label">POST body</label>
                                <textarea name="postParameter" class="form-control vx-code vx-field" rows="3" data-ep="@i"
                                          placeholder='mobile={{mobile}}&amount={{amount}}   or   {"mobile":"{{mobile}}","amount":"{{amount}}"}'>@u.PostData</textarea>
                                <div class="vx-legacy mt-1" data-legacy-for="body">
                                    Uses old-style tokens like [MMM]. They still work.
                                    <a href="#" class="vx-convert">Convert to new tokens</a>
                                </div>
                            </div>

                            <div class="row g-3 mt-1 align-items-end">
                                <div class="col-md-5">
                                    <label class="form-label">Vendor replies in</label>
                                    <select name="responseType" class="form-select">
                                        @foreach (var rt in responseTypeOptions)
                                        {
                                            <option value="@rt" @(u.ResType == rt ? "selected" : "")>@rt</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-7 text-md-end">
                                    @if (u.Id > 0)
                                    {
                                        <a href="@Url.Action("ResponseSetting", "Vendor", new { id = u.Id })" class="btn btn-outline-dark btn-sm">
                                            <i class="fas fa-sliders me-1"></i>Response rules
                                        </a>
                                        <div class="vx-hint mt-1">How to read status and txn ids from the reply. Save first.</div>
                                    }
                                    else
                                    {
                                        <div class="vx-hint">Response rules open after the vendor is saved.</div>
                                    }
                                </div>
                            </div>

                            <label class="form-label mt-3">Preview with sample data</label>
                            <div class="vx-preview" data-preview="@i"></div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Token panel -->
    <div class="col-xl-3 col-lg-4">
        <div class="vx-section vx-side">
            <div class="vx-section-head">
                <i class="fas fa-code text-muted"></i>
                <div>
                    <h6>Tokens</h6>
                    <small>Click to insert at the cursor</small>
                </div>
            </div>
            <div class="vx-section-body pt-2">
                <div class="vx-target" id="vxTarget">Click inside a URL or body field first.</div>
                @foreach (var g in groups)
                {
                    <div class="vx-group">@g.Key</div>
                    foreach (var t in g)
                    {
                        <button type="button" class="vx-chip" data-token="@t.Text" title="Old form @t.Legacy also works">
                            <code class="vx-tok">@t.Text</code><span>@t.Label</span>
                        </button>
                    }
                }
            </div>
        </div>
    </div>
</div>

<script>
    (function () {
        var tokens = @Html.Raw(Json.Encode(ApiTokens.All.Select(t => new { t.Key, t.Legacy, t.Text })));
        var sample = {
            user_id: 'demo_user', password: '••••', api_key: 'k3y', mobile: '9876543210', account: '9876543210',
            operator: 'AT', circle: 'RJ', amount: '199', ref_id: 'R2610311200', txn_id: 'R2610311200',
            vendor_txn_id: 'V889201', extra_url: '', extra_data: '', commission: '2.5',
            timestamp: '20261031120000', random: '482913', remark: 'Not credited'
        };
        var legacyRe = new RegExp(tokens.map(function (t) { return t.Legacy.replace(/[\[\]]/g, '\\$&'); }).join('|'), 'g');
        var anyLegacy = /\[[A-Z0-9]{3,5}\]|\[Description\]/;
        var lastField = null;

        function esc(s) { return s.replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); }

        function preview(ep) {
            var pane = document.querySelector('.tab-pane[data-ep="' + ep + '"]');
            var url  = pane.querySelector('textarea[name="url"]').value.trim();
            var body = pane.querySelector('textarea[name="postParameter"]').value.trim();
            var isPost = pane.querySelector('.vx-method').value === 'POST';
            var out = pane.querySelector('[data-preview]');

            if (!url) { out.innerHTML = '<span class="text-muted">No URL yet</span>'; }
            else {
                var text = url + (isPost && body ? '\n\nBODY: ' + body : '');
                out.innerHTML = esc(text)
                    .replace(/\{\{(\w+)\}\}/g, function (m, k) {
                        return k in sample ? '<mark>' + esc(sample[k] || '(empty)') + '</mark>' : '<mark class="vx-unknown">' + m + '</mark>';
                    })
                    .replace(legacyRe, function (m) {
                        var t = tokens.filter(function (x) { return x.Legacy === m; })[0];
                        return '<mark>' + esc(sample[t.Key] || '(empty)') + '</mark>';
                    })
                    .replace(/\n/g, '<br>');
            }

            document.querySelector('[data-dot="' + ep + '"]').classList.toggle('on', !!url);
            pane.querySelectorAll('.vx-field').forEach(function (f) {
                var note = f.parentNode.querySelector('.vx-legacy');
                if (note) note.style.display = anyLegacy.test(f.value) ? 'block' : 'none';
            });
        }

        document.querySelectorAll('.vx-field').forEach(function (f) {
            f.addEventListener('focus', function () {
                lastField = f;
                document.getElementById('vxTarget').textContent =
                    'Inserting into: ' + (f.name === 'url' ? 'URL' : 'POST body') + ' (' + f.closest('.tab-pane').querySelector('input[name="urlType"]').value + ')';
            });
            f.addEventListener('input', function () { preview(f.getAttribute('data-ep')); });
        });

        document.querySelectorAll('.vx-chip').forEach(function (chip) {
            chip.addEventListener('click', function () {
                var f = lastField || document.querySelector('.tab-pane.active textarea[name="url"]');
                var tok = chip.getAttribute('data-token');
                var s = f.selectionStart || 0, e = f.selectionEnd || 0;
                f.value = f.value.slice(0, s) + tok + f.value.slice(e);
                f.focus();
                f.selectionStart = f.selectionEnd = s + tok.length;
                preview(f.getAttribute('data-ep'));
            });
        });

        document.querySelectorAll('.vx-convert').forEach(function (a) {
            a.addEventListener('click', function (ev) {
                ev.preventDefault();
                var f = a.closest('div').parentNode.querySelector('.vx-field');
                f.value = f.value.replace(legacyRe, function (m) {
                    return tokens.filter(function (x) { return x.Legacy === m; })[0].Text;
                });
                preview(f.getAttribute('data-ep'));
            });
        });

        document.querySelectorAll('.vx-seg').forEach(function (seg) {
            seg.querySelectorAll('button').forEach(function (b) {
                b.addEventListener('click', function () {
                    var pane = seg.closest('.tab-pane');
                    seg.querySelectorAll('button').forEach(function (x) { x.classList.toggle('on', x === b); });
                    pane.querySelector('.vx-method').value = b.getAttribute('data-m');
                    pane.querySelector('.vx-post').style.display = b.getAttribute('data-m') === 'POST' ? '' : 'none';
                    preview(pane.getAttribute('data-ep'));
                });
            });
        });

        document.querySelectorAll('.vx-tab').forEach(function (t) {
            t.addEventListener('shown.bs.tab', function () {
                document.querySelectorAll('.vx-tab').forEach(function (x) { x.classList.toggle('active', x === t); });
                lastField = null;
                document.getElementById('vxTarget').textContent = 'Click inside a URL or body field first.';
            });
        });

        var pwdBtn = document.getElementById('vxPwdToggle');
        pwdBtn.addEventListener('click', function () {
            var f = document.getElementById('apiPasswordField');
            var show = f.type === 'password';
            f.type = show ? 'text' : 'password';
            pwdBtn.querySelector('i').className = show ? 'fas fa-eye-slash' : 'fas fa-eye';
        });

        document.querySelectorAll('.tab-pane[data-ep]').forEach(function (p) { preview(p.getAttribute('data-ep')); });
    })();
</script>
