@model VIRENDRA.Models.ApiSource

@{
    var responseTypeOptions = new[]
    {
        "JSON (application/json)",
        "FormData (application/x-www-form-urlencoded)",
        "XML (application/xml)",
        "Plain Text (text/plain)"
    };
}

@* URL parameter legend *@
<div class="alert alert-danger py-2 mb-3" style="font-size:0.82rem;">
    <strong>Note:- Please use following naming conventions for the API URLs:-</strong>
    <div class="row mt-1">
        <div class="col-md-4">
            <ul class="mb-0 ps-3">
                <li><code>[UUU]</code> → API user id</li>
                <li><code>[PPP]</code> → API password</li>
                <li><code>[RRR]</code> → any other (like token, remark etc)</li>
                <li><code>[MMM]</code> → mobileNo(Prepaid)/number(BillPay)</li>
                <li><code>[HHH]</code> → account(BillPay)</li>
                <li><code>[NNN]</code> → account other(BillPay)</li>
                <li><code>[VVV]</code> → vendor transaction number</li>
                <li><code>[OOO]</code> → operator code</li>
            </ul>
        </div>
        <div class="col-md-4">
            <ul class="mb-0 ps-3">
                <li><code>[CCC]</code> → Circle code</li>
                <li><code>[AAA]</code> → Amount</li>
                <li><code>[EEE]</code> → Extra Url (in Operator Code setting)</li>
                <li><code>[DDD]</code> → Extra Parameter data</li>
                <li><code>[TTT]</code> → reference transaction number</li>
                <li><code>[FFF1]</code> → optional1</li>
                <li><code>[FFF2]</code> → optional2</li>
                <li><code>[FFF3]</code> → optional3</li>
            </ul>
        </div>
        <div class="col-md-4">
            <ul class="mb-0 ps-3">
                <li><code>[FFF4]</code> → optional4</li>
                <li><code>[FFFT]</code> → current date time</li>
                <li><code>[FFFR]</code> → Random Key for API</li>
                <li><code>[KKK]</code> → Lapu number</li>
                <li><code>[KKKP]</code> → Lapu password</li>
                <li><code>[KKK3]</code> → Lapu pin</li>
                <li><code>[KKK1]</code> → Lapu optional-1</li>
                <li><code>[COMM1]</code> → Common optional-1</li>
            </ul>
        </div>
    </div>
</div>

<div class="row g-0">
    <!-- ===== LEFT: API Source Info ===== -->
    <div class="col-md-3" style="background:#d9d9d9;padding:1.5rem;border-radius:6px 0 0 6px;">
        <h6 class="fw-bold mb-3">API Source Info</h6>

        <div class="mb-3">
            <label class="form-label fw-semibold small">API Name <span class="text-danger">*</span></label>
            @Html.TextBoxFor(m => m.ApiName, new { @class = "form-control form-control-sm" })
            @Html.ValidationMessageFor(m => m.ApiName, "", new { @class = "text-danger small" })
        </div>

        <div class="mb-3">
            <label class="form-label fw-semibold small">API User ID <small class="text-muted">([UUU])</small></label>
            @Html.TextBoxFor(m => m.ApiUserId, new { @class = "form-control form-control-sm" })
        </div>

        <div class="mb-3">
            <label class="form-label fw-semibold small">API Password <small class="text-muted">([PPP])</small></label>
            @Html.TextBoxFor(m => m.ApiPassword, new { @class = "form-control form-control-sm" })
        </div>

        <div class="mb-3">
            <label class="form-label fw-semibold small">Remark <small class="text-muted">([RRR])</small></label>
            @Html.TextBoxFor(m => m.Remark, new { @class = "form-control form-control-sm" })
        </div>

        <div class="mb-2">
            <div class="form-check">
                @Html.CheckBoxFor(m => m.IsAutoStatusCheck, new { @class = "form-check-input" })
                <label class="form-check-label fw-semibold small" for="IsAutoStatusCheck">IsAutoStatusCheck</label>
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label fw-semibold small">Check Time (min)</label>
            @Html.TextBoxFor(m => m.CheckTime, new { @class = "form-control form-control-sm", type = "number", min = "0" })
        </div>

        <div class="mb-3 form-check">
            @Html.CheckBoxFor(m => m.IsActive, new { @class = "form-check-input" })
            <label class="form-check-label fw-semibold small" for="IsActive">IsActive</label>
        </div>
    </div>

    <!-- ===== RIGHT: API URLs ===== -->
    <div class="col-md-9" style="padding:1.5rem;background:#fff;border:1px solid #dee2e6;border-radius:0 6px 6px 0;">
        <h6 class="fw-bold mb-3">API URLs</h6>
        <div class="table-responsive">
            <table class="table table-bordered align-middle mb-0" style="font-size:0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th style="width:30px">#</th>
                        <th style="width:140px">URL</th>
                        <th style="width:80px">Method</th>
                        <th style="width:200px">Response Type</th>
                        <th>Post Data</th>
                    </tr>
                </thead>
                <tbody>
                    @{ int idx = 0; }
                    @foreach (var u in Model.ApiUrls)
                    {
                        <tr>
                            <td class="text-center fw-bold">@(idx + 1)</td>
                            <td>
                                <input type="hidden" name="urlType" value="@u.UrlType" />
                                <label class="form-label fw-semibold d-block mb-1" style="color:#555;">@u.UrlType</label>
                                <textarea name="url" class="form-control form-control-sm" rows="3"
                                          placeholder="e.g. https://api.com/rc?uid=[UUU]&pwd=[PPP]">@u.URL</textarea>
                            </td>
                            <td>
                                <select name="method" class="form-select form-select-sm">
                                    <option value="GET"  @(u.Method == "GET"  ? "selected" : "")>GET</option>
                                    <option value="POST" @(u.Method == "POST" ? "selected" : "")>POST</option>
                                </select>
                            </td>
                            <td>
                                <select name="responseType" class="form-select form-select-sm">
                                    @foreach (var rt in responseTypeOptions)
                                    {
                                        <option value="@rt" @(u.ResType == rt ? "selected" : "")>@rt</option>
                                    }
                                </select>
                            </td>
                            <td>
                                <label class="form-label small text-muted d-block mb-1">Post Data</label>
                                <textarea name="postParameter" class="form-control form-control-sm" rows="3"
                                          placeholder="key1=val1&key2=val2">@u.PostData</textarea>
                            </td>
                        </tr>
                        idx++;
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
