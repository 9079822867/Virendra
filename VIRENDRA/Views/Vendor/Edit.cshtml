@model VIRENDRA.Models.ApiSource

@{
    ViewBag.Title = "Edit Vendor";
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
}

<div class="container-fluid pb-2">

    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
        <div>
            <div class="text-muted small mb-1">
                <a href="@Url.Action("Index")" class="text-decoration-none text-muted"><i class="fas fa-arrow-left me-1"></i>Vendors</a>
            </div>
            <h4 class="mb-0 fw-bold">@Model.ApiName <span class="text-muted fw-normal fs-6">#@Model.Id</span></h4>
        </div>
        <span class="badge rounded-pill @(Model.IsActive ? "bg-success" : "bg-secondary")">@(Model.IsActive ? "Active" : "Inactive")</span>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible mb-3">
            <i class="fas fa-circle-check me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @using (Html.BeginForm("Edit", "Vendor", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.Id)

        if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger mb-3">
                <i class="fas fa-circle-exclamation me-2"></i><strong>Please fix the errors below.</strong>
                @Html.ValidationSummary(true, "", new { @class = "mb-0 mt-1" })
            </div>
        }

        @Html.Partial("_VendorForm", Model)

        @Html.Partial("_VendorSaveBar", "Save changes")
    }
</div>
