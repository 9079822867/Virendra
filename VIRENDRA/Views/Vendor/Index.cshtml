@model IEnumerable<VIRENDRA.Models.Vendor>

@{
    ViewBag.Title = "Vendor List";
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="page-title-box d-sm-flex align-items-center justify-content-between">
                <h4 class="mb-sm-0 font-size-18">Vendor List</h4>
            </div>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible">
            <i class="fas fa-check-circle me-1"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card">
        <div class="card-body">
            <div class="d-flex justify-content-between mb-3">
                <a href="@Url.Action("Create")" class="btn btn-success">
                    <i class="fas fa-plus"></i> Add new +
                </a>
                <button type="button" class="btn btn-success" onclick="refreshAll()">
                    <i class="fas fa-sync-alt"></i> Refresh All
                </button>
            </div>

            <div class="table-responsive">
                <table id="vendorTable" class="table table-bordered table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>VId</th>
                            <th>Vendor Name</th>
                            <th>Remark</th>
                            <th>Active?</th>
                            <th>Balance(INR)</th>
                            <th>vBal(INR)</th>
                            <th>(Balance-vBal)</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var v in Model)
                        {
                            <tr>
                                <td>@v.Id</td>
                                <td>@v.VendorName</td>
                                <td>@v.Remark</td>
                                <td>
                                    <div class="form-check form-switch">
                                        <input class="form-check-input toggle-active" type="checkbox"
                                               data-id="@v.Id"
                                               style="width:60px;height:28px;cursor:pointer;"
                                               @(v.IsActive ? "checked" : "") />
                                        <label class="toggle-label ms-1 fw-bold @(v.IsActive ? "text-success" : "text-danger")">
                                            @(v.IsActive ? "ON" : "OFF")
                                        </label>
                                    </div>
                                </td>
                                <td>@v.Balance.ToString("0.##")</td>
                                <td>@v.VBal.ToString("0.##")</td>
                                <td>@((v.Balance - v.VBal).ToString("0.##"))</td>
                                <td>
                                    <div class="d-flex gap-1 flex-wrap">
                                        <button type="button" class="btn btn-success btn-sm" title="Refresh Balance"
                                                onclick="refreshBalance(@v.Id)">
                                            <i class="fas fa-sync-alt"></i>
                                        </button>
                                        <a href="@Url.Action("Edit", new { id = v.Id })" class="btn btn-info btn-sm" title="Edit">
                                            <i class="fas fa-pencil-alt"></i>
                                        </a>
                                        <button type="button" class="btn btn-success btn-sm" title="Add Balance"
                                                onclick="addBalance(@v.Id)">
                                            <i class="fas fa-plus"></i>
                                        </button>
                                        <button type="button" class="btn btn-danger btn-sm" title="Delete"
                                                onclick="confirmDelete(@v.Id, '@v.VendorName')">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                        <a href="@Url.Action("Edit", new { id = v.Id })" class="btn btn-primary btn-sm" title="URL Settings">
                                            <i class="fas fa-cog"></i>
                                        </a>
                                        <a href="@Url.Action("Edit", new { id = v.Id })" class="btn btn-primary btn-sm" title="Settings">
                                            <i class="fas fa-cog"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirm Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fas fa-exclamation-triangle text-danger me-2"></i>Confirm Delete</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                Delete vendor <strong id="deleteVendorName"></strong>?
            </div>
            <div class="modal-footer">
                @using (Html.BeginForm("Delete", "Vendor", FormMethod.Post, new { id = "deleteForm" }))
                {
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="deleteVendorId" />
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger"><i class="fas fa-trash me-1"></i>Delete</button>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css">
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

    <script>
        $(function () {
            $('#vendorTable').DataTable({ pageLength: 25, order: [[0, 'desc']] });

            // Toggle active
            $(document).on('change', '.toggle-active', function () {
                var id = $(this).data('id');
                var isActive = $(this).is(':checked');
                var label = $(this).siblings('.toggle-label');

                $.post('@Url.Action("ToggleActive")', { id: id, isActive: isActive }, function (res) {
                    if (res.success) {
                        label.text(isActive ? 'ON' : 'OFF')
                             .removeClass('text-success text-danger')
                             .addClass(isActive ? 'text-success' : 'text-danger');
                    }
                });
            });
        });

        function confirmDelete(id, name) {
            document.getElementById('deleteVendorId').value = id;
            document.getElementById('deleteVendorName').textContent = name;
            new bootstrap.Modal(document.getElementById('deleteModal')).show();
        }

        function refreshBalance(id) {
            alert('Refresh balance for vendor #' + id + ' — wire up to vendor API.');
        }

        function refreshAll() {
            alert('Refresh all vendor balances — wire up to vendor APIs.');
        }

        function addBalance(id) {
            alert('Add balance to vendor #' + id);
        }
    </script>
}
