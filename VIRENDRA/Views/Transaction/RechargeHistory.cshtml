@model VIRENDRA.Models.RechargeHistoryViewModel
@using VIRENDRA.Models
@{
    ViewBag.Title = "Recharge History";
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
    bool canChangeStatus = ViewBag.CanChangeStatus == true;
    int colCount = canChangeStatus ? 9 : 8;
}

<div class="history-page">
    <div class="page-title-box d-sm-flex align-items-center justify-content-between">
        <h4 class="mb-sm-0 font-size-18">Recharge History</h4>
        <div class="page-title-right">
            <ol class="breadcrumb m-0">
                <li class="breadcrumb-item"><a href="javascript:void(0);">Transaction</a></li>
                <li class="breadcrumb-item active">Recharge History</li>
            </ol>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible mb-3" style="border-radius:10px;">
            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible mb-3" style="border-radius:10px;">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <form class="history-filter" method="get" action="@Url.Action("RechargeHistory", "Transaction")">
        <div class="row g-3 align-items-center">
            <div class="col-lg-2 col-md-4">
                <input type="date" name="fromDate" class="form-control" value="@Model.FromDate.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-lg-2 col-md-4">
                <input type="date" name="toDate" class="form-control" value="@Model.ToDate.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-lg-2 col-md-4">
                <select name="status" class="form-select">
                    <option value="">All Status</option>
                    <option value="Success" @(Model.Status == "Success" ? "selected" : "")>Success</option>
                    <option value="Pending" @(Model.Status == "Pending" ? "selected" : "")>Pending</option>
                    <option value="Failed" @(Model.Status == "Failed" ? "selected" : "")>Failed</option>
                </select>
            </div>
            <div class="col-lg-3 col-md-6">
                <input type="text" name="searchText" class="form-control" value="@Model.SearchText" placeholder="Txn ID, number, operator" />
            </div>
            <div class="col-lg-1 col-md-3">
                <button type="submit" class="btn btn-history-search w-100">Search</button>
            </div>
            <div class="col-lg-1 col-md-3">
                <a href="@Url.Action("RechargeHistory", "Transaction")" class="btn btn-history-reset w-100">Reset</a>
            </div>
        </div>
    </form>

    <hr class="history-divider" />

    <div class="table-responsive history-table-wrap">
        <table class="table history-table mb-0">
            <thead>
                <tr>
                    <th>Sr.No</th>
                    <th>Txn ID</th>
                    <th>Number</th>
                    <th>Operator</th>
                    <th class="text-end">Amount</th>
                    <th class="text-end">Commission</th>
                    <th>Status</th>
                    <th>Date</th>
                    @if (canChangeStatus)
                    {
                        <th class="text-center">Action</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@item.SrNo</td>
                        <td>@item.TxnId</td>
                        <td>@item.Number</td>
                        <td>@item.Operator</td>
                        <td class="text-end">@item.Amount.ToString("0.00")</td>
                        <td class="text-end">@item.Commission.ToString("0.00")</td>
                        <td><span class="status-badge status-@item.Status.ToLower()">@item.Status</span></td>
                        <td>@item.Date.ToString("dd MMM yyyy hh:mm tt")</td>
                        @if (canChangeStatus)
                        {
                            <td class="text-center">
                                @if (item.StatusId != RechargeStatusCodes.FAILED)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-primary js-change-status"
                                            data-recid="@item.RecId" data-status="@item.StatusId"
                                            data-number="@item.Number" data-amount="@item.Amount.ToString("0.00")"
                                            data-apitxn="@item.ApiTxnId">
                                        Change
                                    </button>
                                }
                                else
                                {
                                    <span class="text-muted small">Final</span>
                                }
                            </td>
                        }
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="4" class="text-success fw-semibold">Row Count @Model.TotalCount</td>
                    <td class="text-end">&#8377; @Model.TotalAmount.ToString("0.00")</td>
                    <td class="text-end text-success">&#8377; @Model.TotalCommission.ToString("0.00")</td>
                    <td colspan="@(colCount - 6)"></td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>

@if (canChangeStatus)
{
    <div class="modal fade" id="changeStatusModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <form class="modal-content" method="post" action="@Url.Action("ChangeStatus", "Transaction")" id="changeStatusForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="recId" id="csRecId" />
                <input type="hidden" name="returnUrl" value="@Request.RawUrl" />

                <div class="modal-header">
                    <h5 class="modal-title">Change Recharge Status</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-3 small text-muted" id="csInfo"></p>

                    <div class="mb-3">
                        <label class="form-label" for="csStatus">New Status</label>
                        <select name="statusId" id="csStatus" class="form-select" required>
                            <option value="@RechargeStatusCodes.SUCCESS">Success</option>
                            <option value="@RechargeStatusCodes.PROCESS">Pending</option>
                            <option value="@RechargeStatusCodes.FAILED">Failed (refund to wallet)</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="csApiTxn">Operator / API Txn ID</label>
                        <input type="text" name="apiTxnId" id="csApiTxn" class="form-control" maxlength="50" />
                    </div>
                    <div class="mb-0">
                        <label class="form-label" for="csMsg">Remark</label>
                        <input type="text" name="statusMsg" class="form-control" maxlength="150" placeholder="Reason for change" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Update Status</button>
                </div>
            </form>
        </div>
    </div>
}

@section Scripts {
    @if (canChangeStatus)
    {
        <script>
            (function () {
                var modalEl = document.getElementById('changeStatusModal');
                var modal = new bootstrap.Modal(modalEl);
                var statusSel = document.getElementById('csStatus');

                document.querySelectorAll('.js-change-status').forEach(function (btn) {
                    btn.addEventListener('click', function () {
                        var current = btn.getAttribute('data-status');
                        document.getElementById('csRecId').value = btn.getAttribute('data-recid');
                        document.getElementById('csApiTxn').value = btn.getAttribute('data-apitxn') || '';
                        document.getElementById('csInfo').textContent =
                            'Number ' + btn.getAttribute('data-number') + ' • Amount ₹' + btn.getAttribute('data-amount');

                        // Current status cannot be re-selected
                        Array.prototype.forEach.call(statusSel.options, function (o) {
                            o.disabled = (o.value === current);
                        });
                        var firstFree = Array.prototype.find.call(statusSel.options, function (o) { return !o.disabled; });
                        if (firstFree) statusSel.value = firstFree.value;

                        modal.show();
                    });
                });

                document.getElementById('changeStatusForm').addEventListener('submit', function (e) {
                    var label = statusSel.options[statusSel.selectedIndex].text;
                    if (!confirm('Change this recharge to "' + label + '"?')) e.preventDefault();
                });
            })();
        </script>
    }
}

@Html.Partial("_HistoryStyles")
