@model VIRENDRA.Models.RechargeHistoryViewModel
@using VIRENDRA.Models
@{
    ViewBag.Title = "Recharge History";
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
    bool canChangeStatus = ViewBag.CanChangeStatus == true;
    bool showVendor = ViewBag.ShowVendor == true;
    bool showUser = ViewBag.ShowUser == true;
    int extra = (showVendor ? 1 : 0) + (showUser ? 1 : 0);
    int colCount = 9 + extra;
    int leadCols = 4 + extra;   // columns before Amount
}

<div class="history-page">
    <div class="page-title-box d-sm-flex align-items-center justify-content-between">
        <h4 class="mb-sm-0 font-size-18">Recharge History</h4>
        <div class="page-title-right">
            <ol class="breadcrumb m-0">
                <li class="breadcrumb-item"><a href="javascript:void(0);">Transaction</a></li>
                <li class="breadcrumb-item active">Recharge History</li>
            </ol>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible mb-3" style="border-radius:10px;">
            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible mb-3" style="border-radius:10px;">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <form class="history-filter" method="get" action="@Url.Action("RechargeHistory", "Transaction")">
        <div class="row g-3 align-items-center">
            <div class="col-lg-2 col-md-4">
                <input type="date" name="fromDate" class="form-control" value="@Model.FromDate.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-lg-2 col-md-4">
                <input type="date" name="toDate" class="form-control" value="@Model.ToDate.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-lg-2 col-md-4">
                <select name="status" class="form-select">
                    <option value="">All Status</option>
                    <option value="Success" @(Model.Status == "Success" ? "selected" : "")>Success</option>
                    <option value="Pending" @(Model.Status == "Pending" ? "selected" : "")>Pending</option>
                    <option value="Failed" @(Model.Status == "Failed" ? "selected" : "")>Failed</option>
                </select>
            </div>
            <div class="col-lg-3 col-md-6">
                <input type="text" name="searchText" class="form-control" value="@Model.SearchText" placeholder="@(showUser ? "Txn ID, number, operator, user" : "Txn ID, number, operator")" />
            </div>
            <div class="col-lg-1 col-md-3">
                <button type="submit" class="btn btn-history-search w-100">Search</button>
            </div>
            <div class="col-lg-1 col-md-3">
                <a href="@Url.Action("RechargeHistory", "Transaction")" class="btn btn-history-reset w-100">Reset</a>
            </div>
        </div>
    </form>

    <hr class="history-divider" />

    <div class="table-responsive history-table-wrap">
        <table class="table history-table mb-0">
            <thead>
                <tr>
                    <th>Sr.No</th>
                    <th>Txn ID</th>
                    @if (showUser)
                    {
                        <th>User</th>
                    }
                    <th>Number</th>
                    <th>Operator</th>
                    @if (showVendor)
                    {
                        <th>Vendor</th>
                    }
                    <th class="text-end">Amount</th>
                    <th class="text-end">Commission</th>
                    <th>Status</th>
                    <th>Date</th>
                    <th class="text-center">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@item.SrNo</td>
                        <td>@item.TxnId</td>
                        @if (showUser)
                        {
                            <td>
                                <div class="fw-semibold">@item.UserName</div>
                                @if (!string.IsNullOrEmpty(item.UserMobile) && item.UserMobile != item.UserName)
                                {
                                    <small class="text-muted">@item.UserMobile</small>
                                }
                            </td>
                        }
                        <td>@item.Number</td>
                        <td>@item.Operator</td>
                        @if (showVendor)
                        {
                            <td>@item.VendorName</td>
                        }
                        <td class="text-end">@item.Amount.ToString("0.00")</td>
                        <td class="text-end">@item.Commission.ToString("0.00")</td>
                        <td><span class="status-badge status-@item.Status.ToLower()">@item.Status</span></td>
                        <td>@item.Date.ToString("dd MMM yyyy hh:mm tt")</td>
                        <td class="text-center text-nowrap">
                            @if (item.HasComplaint)
                            {
                                <a class="btn btn-sm btn-outline-secondary"
                                   href="@Url.Action("ComplaintReport", "Transaction", new { searchText = item.RecId, fromDate = item.Date.AddDays(-1).ToString("yyyy-MM-dd") })">
                                    Complained
                                </a>
                            }
                            else if (item.StatusId == RechargeStatusCodes.SUCCESS)
                            {
                                <button type="button" class="btn btn-sm btn-outline-warning js-complain"
                                        data-recid="@item.RecId" data-number="@item.Number"
                                        data-amount="@item.Amount.ToString("0.00")" data-txn="@item.TxnId">
                                    Complain
                                </button>
                            }
                            @if (canChangeStatus)
                            {
                                if (item.StatusId != RechargeStatusCodes.FAILED)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-primary js-change-status"
                                            data-recid="@item.RecId" data-status="@item.StatusId"
                                            data-number="@item.Number" data-amount="@item.Amount.ToString("0.00")"
                                            data-apitxn="@item.ApiTxnId">
                                        Change
                                    </button>
                                }
                                else if (!item.HasComplaint)
                                {
                                    <span class="text-muted small">Final</span>
                                }
                                <button type="button" class="btn btn-sm btn-outline-info js-reqres"
                                        data-recid="@item.RecId" data-number="@item.Number"
                                        data-amount="@item.Amount.ToString("0.00")">
                                    Logs
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="@leadCols" class="text-success fw-semibold">Row Count @Model.TotalCount</td>
                    <td class="text-end">&#8377; @Model.TotalAmount.ToString("0.00")</td>
                    <td class="text-end text-success">&#8377; @Model.TotalCommission.ToString("0.00")</td>
                    <td colspan="@(colCount - leadCols - 2)"></td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>

<div class="modal fade" id="complainModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form class="modal-content" method="post" action="@Url.Action("CreateComplaint", "Transaction")" id="complainForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="recId" id="cpRecId" />
            <input type="hidden" name="returnUrl" value="@Request.RawUrl" />

            <div class="modal-header">
                <h5 class="modal-title">Book Complaint</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="mb-3 small text-muted" id="cpInfo"></p>
                <label class="form-label" for="cpRemark">What went wrong?</label>
                <textarea name="remark" id="cpRemark" class="form-control" rows="3" maxlength="500" required
                          placeholder="e.g. Recharge shows success but not credited to the customer"></textarea>
                <div class="form-text">One complaint per recharge. It is also forwarded to the vendor.</div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-warning">Submit Complaint</button>
            </div>
        </form>
    </div>
</div>

@if (canChangeStatus)
{
    <div class="modal fade" id="changeStatusModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <form class="modal-content" method="post" action="@Url.Action("ChangeStatus", "Transaction")" id="changeStatusForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="recId" id="csRecId" />
                <input type="hidden" name="returnUrl" value="@Request.RawUrl" />

                <div class="modal-header">
                    <h5 class="modal-title">Change Recharge Status</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-3 small text-muted" id="csInfo"></p>

                    <div class="mb-3">
                        <label class="form-label" for="csStatus">New Status</label>
                        <select name="statusId" id="csStatus" class="form-select" required>
                            <option value="@RechargeStatusCodes.SUCCESS">Success</option>
                            <option value="@RechargeStatusCodes.PENDING">Pending</option>
                            <option value="@RechargeStatusCodes.FAILED">Failed (refund to wallet)</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="csApiTxn">Operator / API Txn ID</label>
                        <input type="text" name="apiTxnId" id="csApiTxn" class="form-control" maxlength="50" />
                    </div>
                    <div class="mb-0">
                        <label class="form-label" for="csMsg">Remark</label>
                        <input type="text" name="statusMsg" class="form-control" maxlength="150" placeholder="Reason for change" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Update Status</button>
                </div>
            </form>
        </div>
    </div>

    <div class="modal fade" id="reqResModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-xl modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Request / Response Log</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-3 small text-muted" id="rrInfo"></p>
                    <div class="table-responsive">
                        <table class="table table-sm table-bordered mb-0 reqres-table">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Date</th>
                                    <th>Type</th>
                                    <th>Vendor</th>
                                    <th>Ref / Remark</th>
                                    <th>Request</th>
                                    <th>Response</th>
                                </tr>
                            </thead>
                            <tbody id="rrBody"></tbody>
                        </table>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>
    <style>
        .reqres-table td { vertical-align: top; font-size: 12px; }
        .reqres-table pre { white-space: pre-wrap; word-break: break-all; max-height: 220px; overflow: auto; margin: 0; font-size: 11px; }
    </style>
}

@section Scripts {
    <script>
        (function () {
            var modal = new bootstrap.Modal(document.getElementById('complainModal'));
            document.querySelectorAll('.js-complain').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    document.getElementById('cpRecId').value = btn.getAttribute('data-recid');
                    document.getElementById('cpRemark').value = '';
                    document.getElementById('cpInfo').textContent =
                        'Recharge #' + btn.getAttribute('data-recid') + ' • Number ' + btn.getAttribute('data-number') +
                        ' • Amount ₹' + btn.getAttribute('data-amount');
                    modal.show();
                });
            });
        })();
    </script>
    @if (canChangeStatus)
    {
        <script>
            (function () {
                var modalEl = document.getElementById('changeStatusModal');
                var modal = new bootstrap.Modal(modalEl);
                var statusSel = document.getElementById('csStatus');

                document.querySelectorAll('.js-change-status').forEach(function (btn) {
                    btn.addEventListener('click', function () {
                        var current = btn.getAttribute('data-status');
                        document.getElementById('csRecId').value = btn.getAttribute('data-recid');
                        document.getElementById('csApiTxn').value = btn.getAttribute('data-apitxn') || '';
                        document.getElementById('csInfo').textContent =
                            'Number ' + btn.getAttribute('data-number') + ' • Amount ₹' + btn.getAttribute('data-amount');

                        // Current status cannot be re-selected
                        Array.prototype.forEach.call(statusSel.options, function (o) {
                            o.disabled = (o.value === current);
                        });
                        var firstFree = Array.prototype.find.call(statusSel.options, function (o) { return !o.disabled; });
                        if (firstFree) statusSel.value = firstFree.value;

                        modal.show();
                    });
                });

                document.getElementById('changeStatusForm').addEventListener('submit', function (e) {
                    var label = statusSel.options[statusSel.selectedIndex].text;
                    if (!confirm('Change this recharge to "' + label + '"?')) e.preventDefault();
                });
            })();

            (function () {
                var modal = new bootstrap.Modal(document.getElementById('reqResModal'));
                var body = document.getElementById('rrBody');
                var url = '@Url.Action("RequestResponseLog", "Transaction")';

                function cell(text, asPre) {
                    var td = document.createElement('td');
                    var el = asPre ? document.createElement('pre') : td;
                    el.textContent = text == null || text === '' ? '-' : text;
                    if (asPre) td.appendChild(el);
                    return td;
                }

                function message(text) {
                    body.innerHTML = '';
                    var tr = document.createElement('tr');
                    var td = cell(text);
                    td.colSpan = 7;
                    td.className = 'text-center text-muted';
                    tr.appendChild(td);
                    body.appendChild(tr);
                }

                document.querySelectorAll('.js-reqres').forEach(function (btn) {
                    btn.addEventListener('click', function () {
                        var recId = btn.getAttribute('data-recid');
                        document.getElementById('rrInfo').textContent =
                            'Recharge #' + recId + ' • Number ' + btn.getAttribute('data-number') +
                            ' • Amount ₹' + btn.getAttribute('data-amount');
                        message('Loading...');
                        modal.show();

                        fetch(url + '?recId=' + encodeURIComponent(recId), { credentials: 'same-origin' })
                            .then(function (r) { return r.json(); })
                            .then(function (res) {
                                if (!res.ok) { message(res.message || 'Failed to load log.'); return; }
                                if (!res.rows.length) { message('No request/response found for this recharge.'); return; }
                                body.innerHTML = '';
                                res.rows.forEach(function (row, i) {
                                    var tr = document.createElement('tr');
                                    tr.appendChild(cell(i + 1));
                                    tr.appendChild(cell(row.AddedDate));
                                    tr.appendChild(cell(row.UrlType));
                                    tr.appendChild(cell(row.VendorName));
                                    tr.appendChild(cell([row.RefId, row.Remark].filter(Boolean).join(' / ')));
                                    tr.appendChild(cell(row.RequestTxt, true));
                                    tr.appendChild(cell(row.ResponseText, true));
                                    body.appendChild(tr);
                                });
                            })
                            .catch(function () { message('Failed to load log.'); });
                    });
                });
            })();
        </script>
    }
}

@Html.Partial("_HistoryStyles")
