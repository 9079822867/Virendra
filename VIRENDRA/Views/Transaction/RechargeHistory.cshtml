@model VIRENDRA.Models.RechargeHistoryViewModel
@{
    ViewBag.Title = "Recharge History";
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
}

<div class="history-page">
    <div class="page-title-box d-sm-flex align-items-center justify-content-between">
        <h4 class="mb-sm-0 font-size-18">Recharge History</h4>
        <div class="page-title-right">
            <ol class="breadcrumb m-0">
                <li class="breadcrumb-item"><a href="javascript:void(0);">Transaction</a></li>
                <li class="breadcrumb-item active">Recharge History</li>
            </ol>
        </div>
    </div>

    <form class="history-filter" method="get" action="@Url.Action("RechargeHistory", "Transaction")">
        <div class="row g-3 align-items-center">
            <div class="col-lg-2 col-md-4">
                <input type="date" name="fromDate" class="form-control" value="@Model.FromDate.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-lg-2 col-md-4">
                <input type="date" name="toDate" class="form-control" value="@Model.ToDate.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-lg-2 col-md-4">
                <select name="status" class="form-select">
                    <option value="">All Status</option>
                    <option value="Success" @(Model.Status == "Success" ? "selected" : "")>Success</option>
                    <option value="Pending" @(Model.Status == "Pending" ? "selected" : "")>Pending</option>
                    <option value="Failed" @(Model.Status == "Failed" ? "selected" : "")>Failed</option>
                </select>
            </div>
            <div class="col-lg-3 col-md-6">
                <input type="text" name="searchText" class="form-control" value="@Model.SearchText" placeholder="Txn ID, number, operator" />
            </div>
            <div class="col-lg-1 col-md-3">
                <button type="submit" class="btn btn-history-search w-100">Search</button>
            </div>
            <div class="col-lg-1 col-md-3">
                <a href="@Url.Action("RechargeHistory", "Transaction")" class="btn btn-history-reset w-100">Reset</a>
            </div>
        </div>
    </form>

    <hr class="history-divider" />

    <div class="table-responsive history-table-wrap">
        <table class="table history-table mb-0">
            <thead>
                <tr>
                    <th>Sr.No</th>
                    <th>Txn ID</th>
                    <th>Number</th>
                    <th>Operator</th>
                    <th class="text-end">Amount</th>
                    <th class="text-end">Commission</th>
                    <th>Status</th>
                    <th>Date</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@item.SrNo</td>
                        <td>@item.TxnId</td>
                        <td>@item.Number</td>
                        <td>@item.Operator</td>
                        <td class="text-end">@item.Amount.ToString("0.00")</td>
                        <td class="text-end">@item.Commission.ToString("0.00")</td>
                        <td><span class="status-badge status-@item.Status.ToLower()">@item.Status</span></td>
                        <td>@item.Date.ToString("dd MMM yyyy hh:mm tt")</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="4" class="text-success fw-semibold">Row Count @Model.TotalCount</td>
                    <td class="text-end">&#8377; @Model.TotalAmount.ToString("0.00")</td>
                    <td class="text-end text-success">&#8377; @Model.TotalCommission.ToString("0.00")</td>
                    <td colspan="2"></td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>

@Html.Partial("_HistoryStyles")
