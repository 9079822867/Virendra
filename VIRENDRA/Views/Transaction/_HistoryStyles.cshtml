<style>
    /* Shared by the report pages (Recharge History, Ledger, Outstanding, Complaints…).
       Colours come from the theme tokens so light and dark both work. */
    .history-page { color: var(--ink); }
    .history-page .page-title-box { margin-bottom: 1.25rem; }

    .history-filter .form-control,
    .history-filter .form-select {
        border: 1px solid var(--line-2);
        border-radius: var(--radius-sm);
        background-color: var(--surface);
        color: var(--ink);
        box-shadow: none;
        font-size: .86rem;
    }
    .history-filter .form-control::placeholder { color: var(--muted); }
    [data-theme="dark"] .history-filter input[type="date"] { color-scheme: dark; }

    .history-divider { display: none; }

    .history-table-wrap { background: var(--surface); }
    .history-table { background: var(--surface); color: var(--ink); font-size: .86rem; }
    .history-table > :not(caption) > * > * { background-color: transparent; color: var(--ink); }
    .history-table th { white-space: nowrap; border-bottom: 1px solid var(--line); }
    .history-table td { vertical-align: middle; white-space: nowrap; border-bottom: 1px solid var(--line); }
    .history-table tbody tr:hover > * { background-color: var(--soft); }
    .history-table tfoot td { font-weight: 600; border-bottom: 0; background: var(--soft); }

    .status-badge, .type-badge {
        border-radius: 999px; display: inline-block; font-size: .72rem; font-weight: 700;
        padding: 3px 10px; text-align: center;
    }
    .status-success, .type-credit, .type-commission, .type-refund { background: var(--ok-soft); color: var(--ok); }
    .status-pending, .status-hold { background: var(--warn-soft); color: var(--warn); }
    .status-failed, .type-debit { background: var(--bad-soft); color: var(--bad); }
</style>
