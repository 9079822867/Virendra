@model IEnumerable<VIRENDRA.Models.PackageComm>
@{
    var pkg = (VIRENDRA.Models.Package)ViewBag.Package;
    ViewBag.Title = "Commission \u2014 " + pkg.PackageName;
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
}

<div class="container-fluid">
    <div class="page-title-box d-sm-flex align-items-center justify-content-between mb-3">
        <h4 class="mb-sm-0">Commission: <strong>@pkg.PackageName</strong></h4>
        <a href="@Url.Action("Index", "Package")" class="btn btn-light"><i class="fas fa-arrow-left"></i> Packages</a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible">@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @using (Html.BeginForm("SaveAll", "PackageComm", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        <input type="hidden" name="packageId" value="@pkg.Id" />

        <div class="card">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-bordered align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Operator</th>
                                <th>Code</th>
                                <th>Type</th>
                                <th style="width:130px">Comm Type</th>
                                <th style="width:140px">Comm Value</th>
                                <th class="text-center" style="width:90px">Active</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ int i = 0; }
                            @foreach (var row in Model)
                            {
                                <tr>
                                    <td><strong>@row.OperatorName</strong></td>
                                    <td><code>@(row.OperatorCode ?? "-")</code></td>
                                    <td><span class="badge bg-info text-dark">@(row.OperatorType ?? "-")</span></td>
                                    <td>
                                        <input type="hidden" name="operatorId" value="@row.OperatorId" />
                                        <select name="commType" class="form-select form-select-sm">
                                            <option value="P" @(row.CommType == "P" ? "selected" : "")>% Percent</option>
                                            <option value="F" @(row.CommType == "F" ? "selected" : "")>&#8377; Flat</option>
                                        </select>
                                    </td>
                                    <td>
                                        <input type="number" name="commValue" value="@row.CommValue"
                                               class="form-control form-control-sm" step="0.0001" min="0" />
                                    </td>
                                    <td class="text-center">
                                        <input type="checkbox" name="isActive" value="true"
                                               class="form-check-input"
                                               @(row.IsActive ? "checked" : "") />
                                    </td>
                                </tr>
                                i++;
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="card-footer d-flex gap-2">
                <button type="submit" class="btn btn-success"><i class="fas fa-save"></i> Save All Commissions</button>
                <a href="@Url.Action("Index", "Package")" class="btn btn-light">Cancel</a>
            </div>
        </div>
    }
</div>
