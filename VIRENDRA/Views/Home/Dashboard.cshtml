@{
    ViewBag.Title = "Dashboard";
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";

    var stats  = ViewBag.Stats as VIRENDRA.Models.DashboardStats ?? new VIRENDRA.Models.DashboardStats();
    var recent = ViewBag.RecentRecharges as List<VIRENDRA.Models.RechargeHistoryItem> ?? new List<VIRENDRA.Models.RechargeHistoryItem>();

    byte roleId    = (byte)(Session["RoleId"] ?? (byte)0);
    bool isAdmin   = roleId == 1 || roleId == 2;
    bool isRetailer = roleId == 4;
    string uname   = (Session["Username"] ?? "").ToString();

    int hour = DateTime.Now.Hour;
    string greeting = hour < 12 ? "Good morning" : hour < 17 ? "Good afternoon" : "Good evening";

    int settled = stats.SuccessCount + stats.FailedCount;
    int successRate = settled > 0 ? (int)Math.Round(stats.SuccessCount * 100.0 / settled) : 0;
    decimal change = stats.ClosingBalance - stats.OpeningBalance;
}

<style>
    .dash-hero { display:grid; grid-template-columns: 1.4fr 1fr; gap:16px; margin-bottom:16px; }
    .dash-balance { background:var(--side-bg); color:#e2e8f0; border-radius:var(--radius); padding:22px 24px; position:relative; overflow:hidden; }
    .dash-balance::after { content:""; position:absolute; right:-40px; bottom:-40px; width:180px; height:180px; border-radius:50%; border:28px solid rgba(94,234,212,.08); }
    .dash-balance .lbl { font-size:.74rem; text-transform:uppercase; letter-spacing:.08em; color:#94a3b8; }
    .dash-balance .amt { font-size:2.2rem; font-weight:800; color:#fff; letter-spacing:-.03em; margin:4px 0 10px; }
    .dash-balance .row-mini { display:flex; gap:28px; font-size:.8rem; color:#94a3b8; }
    .dash-balance .row-mini b { display:block; color:#e2e8f0; font-size:.95rem; }
    .dash-delta { font-size:.78rem; font-weight:700; padding:2px 8px; border-radius:999px; }
    .dash-delta.up { background:rgba(34,197,94,.15); color:#4ade80; }
    .dash-delta.down { background:rgba(248,113,113,.15); color:#f87171; }
    .dash-rate { background:var(--surface); border:1px solid var(--line); border-radius:var(--radius); padding:20px 22px; display:flex; flex-direction:column; justify-content:space-between; }
    .rate-bar { height:10px; border-radius:999px; background:var(--bad-soft); overflow:hidden; display:flex; }
    .rate-bar span { background:var(--ok); }
    .rate-legend { display:flex; gap:16px; font-size:.76rem; color:var(--muted); }
    .rate-legend i { display:inline-block; width:8px; height:8px; border-radius:2px; margin-right:5px; }
    .quick a { display:flex; align-items:center; gap:10px; padding:12px 14px; border:1px solid var(--line); border-radius:var(--radius); background:var(--surface); color:var(--ink); text-decoration:none; font-weight:600; font-size:.84rem; }
    .quick a:hover { border-color:var(--accent); color:var(--accent-ink); }
    .quick a i { color:var(--accent-ink); }
    .op-dot { width:28px; height:28px; border-radius:8px; display:grid; place-items:center; background:var(--soft); border:1px solid var(--line); font-size:.7rem; font-weight:800; color:var(--ink-2); }
    @@media (max-width: 991.98px) { .dash-hero { grid-template-columns:1fr; } }
</style>

<div class="page-head">
    <div>
        <h4>@greeting@(string.IsNullOrEmpty(uname) ? "" : ", " + uname)</h4>
        <div class="text-muted small">
            Here's how today is going @(isAdmin ? "across all users" : "")
            &middot; @DateTime.Now.ToString("dddd, dd MMM yyyy")
        </div>
    </div>
    @if (isRetailer)
    {
        <a href="@Url.Action("Index","Recharge")" class="btn btn-dark"><i class="fas fa-bolt me-1"></i>New recharge</a>
    }
</div>

<div class="dash-hero">
    <div class="dash-balance">
        <div class="d-flex align-items-center justify-content-between">
            <span class="lbl">Wallet balance</span>
            <span class="dash-delta @(change >= 0 ? "up" : "down")">
                @(change >= 0 ? "+" : "−")&#8377;@Math.Abs(change).ToString("N2") today
            </span>
        </div>
        <div class="amt">&#8377;@stats.ClosingBalance.ToString("N2")</div>
        <div class="row-mini">
            <span>Opening<b>&#8377;@stats.OpeningBalance.ToString("N2")</b></span>
            <span>Credited today<b>&#8377;@stats.CreditBalance.ToString("N2")</b></span>
            <span>Earned today<b>&#8377;@stats.TodayEarning.ToString("N2")</b></span>
        </div>
    </div>

    <div class="dash-rate">
        <div class="d-flex justify-content-between align-items-start">
            <div>
                <div class="stat-label">Success rate today</div>
                <div class="stat-value">@(settled > 0 ? successRate + "%" : "—")</div>
            </div>
            <div class="text-end">
                <div class="stat-label">Pending</div>
                <div class="stat-value" style="font-size:1.1rem;">@stats.PendingCount</div>
            </div>
        </div>
        <div>
            <div class="rate-bar my-2"><span style="width:@(settled > 0 ? successRate : 0)%"></span></div>
            <div class="rate-legend">
                <span><i style="background:var(--ok)"></i>@stats.SuccessCount success</span>
                <span><i style="background:var(--bad-soft);border:1px solid #fecaca"></i>@stats.FailedCount failed</span>
                <span>@stats.TotalTxnCount total</span>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-xl-3 col-sm-6">
        <div class="stat">
            <div class="d-flex justify-content-between"><span class="stat-label">Successful</span><span class="stat-ic ok"><i class="fas fa-check"></i></span></div>
            <div class="stat-value">&#8377;@stats.SuccessAmount.ToString("N2")</div>
            <div class="stat-note">@stats.SuccessCount recharge(s)</div>
        </div>
    </div>
    <div class="col-xl-3 col-sm-6">
        <div class="stat">
            <div class="d-flex justify-content-between"><span class="stat-label">Failed</span><span class="stat-ic bad"><i class="fas fa-xmark"></i></span></div>
            <div class="stat-value">&#8377;@stats.FailedAmount.ToString("N2")</div>
            <div class="stat-note">@stats.FailedCount recharge(s), refunded to wallet</div>
        </div>
    </div>
    <div class="col-xl-3 col-sm-6">
        <div class="stat">
            <div class="d-flex justify-content-between"><span class="stat-label">Refunds</span><span class="stat-ic warn"><i class="fas fa-rotate-left"></i></span></div>
            <div class="stat-value">&#8377;@stats.RefundAmount.ToString("N2")</div>
            <div class="stat-note">Credited back today</div>
        </div>
    </div>
    <div class="col-xl-3 col-sm-6">
        <div class="stat">
            <div class="d-flex justify-content-between"><span class="stat-label">Commission</span><span class="stat-ic"><i class="fas fa-percent"></i></span></div>
            <div class="stat-value">&#8377;@stats.TodayEarning.ToString("N2")</div>
            <div class="stat-note">@(isAdmin ? "Paid to users on today's recharges" : "On today's successful recharges")</div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-xl-9">
        <div class="card">
            <div class="card-header d-flex align-items-center justify-content-between">
                <span>Latest recharges</span>
                <a href="@Url.Action("RechargeHistory","Transaction")" class="btn btn-sm btn-light">View all</a>
            </div>
            @if (!recent.Any())
            {
                <div class="text-center py-5 text-muted">
                    <i class="fas fa-inbox fa-2x mb-2 d-block opacity-50"></i>
                    No recharges yet.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Number</th>
                                <th>Operator</th>
                                <th>Reference</th>
                                <th class="text-end">Amount</th>
                                <th class="text-end">Comm.</th>
                                <th>Status</th>
                                <th>Time</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in recent)
                            {
                                string st = (r.Status ?? "").ToLowerInvariant();
                                string cls = st == "success" ? "status-success" : st == "failed" ? "status-failed" : "status-pending";
                                string op = r.Operator ?? "-";
                                <tr>
                                    <td>
                                        <div class="fw-semibold">@r.Number</div>
                                        <small class="text-muted">@(r.TxnId ?? "—")</small>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="op-dot">@(op.Length > 1 ? op.Substring(0, 2).ToUpperInvariant() : op)</span>@op
                                        </div>
                                    </td>
                                    <td>
                                        <code class="small">@(r.OurRefTxnId ?? "—")</code>
                                        @if (!string.IsNullOrEmpty(r.ApiTxnId))
                                        {
                                            <div><small class="text-muted">@r.ApiTxnId</small></div>
                                        }
                                    </td>
                                    <td class="text-end fw-semibold">&#8377;@r.Amount.ToString("N2")</td>
                                    <td class="text-end">@(r.Commission > 0 ? "₹" + r.Commission.ToString("0.##") : "—")</td>
                                    <td><span class="status-badge @cls" title="@r.StatusMsg">@r.Status</span></td>
                                    <td class="text-nowrap">
                                        <div>@r.Date.ToString("dd MMM")</div>
                                        <small class="text-muted">@r.Date.ToString("hh:mm tt")</small>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <div class="col-xl-3">
        <div class="card">
            <div class="card-header">Shortcuts</div>
            <div class="card-body quick d-grid gap-2">
                @if (isRetailer)
                {
                    <a href="@Url.Action("Index","Recharge")"><i class="fas fa-bolt"></i>New recharge</a>
                }
                <a href="@Url.Action("RechargeHistory","Transaction")"><i class="fas fa-clock-rotate-left"></i>Recharge history</a>
                <a href="@Url.Action("TransactionHistory","Transaction")"><i class="fas fa-receipt"></i>Wallet ledger</a>
                <a href="@Url.Action("ComplaintReport","Transaction")"><i class="fas fa-flag"></i>Complaints</a>
                @if (isAdmin)
                {
                    <a href="@Url.Action("AddMoney","Wallet")"><i class="fas fa-circle-plus"></i>Add money to a user</a>
                    <a href="@Url.Action("Index","KycAdmin")"><i class="fas fa-user-check"></i>Review KYC</a>
                }
                else
                {
                    <a href="@Url.Action("MyCommission","PackageComm")"><i class="fas fa-percent"></i>My commission</a>
                }
            </div>
        </div>
    </div>
</div>
