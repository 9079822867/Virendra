@{
    ViewBag.Title = "Dashboard";
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
}

<div class="page-content">
    <div class="container-fluid">
        <!-- Start page title -->
        <div class="row">
            <div class="col-12">
                <div class="page-title-box d-sm-flex align-items-center justify-content-between">
                    <h4 class="mb-sm-0 font-size-18">Dashboard</h4>
                    <div class="page-title-right">
                        <ol class="breadcrumb m-0">
                            <li class="breadcrumb-item"><a href="javascript: void(0);">Dashboard</a></li>
                            <li class="breadcrumb-item active">Overview</li>
                        </ol>
                    </div>
                </div>
            </div>
        </div>
        <!-- End page title -->

        <!-- Success Alert -->
        @if (TempData["LoginSuccess"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="fa fa-check-circle"></i> Login Successful..
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @{
            var stats = ViewBag.Stats as VIRENDRA.Models.DashboardStats ?? new VIRENDRA.Models.DashboardStats();
        }

        <!-- Tab Navigation - Bootstrap Native Tabs -->
        <ul class="nav nav-tabs-custom card-header-tabs border mt-4" role="tablist">
            <li class="nav-item" role="presentation">
                <a class="nav-link active" href="#overview-tab" data-bs-toggle="tab" role="tab" aria-selected="true">
                    <span>Overview</span>
                </a>
            </li>
            <li class="nav-item" role="presentation">
                <a class="nav-link" href="#statistics-tab" data-bs-toggle="tab" role="tab" aria-selected="false" tabindex="-1">
                    <span>Statistics</span>
                </a>
            </li>
            <li class="nav-item" role="presentation">
                <a class="nav-link" href="#transactions-tab" data-bs-toggle="tab" role="tab" aria-selected="false" tabindex="-1">
                    <span>Transactions</span>
                </a>
            </li>
            <li class="nav-item" role="presentation">
                <a class="nav-link" href="#reports-tab" data-bs-toggle="tab" role="tab" aria-selected="false" tabindex="-1">
                    <span>Reports</span>
                </a>
            </li>
        </ul>

        <!-- Tab Content -->
        <div class="tab-content">
            <!-- Tab 1: Overview -->
            <div id="overview-tab" class="tab-pane fade active show" role="tabpanel">
                <div class="row mt-4 g-3">

                    <!-- Opening Balance -->
                    <div class="col-lg-3 col-md-6">
                        <div class="card border-0 shadow-sm h-100" style="border-left:4px solid #2196F3;border-radius:10px;">
                            <div class="card-body d-flex align-items-center gap-3">
                                <div class="stat-icon rounded-lg p-3" style="background:#2196F320;">
                                    <i class="fa fa-wallet fa-2x" style="color:#2196F3;"></i>
                                </div>
                                <div>
                                    <p class="text-muted mb-1" style="font-size:.8rem;">Opening Balance</p>
                                    <h4 class="mb-0 fw-bold">₹ @stats.OpeningBalance.ToString("0.##")</h4>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Closing / Current Balance -->
                    <div class="col-lg-3 col-md-6">
                        <div class="card border-0 shadow-sm h-100" style="border-left:4px solid #9C27B0;border-radius:10px;">
                            <div class="card-body d-flex align-items-center gap-3">
                                <div class="stat-icon rounded-lg p-3" style="background:#9C27B020;">
                                    <i class="fa fa-rupee-sign fa-2x" style="color:#9C27B0;"></i>
                                </div>
                                <div>
                                    <p class="text-muted mb-1" style="font-size:.8rem;">Current Balance</p>
                                    <h4 class="mb-0 fw-bold">₹ @stats.ClosingBalance.ToString("0.##")</h4>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Success Transaction -->
                    <div class="col-lg-3 col-md-6">
                        <div class="card border-0 shadow-sm h-100" style="border-left:4px solid #4CAF50;border-radius:10px;">
                            <div class="card-body d-flex align-items-center gap-3">
                                <div class="stat-icon rounded-lg p-3" style="background:#4CAF5020;">
                                    <i class="fa fa-check-circle fa-2x" style="color:#4CAF50;"></i>
                                </div>
                                <div>
                                    <p class="text-muted mb-1" style="font-size:.8rem;">
                                        Success Txn
                                        <span class="badge ms-1" style="background:#4CAF5020;color:#4CAF50;font-size:.68rem;">@stats.SuccessCount</span>
                                    </p>
                                    <h4 class="mb-0 fw-bold">₹ @stats.SuccessAmount.ToString("0.##")</h4>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Failed Transaction -->
                    <div class="col-lg-3 col-md-6">
                        <div class="card border-0 shadow-sm h-100" style="border-left:4px solid #F44336;border-radius:10px;">
                            <div class="card-body d-flex align-items-center gap-3">
                                <div class="stat-icon rounded-lg p-3" style="background:#F4433620;">
                                    <i class="fa fa-times-circle fa-2x" style="color:#F44336;"></i>
                                </div>
                                <div>
                                    <p class="text-muted mb-1" style="font-size:.8rem;">
                                        Failed Txn
                                        <span class="badge ms-1" style="background:#F4433620;color:#F44336;font-size:.68rem;">@stats.FailedCount</span>
                                    </p>
                                    <h4 class="mb-0 fw-bold">₹ @stats.FailedAmount.ToString("0.##")</h4>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Refund Transaction -->
                    <div class="col-lg-3 col-md-6">
                        <div class="card border-0 shadow-sm h-100" style="border-left:4px solid #FF9800;border-radius:10px;">
                            <div class="card-body d-flex align-items-center gap-3">
                                <div class="stat-icon rounded-lg p-3" style="background:#FF980020;">
                                    <i class="fa fa-undo fa-2x" style="color:#FF9800;"></i>
                                </div>
                                <div>
                                    <p class="text-muted mb-1" style="font-size:.8rem;">Refund Txn</p>
                                    <h4 class="mb-0 fw-bold">₹ @stats.RefundAmount.ToString("0.##")</h4>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Credit Balance -->
                    <div class="col-lg-3 col-md-6">
                        <div class="card border-0 shadow-sm h-100" style="border-left:4px solid #00BCD4;border-radius:10px;">
                            <div class="card-body d-flex align-items-center gap-3">
                                <div class="stat-icon rounded-lg p-3" style="background:#00BCD420;">
                                    <i class="fa fa-credit-card fa-2x" style="color:#00BCD4;"></i>
                                </div>
                                <div>
                                    <p class="text-muted mb-1" style="font-size:.8rem;">Credit Balance</p>
                                    <h4 class="mb-0 fw-bold">₹ @stats.CreditBalance.ToString("0.##")</h4>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Today's Earning -->
                    <div class="col-lg-3 col-md-6">
                        <div class="card border-0 shadow-sm h-100" style="border-left:4px solid #8BC34A;border-radius:10px;">
                            <div class="card-body d-flex align-items-center gap-3">
                                <div class="stat-icon rounded-lg p-3" style="background:#8BC34A20;">
                                    <i class="fa fa-chart-line fa-2x" style="color:#8BC34A;"></i>
                                </div>
                                <div>
                                    <p class="text-muted mb-1" style="font-size:.8rem;">Today's Earning</p>
                                    <h4 class="mb-0 fw-bold">₹ @stats.TodayEarning.ToString("0.##")</h4>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Total Txn Count -->
                    <div class="col-lg-3 col-md-6">
                        <div class="card border-0 shadow-sm h-100" style="border-left:4px solid #607D8B;border-radius:10px;">
                            <div class="card-body d-flex align-items-center gap-3">
                                <div class="stat-icon rounded-lg p-3" style="background:#607D8B20;">
                                    <i class="fa fa-list fa-2x" style="color:#607D8B;"></i>
                                </div>
                                <div>
                                    <p class="text-muted mb-1" style="font-size:.8rem;">
                                        Total Txn Count
                                        <span class="badge ms-1" style="background:#607D8B20;color:#607D8B;font-size:.68rem;">@stats.PendingCount Pending</span>
                                    </p>
                                    <h4 class="mb-0 fw-bold">@stats.TotalTxnCount</h4>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>

            <!-- Tab 2: Statistics -->
            <div id="statistics-tab" class="tab-pane fade" role="tabpanel">
                <div class="card mt-3">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">Detailed Statistics</h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6 mb-4">
                                <h6 class="font-weight-bold mb-3">Monthly Breakdown</h6>
                                <ul class="list-group">
                                    <li class="list-group-item d-flex justify-content-between">
                                        <span>Total Transactions</span>
                                        <strong>2845</strong>
                                    </li>
                                    <li class="list-group-item d-flex justify-content-between">
                                        <span>Success Rate</span>
                                        <strong>98.5%</strong>
                                    </li>
                                    <li class="list-group-item d-flex justify-content-between">
                                        <span>Average Transaction</span>
                                        <strong><i class="fa fa-rupee-sign"></i> 1,245.50</strong>
                                    </li>
                                    <li class="list-group-item d-flex justify-content-between">
                                        <span>Total Volume</span>
                                        <strong><i class="fa fa-rupee-sign"></i> 35,42,500</strong>
                                    </li>
                                </ul>
                            </div>
                            <div class="col-md-6 mb-4">
                                <h6 class="font-weight-bold mb-3">Performance Metrics</h6>
                                <ul class="list-group">
                                    <li class="list-group-item d-flex justify-content-between">
                                        <span>API Response Time</span>
                                        <strong>245ms</strong>
                                    </li>
                                    <li class="list-group-item d-flex justify-content-between">
                                        <span>System Uptime</span>
                                        <strong>99.9%</strong>
                                    </li>
                                    <li class="list-group-item d-flex justify-content-between">
                                        <span>Failed Transactions</span>
                                        <strong>42</strong>
                                    </li>
                                    <li class="list-group-item d-flex justify-content-between">
                                        <span>Pending Requests</span>
                                        <strong>3</strong>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Tab 3: Recent Transactions (live from Recharge table) -->
            <div id="transactions-tab" class="tab-pane fade" role="tabpanel">
                @{
                    var recentList = ViewBag.RecentRecharges as List<VIRENDRA.Models.RechargeHistoryItem>
                                     ?? new List<VIRENDRA.Models.RechargeHistoryItem>();
                }
                <div class="card border-0 shadow-sm mt-3" style="border-radius:12px;overflow:hidden;">
                    <!-- Card Header -->
                    <div class="card-header border-0 py-3 px-4"
                         style="background:linear-gradient(135deg,#11998e 0%,#38ef7d 100%);">
                        <div class="d-flex align-items-center justify-content-between">
                            <div class="d-flex align-items-center">
                                <div class="rounded-circle d-flex align-items-center justify-content-center me-3"
                                     style="width:36px;height:36px;background:rgba(255,255,255,.2);">
                                    <i class="fas fa-bolt text-white" style="font-size:.85rem;"></i>
                                </div>
                                <div>
                                    <h6 class="mb-0 text-white fw-bold">Recent Recharge Transactions</h6>
                                    <small class="text-white-50">Latest 10 records from the Recharge table</small>
                                </div>
                            </div>
                            <a href="@Url.Action("Index", "Transaction")" class="btn btn-sm btn-light fw-semibold">
                                <i class="fas fa-list me-1"></i>View All
                            </a>
                        </div>
                    </div>

                    <div class="card-body p-0">
                        @if (!recentList.Any())
                        {
                            <div class="text-center py-5 text-muted">
                                <i class="fas fa-inbox fa-3x mb-3 d-block" style="opacity:.3;"></i>
                                <p class="mb-0">No recharge transactions found.</p>
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0" style="font-size:.86rem;">
                                    <thead class="table-light">
                                        <tr>
                                            <th class="ps-4 text-center" style="width:50px;">#</th>
                                            <th class="text-center" style="width:46px;">Status</th>
                                            <th>Txn / Mobile</th>
                                            <th>Reference</th>
                                            <th>Operator</th>
                                            <th class="text-end">Amount (₹)</th>
                                            <th class="text-end">Comm (₹)</th>
                                            <th>Date &amp; Time</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{ int sno = 1; }
                                        @foreach (var r in recentList)
                                        {
                                            // Status styling
                                            string statusColor, statusIcon, badgeClass;
                                            switch (r.Status)
                                            {
                                                case "Success":
                                                    statusColor = "#4CAF50"; statusIcon = "fa-check-circle"; badgeClass = "bg-success";
                                                    break;
                                                case "Failed":
                                                    statusColor = "#F44336"; statusIcon = "fa-times-circle"; badgeClass = "bg-danger";
                                                    break;
                                                default:
                                                    statusColor = "#FF9800"; statusIcon = "fa-clock"; badgeClass = "bg-warning text-dark";
                                                    break;
                                            }

                                            <tr>
                                                <td class="ps-4 text-center text-muted fw-semibold">@sno</td>
                                                <td class="text-center">
                                                    <i class="fas @statusIcon fa-lg" style="color:@statusColor;" title="@r.Status @r.StatusMsg"></i>
                                                </td>
                                                <td>
                                                    <div class="fw-semibold text-dark">@(r.TxnId ?? "—")</div>
                                                    <small class="text-muted">@r.Number</small>
                                                </td>
                                                <td>
                                                    @if (!string.IsNullOrEmpty(r.OurRefTxnId))
                                                    {
                                                        <code class="text-dark" style="font-size:.78rem;">@r.OurRefTxnId</code>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">—</span>
                                                    }
                                                    @if (!string.IsNullOrEmpty(r.ApiTxnId))
                                                    {
                                                        <div><small class="text-muted" style="font-size:.72rem;">@r.ApiTxnId</small></div>
                                                    }
                                                </td>
                                                <td>
                                                    <div class="d-flex align-items-center gap-2">
                                                        <div class="rounded-circle d-flex align-items-center justify-content-center"
                                                             style="width:28px;height:28px;background:#667eea15;flex-shrink:0;">
                                                            <i class="fas fa-bolt" style="color:#667eea;font-size:.65rem;"></i>
                                                        </div>
                                                        <span>@r.Operator</span>
                                                    </div>
                                                </td>
                                                <td class="text-end fw-semibold text-dark">
                                                    ₹@r.Amount.ToString("0.00")
                                                </td>
                                                <td class="text-end">
                                                    @if (r.Commission > 0)
                                                    {
                                                        <span class="text-success fw-semibold">₹@r.Commission.ToString("0.##")</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">—</span>
                                                    }
                                                </td>
                                                <td>
                                                    <div style="white-space:nowrap;">@r.Date.ToString("dd-MMM-yyyy")</div>
                                                    <small class="text-muted">@r.Date.ToString("hh:mm:ss tt")</small>
                                                </td>
                                            </tr>
                                            sno++;
                                        }
                                    </tbody>
                                    <tfoot class="table-light">
                                        <tr>
                                            <td colspan="5" class="ps-4 fw-semibold text-muted" style="font-size:.8rem;">
                                                Showing @recentList.Count record(s)
                                            </td>
                                            <td class="text-end fw-bold text-dark">
                                                ₹@recentList.Sum(x => x.Amount).ToString("0.00")
                                            </td>
                                            <td class="text-end fw-bold text-success">
                                                ₹@recentList.Sum(x => x.Commission).ToString("0.##")
                                            </td>
                                            <td></td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Tab 4: Reports -->
            <div id="reports-tab" class="tab-pane fade" role="tabpanel">
                <div class="card mt-3">
                    <div class="card-header bg-info text-white">
                        <h5 class="mb-0">Reports & Analytics</h5>
                    </div>
                    <div class="card-body">
                        <div class="row mb-4">
                            <div class="col-md-12">
                                <h6 class="font-weight-bold mb-3">Export Options</h6>
                                <div class="btn-group" role="group">
                                    <button type="button" class="btn btn-outline-primary">
                                        <i class="fa fa-file-pdf"></i> Export PDF
                                    </button>
                                    <button type="button" class="btn btn-outline-primary">
                                        <i class="fa fa-file-excel"></i> Export Excel
                                    </button>
                                    <button type="button" class="btn btn-outline-primary">
                                        <i class="fa fa-file-csv"></i> Export CSV
                                    </button>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <h6 class="font-weight-bold mb-3">Date Range</h6>
                                <div class="form-group">
                                    <label>From Date:</label>
                                    <input type="date" class="form-control">
                                </div>
                                <div class="form-group">
                                    <label>To Date:</label>
                                    <input type="date" class="form-control">
                                </div>
                            </div>
                            <div class="col-md-6">
                                <h6 class="font-weight-bold mb-3">Report Type</h6>
                                <div class="form-group">
                                    <select class="form-control">
                                        <option>All Transactions</option>
                                        <option>Success Transactions</option>
                                        <option>Failed Transactions</option>
                                        <option>Pending Transactions</option>
                                    </select>
                                </div>
                                <button class="btn btn-primary" style="margin-top: 1.5rem;">
                                    <i class="fa fa-search"></i> Generate Report
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .stat-icon {
        border-radius: 8px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 70px;
        height: 70px;
        font-size: 2rem;
        margin-right: 15px;
    }

    .card {
        border: none;
        border-radius: 8px;
    }

    .badge {
        padding: 0.5rem 0.75rem;
        font-weight: 500;
    }

    .table tbody tr {
        border-bottom: 1px solid #e9ecef;
    }

    .table tbody tr:hover {
        background-color: #f8f9fa;
    }

    .list-group-item {
        border-left: 3px solid #0066ff;
    }

    .nav-tabs-custom {
        border-bottom: 2px solid #e9ecef;
    }

    .nav-tabs-custom .nav-link {
        color: #495057;
        border: none;
        border-bottom: 3px solid transparent;
        padding: 0.75rem 1.5rem;
        transition: all 0.3s ease;
    }

    .nav-tabs-custom .nav-link:hover {
        color: #212529;
        border-bottom-color: #dee2e6;
    }

    .nav-tabs-custom .nav-link.active {
        color: #0066ff;
        border-bottom-color: #0066ff;
        background: transparent;
    }
</style>
