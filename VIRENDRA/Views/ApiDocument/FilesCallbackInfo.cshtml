@{
    ViewBag.Title = "Files.CallbackInfo - Developer Tool";
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-md-12">
            <h2>Developer Tool - Callback Information</h2>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header">
                    <h4>Files.CallbackInfo - Webhook Configuration</h4>
                </div>
                <div class="card-body">
                    <h5>Description</h5>
                    <p>This section provides information about configuring webhook callbacks for real-time transaction updates. Our system will POST transaction status updates to your configured callback URL.</p>

                    <h5 class="mt-4">Webhook Configuration</h5>
                    <table class="table table-bordered">
                        <thead>
                            <tr>
                                <th>Setting</th>
                                <th>Description</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>Callback URL</td>
                                <td>Your server's endpoint to receive updates</td>
                            </tr>
                            <tr>
                                <td>Method</td>
                                <td>HTTP POST</td>
                            </tr>
                            <tr>
                                <td>Content-Type</td>
                                <td>application/json</td>
                            </tr>
                            <tr>
                                <td>Timeout</td>
                                <td>30 seconds</td>
                            </tr>
                        </tbody>
                    </table>

                    <h5 class="mt-4">Setting Up Callback</h5>
                    <ol>
                        <li>Log in to your account dashboard</li>
                        <li>Navigate to Settings > API Configuration</li>
                        <li>Enter your Callback URL</li>
                        <li>Save the configuration</li>
                    </ol>

                    <h5 class="mt-4">Callback Payload Format</h5>
                    <pre><code>{
    "status": 1,
    "api_txn_id": 2023,
    "message": "recharge success",
    "operator_reference": "op_ref1373",
    "callback_timestamp": "2024-01-15 14:31:00",
    "data": {
        "phone_number": "9876543210",
        "amount": 100,
        "operator": "Jio",
        "circle": "Delhi",
        "transaction_date": "2024-01-15 14:30:00",
        "completion_date": "2024-01-15 14:31:00"
    }
}</code></pre>

                    <h5 class="mt-4">HTTP Headers Sent with Callback</h5>
                    <pre><code>Content-Type: application/json
X-API-Key: your_api_key
X-Callback-Token: unique_callback_token
X-Request-ID: unique_request_id</code></pre>

                    <h5 class="mt-4">Expected Response from Your Server</h5>
                    <p>Your callback endpoint should return an HTTP 200 status with the following JSON response:</p>
                    <pre><code>{
    "status": "received",
    "message": "Callback received and processed"
}</code></pre>

                    <h5 class="mt-4">Callback Events</h5>
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Event Type</th>
                                <th>Description</th>
                                <th>When Triggered</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>transaction.completed</td>
                                <td>Recharge completed successfully</td>
                                <td>Immediately after successful recharge</td>
                            </tr>
                            <tr>
                                <td>transaction.failed</td>
                                <td>Recharge failed</td>
                                <td>When recharge operation fails</td>
                            </tr>
                            <tr>
                                <td>transaction.pending</td>
                                <td>Recharge is pending</td>
                                <td>When status cannot be determined immediately</td>
                            </tr>
                            <tr>
                                <td>refund.processed</td>
                                <td>Refund has been processed</td>
                                <td>After refund completion</td>
                            </tr>
                        </tbody>
                    </table>

                    <h5 class="mt-4">Retry Policy</h5>
                    <p>If your callback endpoint doesn't respond with HTTP 200 within 30 seconds, our system will retry:</p>
                    <ul>
                        <li>1st Retry: After 5 minutes</li>
                        <li>2nd Retry: After 15 minutes</li>
                        <li>3rd Retry: After 1 hour</li>
                        <li>Final Retry: After 24 hours</li>
                    </ul>

                    <h5 class="mt-4">Security</h5>
                    <p>All callbacks include a digital signature in the X-Callback-Token header. Verify this token using your API secret to ensure the callback is authentic.</p>

                    <h5 class="mt-4">Example Callback Handler (C#)</h5>
                    <pre><code>[HttpPost]
[Route("api/callback")]
public IActionResult ReceiveCallback([FromBody] CallbackPayload payload)
{
    try
    {
        // Verify token
        var token = Request.Headers["X-Callback-Token"].ToString();
        if (!VerifyToken(token))
            return Unauthorized();

        // Process the callback
        ProcessTransaction(payload);

        // Return success response
        return Ok(new { status = "received", message = "Callback received and processed" });
    }
    catch (Exception ex)
    {
        // Log error but don't throw exception
        LogError(ex);
        return BadRequest();
    }
}</code></pre>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-md-12">
            <a href="@Url.Action("Index")" class="btn btn-secondary">Back to Introduction</a>
        </div>
    </div>
</div>

