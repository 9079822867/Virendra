@functions {
    public class Param { public string Name, In, Type, Desc, Example; public bool Required; }
    public class Field { public string Name, Type, Desc, Example; }
    public class Sample { public string Label, Json; }
    public class Endpoint
    {
        public string Id, Group, Method, Path, Title, Desc, Url;
        public bool Webhook;
        public List<Param>  Params   = new List<Param>();
        public List<Field>  Fields   = new List<Field>();
        public List<Sample> Examples = new List<Sample>();
    }

    static Param P(string name, string inWhere, string type, bool required, string desc, string example = null)
        => new Param { Name = name, In = inWhere, Type = type, Required = required, Desc = desc, Example = example };
    static Field F(string name, string type, string desc, string example = null)
        => new Field { Name = name, Type = type, Desc = desc, Example = example };
    static Sample S(string label, string json) => new Sample { Label = label, Json = json };
}
@{
    ViewBag.Title = "API documentation";
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";

    string b = (string)ViewBag.BaseUrl;
    var ops = ViewBag.Operators as List<VIRENDRA.Models.Operator> ?? new List<VIRENDRA.Models.Operator>();
    var circles = ViewBag.Circles as List<VIRENDRA.Models.Circle> ?? new List<VIRENDRA.Models.Circle>();
    var me = ViewBag.Me as VIRENDRA.Models.User;

    string sampleOp = ops.Select(o => o.OperatorCode).FirstOrDefault(c => !string.IsNullOrWhiteSpace(c)) ?? "JIO";
    string sampleCircle = circles.Select(c => c.CircleCode).FirstOrDefault(c => !string.IsNullOrWhiteSpace(c)) ?? "RJ";
    var key = P("key", "query", "string", false, "Your API key (use the x-api-key header instead when you can).", "YOUR_API_KEY");
    var keyHeader = P("x-api-key", "header", "string", false, "Your API key. Recommended over the query parameter.", "YOUR_API_KEY");

    var eps = new List<Endpoint>
    {
        // ── Recharge ─────────────────────────────────────────────────────
        new Endpoint {
            Id = "recharge", Group = "Recharge", Method = "GET", Path = "/transaction/recharge/", Title = "Create recharge",
            Desc = "Starts a recharge. The reply is usually final (Success / Failed); when the operator is slow it is Processing — then wait for the recharge webhook or poll Check status.",
            Url = b + "/transaction/recharge/?mobileno=9876543210&operatorCode=" + sampleOp + "&amount=199&circle=" + sampleCircle + "&clientRef=ORDER-12345&key=YOUR_API_KEY",
            Params = {
                P("mobileno", "query", "string", true, "Mobile / subscriber number, digits only.", "9876543210"),
                P("operatorCode", "query", "string", true, "Operator code — see Operator codes.", sampleOp),
                P("amount", "query", "number", true, "Recharge amount in Rupees.", "199"),
                P("circle", "query", "string", false, "Circle code — see Circle codes. Optional but recommended.", sampleCircle),
                P("type", "query", "string", false, "P2P or P2A. Accepted for compatibility; routing picks the vendor.", "P2P"),
                P("clientRef", "query", "string", true, "Your unique reference for this recharge (max 50). Reusing it is rejected.", "ORDER-12345"),
                key, keyHeader },
            Fields = {
                F("status", "string", "Processing · Success · Failed", "Success"),
                F("txnId", "string", "Our transaction id (same as system_id).", "E261031145130254586"),
                F("message", "string", "Operator reference on Success, otherwise a readable message.", "BR000D3H1YSO"),
                F("clientRef", "string", "Your reference, echoed back.", "ORDER-12345"),
                F("system_id", "string", "Our transaction id — use it for status and disputes.", "E261031145130254586"),
                F("remark", "string | null", "Extra note from the provider, if any.", "null"),
                F("req_time", "string", "Request time, ISO 8601 UTC.", "2026-10-31T09:21:30.000Z"),
                F("number", "string", "Number recharged.", "9876543210"),
                F("amount", "number", "Amount in Rupees.", "199"),
                F("reason", "string", "Only on early failures: INSUFFICIENT_BALANCE, DUPLICATE_CLIENT_REF, INVALID_OPERATOR, INVALID_AMOUNT, INVALID_MOBILENO, MISSING_CLIENT_REF, REJECTED.", "INSUFFICIENT_BALANCE") },
            Examples = {
                S("Success", @"{
  ""status"": ""Success"",
  ""txnId"": ""E261031145130254586"",
  ""message"": ""BR000D3H1YSO"",
  ""clientRef"": ""ORDER-12345"",
  ""system_id"": ""E261031145130254586"",
  ""remark"": null,
  ""req_time"": ""2026-10-31T09:21:30.000Z"",
  ""number"": ""9876543210"",
  ""amount"": 199
}"),
                S("Processing", @"{
  ""status"": ""Processing"",
  ""txnId"": ""E261031145130254586"",
  ""message"": ""Processing your request."",
  ""clientRef"": ""ORDER-12345"",
  ""system_id"": ""E261031145130254586"",
  ""remark"": null,
  ""req_time"": ""2026-10-31T09:21:30.000Z"",
  ""number"": ""9876543210"",
  ""amount"": 199
}"),
                S("Failed", @"{
  ""status"": ""Failed"",
  ""txnId"": ""E261031145130254586"",
  ""message"": ""Recharge failed. Amount refunded to wallet."",
  ""clientRef"": ""ORDER-12345"",
  ""system_id"": ""E261031145130254586"",
  ""remark"": null,
  ""req_time"": ""2026-10-31T09:21:30.000Z"",
  ""number"": ""9876543210"",
  ""amount"": 199
}"),
                S("Insufficient balance", @"{
  ""status"": ""Failed"",
  ""txid"": null,
  ""message"": ""Insufficient balance. Available: 120"",
  ""remark"": null,
  ""clientRef"": ""ORDER-12345"",
  ""req_time"": ""2026-10-31T09:21:30.000Z"",
  ""number"": ""9876543210"",
  ""amount"": 199,
  ""reason"": ""INSUFFICIENT_BALANCE"",
  ""request_ip"": ""203.0.113.10""
}") } },

        new Endpoint {
            Id = "status", Group = "Recharge", Method = "GET", Path = "/transaction/recharge/:id", Title = "Check status",
            Desc = "Latest state of one of your recharges. :id can be our system_id, your clientRef or the numeric recharge id.",
            Url = b + "/transaction/recharge/ORDER-12345?key=YOUR_API_KEY",
            Params = { P(":id", "path", "string", true, "system_id, clientRef or recharge id.", "ORDER-12345"), key, keyHeader },
            Fields = {
                F("status", "string", "Success · Failed · Processing", "Success"),
                F("txnId", "string | null", "Operator reference.", "BR000D2NLALC"),
                F("message", "string", "Operator reference on Success, otherwise a readable message.", "BR000D2NLALC"),
                F("clientRef", "string", "Your original reference.", "ORDER-12345"),
                F("number", "string", "Number recharged.", "9876543210"),
                F("operator", "string", "Operator name.", "JIO"),
                F("circle", "string | null", "Circle name.", "Rajasthan"),
                F("amounts", "number", "Recharge amount in Rupees.", "199"),
                F("commission", "number | null", "Gross commission in paise.", "580"),
                F("margin", "number | null", "Net margin in Rupees (negative = surcharge).", "5.8") },
            Examples = {
                S("Success", @"{
  ""status"": ""Success"",
  ""txnId"": ""BR000D2NLALC"",
  ""message"": ""BR000D2NLALC"",
  ""remark"": null,
  ""clientRef"": ""ORDER-12345"",
  ""req_time"": ""2026-10-31T09:21:30.000Z"",
  ""number"": ""9876543210"",
  ""operator"": ""JIO"",
  ""circle"": ""Rajasthan"",
  ""amounts"": 199,
  ""commission"": 580,
  ""margin"": 5.8
}"),
                S("Not found (HTTP 404)", @"{
  ""status"": ""Failed"",
  ""txnId"": null,
  ""message"": ""Transaction not found with this #ORDER-12345 request id or client ref."",
  ""remark"": null,
  ""clientRef"": null,
  ""req_time"": ""2026-10-31T09:21:30.000Z"",
  ""number"": null,
  ""amount"": null
}") } },


        // ── Wallet ───────────────────────────────────────────────────────
        new Endpoint {
            Id = "wallets", Group = "Wallet", Method = "GET", Path = "/user/api/wallets", Title = "Wallet balance",
            Desc = "Your live wallet balance.",
            Url = b + "/user/api/wallets?type=RECHARGE&key=YOUR_API_KEY",
            Params = { P("type", "query", "string", false, "Only this wallet. Today there is one: RECHARGE.", "RECHARGE"), key, keyHeader },
            Fields = {
                F("wallets", "object", "Map of wallet type → wallet."),
                F("wallets.RECHARGE.balance", "number", "Balance in INR.", "1305.00"),
                F("wallets.RECHARGE.status", "string", "ACTIVE or BLOCKED.", "ACTIVE"),
                F("wallets.RECHARGE.currency", "string", "Always INR.", "INR"),
                F("count", "number", "Number of wallets returned.", "1") },
            Examples = { S("200 OK", @"{
  ""wallets"": {
    ""RECHARGE"": {
      ""id"": ""5"",
      ""type"": ""RECHARGE"",
      ""balance"": 1305.00,
      ""status"": ""ACTIVE"",
      ""currency"": ""INR"",
      ""updatedAt"": ""2026-10-31T09:21:30.000Z"",
      ""createdAt"": ""2026-05-23T06:10:00.000Z""
    }
  },
  ""count"": 1
}") } },

        // ── Disputes ─────────────────────────────────────────────────────
        new Endpoint {
            Id = "dispute-raise", Group = "Disputes", Method = "GET", Path = "/report/api/complaints/raise", Title = "Raise a dispute",
            Desc = "Opens a complaint on a successful recharge (one per recharge). It is also forwarded to the vendor.",
            Url = b + "/report/api/complaints/raise?txnId=ORDER-12345&reasonCode=NOT_CREDITED&subject=Recharge%20not%20received&askedAmount=199&key=YOUR_API_KEY",
            Params = {
                P("txnId", "query", "string", true, "system_id, clientRef or recharge id.", "ORDER-12345"),
                P("reasonCode", "query", "string", false, "NOT_CREDITED · DUPLICATE_DEBIT · WRONG_AMOUNT · SERVICE_NOT_WORKING · OTHER (default).", "NOT_CREDITED"),
                P("subject", "query", "string", false, "Short title, max 200 characters.", "Recharge not received"),
                P("description", "query", "string", false, "Details, max 2000 characters."),
                P("askedAmount", "query", "number", false, "Refund you are asking for, in Rupees.", "199"),
                key, keyHeader },
            Fields = {
                F("message", "string", "Result.", "Complaint created successfully"),
                F("ticketId", "string", "Ticket id to track it.", "TKT-20261031-0042"),
                F("complaintId", "string", "Internal complaint id.", "42"),
                F("status", "string", "Always OPEN at first.", "OPEN"),
                F("reasonCode", "string", "Reason, echoed back.", "NOT_CREDITED") },
            Examples = {
                S("201 Created", @"{
  ""message"": ""Complaint created successfully"",
  ""ticketId"": ""TKT-20261031-0042"",
  ""complaintId"": ""42"",
  ""status"": ""OPEN"",
  ""reasonCode"": ""NOT_CREDITED"",
  ""txnId"": ""E261031145130254586"",
  ""clientRef"": ""ORDER-12345"",
  ""createdAt"": ""2026-10-31T09:30:00.000Z""
}"),
                S("Already raised (HTTP 409)", @"{ ""message"": ""A complaint already exists for this transaction."" }"),
                S("Not a successful recharge (HTTP 400)", @"{ ""message"": ""Complaints can be raised only for successful recharges."" }") } },

        new Endpoint {
            Id = "dispute-status", Group = "Disputes", Method = "GET", Path = "/report/api/complaints/:id", Title = "Dispute status",
            Desc = "One complaint by ticket id (TKT-…) or complaint id.",
            Url = b + "/report/api/complaints/TKT-20261031-0042?key=YOUR_API_KEY",
            Params = { P(":id", "path", "string", true, "Ticket id or complaint id.", "TKT-20261031-0042"), key, keyHeader },
            Fields = {
                F("data._id", "string", "Complaint id.", "42"),
                F("data.ticketId", "string", "Ticket id.", "TKT-20261031-0042"),
                F("data.status", "string", "OPEN · IN_PROGRESS · RESOLVED · CANCELLED", "OPEN"),
                F("data.reasonCode", "string", "Reason code.", "NOT_CREDITED"),
                F("data.subject", "string", "Subject.", "Recharge not received"),
                F("data.description", "string | null", "Details."),
                F("data.askedAmount", "number", "Refund asked (else the recharge amount).", "199"),
                F("data.txnId", "string", "Our system_id of the recharge.", "E261031145130254586") },
            Examples = {
                S("200 OK", @"{
  ""data"": {
    ""_id"": ""42"",
    ""ticketId"": ""TKT-20261031-0042"",
    ""status"": ""OPEN"",
    ""reasonCode"": ""NOT_CREDITED"",
    ""subject"": ""Recharge not received"",
    ""description"": ""Amount debited but recharge not received"",
    ""askedAmount"": 199,
    ""txnId"": ""E261031145130254586"",
    ""createdAt"": ""2026-10-31T09:30:00.000Z"",
    ""updatedAt"": ""2026-10-31T09:30:00.000Z""
  }
}"),
                S("Not found (HTTP 404)", @"{ ""message"": ""Complaint not found"" }") } },


        new Endpoint {
            Id = "dispute-list", Group = "Disputes", Method = "GET", Path = "/report/api/complaints", Title = "List disputes",
            Desc = "Your complaints, newest first, page by page.",
            Url = b + "/report/api/complaints?status=OPEN&page=1&limit=20&key=YOUR_API_KEY",
            Params = {
                P("status", "query", "string", false, "OPEN · IN_PROGRESS · RESOLVED, comma-separated.", "OPEN"),
                P("page", "query", "number", false, "Page, default 1.", "1"),
                P("limit", "query", "number", false, "Per page, default 20, max 50.", "20"),
                key, keyHeader },
            Fields = {
                F("data[]", "array", "Complaints (same fields as Dispute status, without description)."),
                F("pagination.total", "number", "Matching complaints.", "1"),
                F("pagination.page", "number", "Current page.", "1"),
                F("pagination.pages", "number", "Total pages.", "1") },
            Examples = { S("200 OK", @"{
  ""data"": [
    {
      ""_id"": ""42"",
      ""ticketId"": ""TKT-20261031-0042"",
      ""status"": ""OPEN"",
      ""reasonCode"": ""NOT_CREDITED"",
      ""subject"": ""Recharge not received"",
      ""askedAmount"": 199,
      ""txnId"": ""E261031145130254586"",
      ""createdAt"": ""2026-10-31T09:30:00.000Z""
    }
  ],
  ""pagination"": { ""total"": 1, ""page"": 1, ""pages"": 1, ""limit"": 20 }
}") } },

        // ── Webhooks ─────────────────────────────────────────────────────
        new Endpoint {
            Id = "webhook-recharge", Group = "Webhooks", Method = "GET", Path = "YOUR_CALLBACK_URL", Title = "Recharge callback", Webhook = true,
            Desc = "When a Processing recharge becomes Success or Failed, we call your Callback URL (set it under Developer → API Keys) with these query parameters. Reply with HTTP 200.",
            Url = "https://your-site.example/callback?clientRef=ORDER-12345&providerReference=BR000D3H1YSO&mobileno=9876543210&operatorCode=" + sampleOp + "&circle=" + sampleCircle + "&amount=199&status=Success&message=Recharge+Successfully&system_id=E261031145130254586",
            Params = {
                P("clientRef", "query", "string", false, "Your reference."),
                P("providerReference", "query", "string", false, "Operator reference."),
                P("mobileno", "query", "string", false, "Number recharged."),
                P("operatorCode", "query", "string", false, "Operator code."),
                P("circle", "query", "string", false, "Circle code."),
                P("amount", "query", "number", false, "Amount in Rupees."),
                P("status", "query", "string", false, "Success or Failed."),
                P("message", "query", "string", false, "Final message."),
                P("system_id", "query", "string", false, "Our transaction id — use it for status or disputes.") } },

        new Endpoint {
            Id = "webhook-complaint", Group = "Webhooks", Method = "GET", Path = "YOUR_COMPLAINT_CALLBACK_URL", Title = "Complaint callback", Webhook = true,
            Desc = "When we resolve one of your complaints we call your Complaint Callback URL (ask your admin to set it) with these query parameters.",
            Url = "https://your-site.example/complaint-callback?systemTxnId=E261031145130254586&clientRef=ORDER-12345&amount=199&mobileno=9876543210&operatorCode=" + sampleOp + "&event=COMPLAINT_RESOLVED&attempt=1&ticketId=TKT-20261031-0042&status=RESOLVED_SUCCESSFUL&reasonCode=NOT_CREDITED&providerReference=BR000D3H1YSO",
            Params = {
                P("systemTxnId", "query", "string", false, "Our system_id of the recharge."),
                P("clientRef", "query", "string", false, "Your reference."),
                P("amount", "query", "number", false, "Recharge amount in Rupees."),
                P("mobileno", "query", "string", false, "Number."),
                P("operatorCode", "query", "string", false, "Operator code."),
                P("event", "query", "string", false, "COMPLAINT_RESOLVED or COMPLAINT_REFUND_APPROVED."),
                P("attempt", "query", "number", false, "Delivery attempt, starts at 1."),
                P("ticketId", "query", "string", false, "Ticket id."),
                P("status", "query", "string", false, "RESOLVED_SUCCESSFUL or REFUND_APPROVED (amount credited back to your wallet)."),
                P("reasonCode", "query", "string", false, "Reason you raised it with."),
                P("providerReference", "query", "string", false, "Operator reference of the recharge.") } },
    };

    var groups = eps.GroupBy(e => e.Group).ToList();
    string maskedKey = me == null || string.IsNullOrEmpty(me.TokenAPI) ? null
                     : me.TokenAPI.Substring(0, 4) + new string('•', 8) + me.TokenAPI.Substring(me.TokenAPI.Length - 4);
}

<style>
    .doc { display:grid; grid-template-columns: 220px minmax(0,1fr); gap:24px; align-items:start; }
    .doc-nav { position:sticky; top:84px; background:var(--surface); border:1px solid var(--line); border-radius:var(--radius); padding:10px; max-height:calc(100vh - 110px); overflow:auto; }
    .doc-nav .lbl { font-size:.66rem; font-weight:700; letter-spacing:.08em; text-transform:uppercase; color:var(--muted); padding:10px 8px 4px; }
    .doc-nav a { display:flex; align-items:center; gap:8px; padding:6px 8px; border-radius:7px; color:var(--ink-2); text-decoration:none; font-size:.82rem; }
    .doc-nav a:hover { background:var(--soft); color:var(--ink); }
    .doc-nav a.on { background:var(--accent-soft); color:var(--accent-ink); font-weight:600; }
    .verb { font-family:var(--mono); font-size:.62rem; font-weight:700; padding:1px 5px; border-radius:4px; background:var(--ok-soft); color:var(--ok); }
    .verb.hook { background:#ede9fe; color:#6d28d9; }

    .doc-sec { background:var(--surface); border:1px solid var(--line); border-radius:var(--radius); padding:22px 24px; margin-bottom:18px; scroll-margin-top:84px; }
    .doc-sec h2 { font-size:1.15rem; font-weight:800; margin:0 0 6px; }
    .doc-sec .lead { color:var(--muted); font-size:.88rem; margin-bottom:14px; }
    .doc-sec h6 { font-size:.68rem; font-weight:700; letter-spacing:.08em; text-transform:uppercase; color:var(--muted); margin:18px 0 8px; }
    .path { display:flex; align-items:center; gap:10px; font-family:var(--mono); font-size:.88rem; margin-bottom:8px; }
    .url { position:relative; background:var(--side-bg); color:#e2e8f0; border-radius:8px; padding:12px 44px 12px 14px; font-family:var(--mono); font-size:.78rem; word-break:break-all; }
    .url .cp { position:absolute; top:8px; right:8px; border:0; background:#1e293b; color:#cbd5e1; border-radius:6px; width:28px; height:28px; }
    .url .cp:hover { color:#fff; }
    .doc-sec table { font-size:.82rem; }
    .doc-sec td code, .doc-sec th code { font-size:.78rem; }
    .req { font-size:.66rem; font-weight:700; color:var(--bad); text-transform:uppercase; margin-left:4px; }
    .opt { font-size:.66rem; color:var(--muted); margin-left:4px; }
    .eg { color:var(--muted); font-size:.74rem; }
    .eg code { color:var(--ink-2); }
    pre.json { background:var(--soft); border:1px solid var(--line); border-radius:8px; padding:12px 14px; font-family:var(--mono); font-size:.76rem; margin:0; max-height:420px; overflow:auto; }
    .ex-tabs { display:flex; gap:6px; flex-wrap:wrap; margin-bottom:8px; }
    .ex-tabs button { border:1px solid var(--line); background:var(--surface); border-radius:999px; padding:3px 11px; font-size:.74rem; font-weight:600; color:var(--ink-2); }
    .ex-tabs button.on { background:var(--fill); color:var(--on-fill); border-color:var(--fill); }
    .keybox { display:flex; gap:12px; flex-wrap:wrap; align-items:center; background:var(--soft); border:1px solid var(--line); border-radius:8px; padding:10px 12px; font-size:.84rem; }
    @@media (max-width: 991.98px) { .doc { grid-template-columns:1fr; } .doc-nav { position:static; max-height:none; } }
</style>

<div class="page-head">
    <div>
        <h4>Reseller API</h4>
        <div class="text-muted small">Recharge, wallet and disputes over simple GET calls, with webhooks for final results.</div>
    </div>
    <a href="@Url.Action("Index","ApiSettings")" class="btn btn-dark"><i class="fas fa-key me-1"></i>API keys &amp; callback</a>
</div>

<div class="doc">
    <nav class="doc-nav" id="docNav">
        <div class="lbl">Start</div>
        <a href="#intro">Introduction</a>
        <a href="#errors">Errors &amp; codes</a>
        @foreach (var g in groups)
        {
            <div class="lbl">@g.Key</div>
            foreach (var e in g)
            {
                <a href="#@e.Id"><span class="verb @(e.Webhook ? "hook" : "")">@(e.Webhook ? "HOOK" : e.Method)</span>@e.Title</a>
            }
        }
        <div class="lbl">Reference</div>
        <a href="#operators">Operator codes</a>
        <a href="#circles">Circle codes</a>
        <a href="#legacy">Older endpoints</a>
    </nav>

    <div>
        <section class="doc-sec" id="intro">
            <h2>Introduction</h2>
            <p class="lead">Every call is an HTTPS GET to the base URL below. Answers are JSON. Times are ISO 8601 in UTC; amounts are in Rupees, except <code>commission</code> in Check status, which is in paise.</p>

            <h6>Base URL</h6>
            <div class="url"><span>@b</span><button type="button" class="cp" data-copy="@b" title="Copy"><i class="far fa-copy"></i></button></div>

            <h6>Authentication</h6>
            <p class="mb-2" style="font-size:.88rem;">Send your API key in the <code>x-api-key</code> header (recommended) or as <code>?key=</code>. Calls are accepted only from the server IP you registered, and only after your KYC is approved.</p>
            <div class="keybox">
                @if (maskedKey != null)
                {
                    <span><i class="fas fa-key text-accent me-1"></i>Your key: <code>@maskedKey</code></span>
                    <span><i class="fas fa-network-wired text-muted me-1"></i>Allowed IP: <code>@(string.IsNullOrWhiteSpace(me.LoginIP) || me.LoginIP.Trim() == "*" ? "any IP" : me.LoginIP)</code></span>
                    <span><i class="fas fa-reply text-muted me-1"></i>Callback: <code>@(string.IsNullOrWhiteSpace(me.CallbackURL) ? "not set" : me.CallbackURL)</code></span>
                }
                else
                {
                    <span><i class="fas fa-circle-exclamation text-warning me-1"></i>You don't have an API key yet.</span>
                }
                <a href="@Url.Action("Index","ApiSettings")" class="ms-auto">Manage →</a>
            </div>

            <h6>Example</h6>
            <pre class="json">curl -H "x-api-key: YOUR_API_KEY" "@b/user/api/wallets"</pre>
        </section>

        <section class="doc-sec" id="errors">
            <h2>Errors &amp; codes</h2>
            <p class="lead">Recharge and status calls answer in the recharge shape (<code>status: "Failed"</code> plus a <code>message</code>). Other calls answer <code>{ "message": "…" }</code> on error.</p>
            <table class="table">
                <thead><tr><th>HTTP</th><th>When</th></tr></thead>
                <tbody>
                    <tr><td><code>200</code></td><td>Request handled — check <code>status</code> for the recharge result.</td></tr>
                    <tr><td><code>201</code></td><td>Dispute created.</td></tr>
                    <tr><td><code>400</code></td><td>A parameter is missing or invalid.</td></tr>
                    <tr><td><code>401</code></td><td>API key missing or wrong.</td></tr>
                    <tr><td><code>403</code></td><td>Account inactive, IP not allowed, or KYC pending.</td></tr>
                    <tr><td><code>404</code></td><td>Recharge or complaint not found (only your own are visible).</td></tr>
                    <tr><td><code>409</code></td><td>A complaint already exists for that recharge.</td></tr>
                </tbody>
            </table>
        </section>

        @foreach (var e in eps)
        {
            <section class="doc-sec" id="@e.Id">
                <div class="path">
                    <span class="verb @(e.Webhook ? "hook" : "")">@(e.Webhook ? "WEBHOOK" : e.Method)</span>
                    <span>@e.Path</span>
                </div>
                <h2>@e.Title</h2>
                <p class="lead">@e.Desc</p>

                <h6>@(e.Webhook ? "Callback URL" : "Request URL")</h6>
                <div class="url"><span>@e.Url</span><button type="button" class="cp" data-copy="@e.Url" title="Copy"><i class="far fa-copy"></i></button></div>

                @if (e.Params.Any())
                {
                    <h6>@(e.Webhook ? "Callback parameters" : "Parameters")</h6>
                    <div class="table-responsive">
                        <table class="table">
                            <thead><tr><th>Name</th>@if (!e.Webhook) {<th>In</th>}<th>Type</th><th>Description</th></tr></thead>
                            <tbody>
                                @foreach (var p in e.Params)
                                {
                                    <tr>
                                        <td class="text-nowrap"><code>@p.Name</code>@if (!e.Webhook) {<span class="@(p.Required ? "req" : "opt")">@(p.Required ? "required" : "optional")</span>}</td>
                                        @if (!e.Webhook) {<td>@p.In</td>}
                                        <td class="text-nowrap">@p.Type</td>
                                        <td>@p.Desc @if (p.Example != null) {<div class="eg">e.g. <code>@p.Example</code></div>}</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                @if (e.Fields.Any())
                {
                    <h6>Response fields</h6>
                    <div class="table-responsive">
                        <table class="table">
                            <thead><tr><th>Field</th><th>Type</th><th>Description</th></tr></thead>
                            <tbody>
                                @foreach (var f in e.Fields)
                                {
                                    <tr>
                                        <td class="text-nowrap"><code>@f.Name</code></td>
                                        <td class="text-nowrap">@f.Type</td>
                                        <td>@f.Desc @if (f.Example != null) {<div class="eg">e.g. <code>@f.Example</code></div>}</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                @if (e.Examples.Any())
                {
                    <h6>Response examples</h6>
                    <div class="ex-tabs">
                        @for (int i = 0; i < e.Examples.Count; i++)
                        {
                            <button type="button" class="@(i == 0 ? "on" : "")" data-ex="@e.Id-@i">@e.Examples[i].Label</button>
                        }
                    </div>
                    for (int i = 0; i < e.Examples.Count; i++)
                    {
                        <pre class="json" id="@e.Id-@i" style="@(i == 0 ? "" : "display:none;")">@e.Examples[i].Json</pre>
                    }
                }
            </section>
        }

        <section class="doc-sec" id="operators">
            <h2>Operator codes</h2>
            <p class="lead">Use the code in <code>operatorCode</code>.</p>
            <div class="table-responsive">
                <table class="table">
                    <thead><tr><th>Operator</th><th>Type</th><th>Code</th></tr></thead>
                    <tbody>
                        @if (!ops.Any())
                        {
                            <tr><td colspan="3" class="text-muted">No active operators.</td></tr>
                        }
                        @foreach (var o in ops.OrderBy(o => o.OpTypeId).ThenBy(o => o.Name))
                        {
                            <tr>
                                <td>@o.Name</td>
                                <td>@(o.OpTypeId == 1 ? "Prepaid" : o.OpTypeId == 2 ? "Postpaid" : o.OpTypeId == 3 ? "DTH" : "—")</td>
                                <td><code>@o.OperatorCode</code></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>

        <section class="doc-sec" id="circles">
            <h2>Circle codes</h2>
            <p class="lead">Use the code in <code>circle</code>.</p>
            <div class="table-responsive">
                <table class="table">
                    <thead><tr><th>Circle</th><th>Code</th></tr></thead>
                    <tbody>
                        @foreach (var c in circles)
                        {
                            <tr><td>@c.Name</td><td><code>@c.CircleCode</code></td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>

        <section class="doc-sec" id="legacy">
            <h2>Older endpoints</h2>
            <p class="lead">Integrations built on the first API keep working. New integrations should use the calls above.</p>
            <table class="table">
                <thead><tr><th>Call</th><th>Use instead</th></tr></thead>
                <tbody>
                    <tr><td><code>/api/recharge</code>, <code>/api/recharge2</code> (username + token)</td><td><a href="#recharge">Create recharge</a></td></tr>
                    <tr><td><code>/api/status</code>, <code>/api/statusCheck</code></td><td><a href="#status">Check status</a></td></tr>
                    <tr><td><code>/api/balance</code>, <code>/api/balanceCheck</code></td><td><a href="#wallets">Wallet balance</a></td></tr>
                </tbody>
            </table>
        </section>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            document.querySelectorAll('.cp').forEach(function (b) {
                b.addEventListener('click', function () {
                    if (navigator.clipboard) navigator.clipboard.writeText(b.getAttribute('data-copy'));
                    b.innerHTML = '<i class="fas fa-check"></i>';
                    setTimeout(function () { b.innerHTML = '<i class="far fa-copy"></i>'; }, 1200);
                });
            });

            document.querySelectorAll('.ex-tabs button').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var sec = btn.closest('.doc-sec');
                    sec.querySelectorAll('.ex-tabs button').forEach(function (x) { x.classList.toggle('on', x === btn); });
                    sec.querySelectorAll('pre.json[id]').forEach(function (p) { p.style.display = p.id === btn.getAttribute('data-ex') ? '' : 'none'; });
                });
            });

            // highlight the section in view
            var links = Array.prototype.slice.call(document.querySelectorAll('#docNav a'));
            var secs = links.map(function (a) { return document.querySelector(a.getAttribute('href')); }).filter(Boolean);
            if ('IntersectionObserver' in window) {
                var io = new IntersectionObserver(function (entries) {
                    entries.forEach(function (en) {
                        if (!en.isIntersecting) return;
                        links.forEach(function (a) { a.classList.toggle('on', a.getAttribute('href') === '#' + en.target.id); });
                    });
                }, { rootMargin: '-80px 0px -70% 0px' });
                secs.forEach(function (s) { io.observe(s); });
            }
        })();
    </script>
}
