            <div id="rechargeapi" class="tab-pane fade" role="tabpanel">
                <div class="card mt-3">
                    <div class="card-body">
                        <h5 class="fw-bold font-size-15">Request URL</h5>
                        <p><a style="color:blue">https://domain.com/api/recharge</a></p>

                        <h5 class="fw-bold font-size-15 mt-2">Variables to be used for recharge request</h5>
                        <div class="table-responsive mt-2 pb-4 text-muted">
                            <table class="table table-bordered table-muted">
                                <tbody>
                                    <tr><td>username</td><td>Multi Recharge Account Mobile Number</td></tr>
                                    <tr><td>key</td><td>Go to API Account and Register Server IP Address and Get Key</td></tr>
                                    <tr><td>token</td><td>Go to API Account and Register Server IP Address and Get token</td></tr>
                                    <tr><td>number</td><td>Mobile/DTH/Electricity Number</td></tr>
                                    <tr><td>operator_code</td><td>Operator Code (Provided API Document) / Operator Code tab</td></tr>
                                    <tr><td>circle_code</td><td>Circle Code (Provided API Document) / Circle Code tab</td></tr>
                                    <tr><td>amount</td><td>Recharge Amount</td></tr>
                                    <tr><td>txn_id</td><td>Your Transaction ID</td></tr>
                                    <tr><td>optional1</td><td>Required MSEDCL Electricity (BU), Insurance (DOB)</td></tr>
                                    <tr><td>optional2</td><td>Required in Electricity Due date</td></tr>
                                    <tr><td>optional3</td><td>Required in Electricity Customer Mobile</td></tr>
                                </tbody>
                            </table>
                        </div>

                        <p class="text-muted">
                            <span class="fw-bold font-size-18 text-dark">Sample Response -</span>
                        </p>
                        <pre class="bg-light p-3 border rounded"><code>{
    "status": 1,
    "api_txn_id": 2023,
    "message": "recharge success",
    "operator_reference": "op_ref1373"
}</code></pre>

                        <div class="table-responsive pb-4">
                            <table class="table table-bordered">
                                <tbody>
                                    <tr><td>Status</td><td>1 - success, 2 - failure, 3 - pending, 4 - refund</td></tr>
                                    <tr><td>api_txn_id</td><td>API Transaction ID</td></tr>
                                    <tr><td>message</td><td>Message from API</td></tr>
                                    <tr><td>operator_reference</td><td>Operator Reference</td></tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

