@model VIRENDRA.Models.Package
@{
    ViewBag.Title = "Edit Package";
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
}

<div class="container-fluid">
    <div class="page-title-box d-sm-flex align-items-center justify-content-between mb-3">
        <h4 class="mb-sm-0">Edit Package</h4>
        <a href="@Url.Action("Index")" class="btn btn-light"><i class="fas fa-arrow-left"></i> Back</a>
    </div>

    <div class="card">
        <div class="card-body">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.Id)
                @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3" })

                <div class="row g-3">
                    <div class="col-md-6">
                        @Html.LabelFor(m => m.PackageName, new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.PackageName, new { @class = "form-control", required = "required" })
                        @Html.ValidationMessageFor(m => m.PackageName, "", new { @class = "text-danger" })
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Default Commission (%)</label>
                        @Html.TextBoxFor(m => m.DefaultComm, new { @class = "form-control", type = "number", step = "0.0001", min = "0" })
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Lock Amount (₹)</label>
                        @Html.TextBoxFor(m => m.LockAmount, new { @class = "form-control", type = "number", step = "0.01", min = "0" })
                    </div>
                    <div class="col-12 d-flex gap-2">
                        <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Update</button>
                        <a href="@Url.Action("Index")" class="btn btn-light">Cancel</a>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
